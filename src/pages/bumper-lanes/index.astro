---
// Bumper Lanes - Claude Code Plugin Landing Page
import '../../styles/bumper-lanes.css';
---

<!DOCTYPE html>
<html lang="en" data-theme="amf-rental">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Bumper Lanes - Guardrails for Claude Code</title>
  <meta name="description"
    content="Diff thresholds and guardrails for Claude Code sessions. Keep your AI pair programmer on track.">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link
    href="https://fonts.googleapis.com/css2?family=Bungee&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap"
    rel="stylesheet">
</head>

<body>
  <div class="lane-stripe"></div>

  <main>
    <div class="ascii-banner" aria-label="Bumper Lanes" data-src="/bumper-lanes/ascii/bumper-lanes.txt"></div>
    <h1 class="hero-title-fallback">Bumper Lanes</h1>
    <p class="tagline">Guardrails for Claude Code sessions</p>

    <div class="install-box" onclick="event.stopPropagation()">
      <span class="prompt">$</span>
      <code>claude plugin marketplace add kylesnowschwartz/claude-bumper-lanes
        claude plugin install claude-bumper-lanes</code>
      <button class="copy-btn" onclick="copyInstall(event, this)">Copy</button>
    </div>

    <div class="demo" onclick="event.stopPropagation()">
      <img src="/bumper-lanes/assets/bumper-demo.gif"
        alt="Bumper Lanes demo showing diff tracking and threshold warnings in Claude Code">
    </div>

    <a href="https://github.com/kylesnowschwartz/claude-bumper-lanes" class="btn" onclick="event.stopPropagation()">
      View on GitHub
    </a>
  </main>

  <footer onclick="event.stopPropagation()">
    Built by <a href="https://kylesnowschwartz.com">Kyle Snow Schwartz</a>
  </footer>

  <div class="theme-name" id="themeName"></div>

  <script is:inline>
    const themes = [
      {id: 'amf-rental', name: 'AMF Rental'},
      {id: 'brunswick', name: 'Brunswick'},
      {id: 'saddle-shoe', name: 'Saddle Shoe'},
      {id: 'retro-70s', name: 'Retro 70s'},
      {id: 'dexter', name: 'Dexter'},
      {id: 'amf-modern', name: 'AMF Modern'},
      {id: 'linds', name: 'Linds'},
      {id: 'neon-alley', name: 'Neon Alley'},
      {id: 'worn-rental', name: 'Worn Rental'}
    ];

    let currentThemeIndex = 0;

    // Load saved theme
    const savedTheme = localStorage.getItem('bumper-lanes-theme');
    if (savedTheme) {
      const idx = themes.findIndex(t => t.id === savedTheme);
      if (idx !== -1) {
        currentThemeIndex = idx;
        document.documentElement.setAttribute('data-theme', savedTheme);
      }
    }

    // Click anywhere to cycle theme
    document.body.addEventListener('click', () => {
      currentThemeIndex = (currentThemeIndex + 1) % themes.length;
      const theme = themes[currentThemeIndex];

      document.documentElement.setAttribute('data-theme', theme.id);
      localStorage.setItem('bumper-lanes-theme', theme.id);

      // Flash theme name
      const nameEl = document.getElementById('themeName');
      nameEl.textContent = theme.name;
      nameEl.classList.add('show');
      setTimeout(() => nameEl.classList.remove('show'), 600);
    });

    // Copy install command
    const clipboardIcon = `<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>`;
    const checkIcon = `<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>`;

    function copyInstall(event, btn) {
      event.stopPropagation();
      const commands = `claude plugin marketplace add kylesnowschwartz/claude-bumper-lanes;
claude plugin install claude-bumper-lanes`;
      navigator.clipboard.writeText(commands).then(() => {
        btn.innerHTML = checkIcon;
        btn.classList.add('copied');
        setTimeout(() => {
          btn.innerHTML = clipboardIcon;
          btn.classList.remove('copied');
        }, 2000);
      });
    }

    // Initialize copy button with icon
    document.querySelector('.copy-btn').innerHTML = clipboardIcon;

    // Load ASCII art
    const banner = document.querySelector('.ascii-banner[data-src]');
    if (banner) {
      fetch(banner.dataset.src)
        .then(res => res.ok ? res.text() : Promise.reject('Failed to load'))
        .then(text => banner.textContent = text.replace(/\n+$/, ''))
        .catch(e => console.warn('Failed to load ASCII art:', e));
    }
  </script>
</body>

</html>
