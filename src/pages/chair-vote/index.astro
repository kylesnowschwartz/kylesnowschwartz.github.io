---
/**
 * Chair fabric vote — family ballot for the teak dining chairs' new upholstery.
 *
 * Unlisted (noindex, not linked from the homepage) and login-free: anyone with
 * the URL can vote for up to three fabrics under a typed name. Votes live in a
 * Google Sheet behind the Apps Script web app in apps-script/chair-vote.gs;
 * ENDPOINT is that deployment's /exec URL.
 */
import '../../styles/global.css';

const ENDPOINT = 'https://script.google.com/macros/s/AKfycbwRDvnPMUFIwASTF_SpAOZMB7ELMYK3muppyHj_t6AKJMp_Ib6YC8WJiKZA3lA3skPowA/exec';

const MAX_PICKS = 3;

// Slugs must match ALLOWED_SLUGS in apps-script/chair-vote.gs and the image
// filenames in public/chair-vote/.
const FABRICS = [
  { slug: 'alluvial-eucalyptus', brand: 'James Dunlop', name: 'Alluvial', colour: 'Eucalyptus' },
  { slug: 'alluvial-river', brand: 'James Dunlop', name: 'Alluvial', colour: 'River' },
  { slug: 'gabrielle-graphite', brand: 'James Dunlop', name: 'Gabrielle', colour: 'Graphite' },
  { slug: 'gabrielle-walnut', brand: 'James Dunlop', name: 'Gabrielle', colour: 'Walnut' },
  { slug: 'mokum-borabora-pacific', brand: 'Mokum', name: 'Bora Bora', colour: 'Pacific' },
  { slug: 'mokum-borabora-spice', brand: 'Mokum', name: 'Bora Bora', colour: 'Spice' },
  { slug: 'mokum-vomo-basalt', brand: 'Mokum', name: 'Vomo', colour: 'Basalt' },
  { slug: 'warwick-uluwatu-midnight', brand: 'Warwick', name: 'Uluwatu', colour: 'Midnight' },
  { slug: 'warwick-uluwatu-natural', brand: 'Warwick', name: 'Uluwatu', colour: 'Natural' },
  { slug: 'warwick-uluwatu-terra', brand: 'Warwick', name: 'Uluwatu', colour: 'Terra' },
  { slug: 'zepel-montague-ash', brand: 'Zepel', name: 'Montague', colour: 'Ash' },
].map((f) => ({ ...f, label: `${f.brand} ${f.name} — ${f.colour}`, src: `/chair-vote/${f.slug}.jpg` }));
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="robots" content="noindex" />
  <title>Chair fabric vote</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Instrument+Sans:wght@400;500;600;700&family=Share+Tech+Mono&display=swap"
    rel="stylesheet"
  />
</head>

<body>
  <main class="cv-page" id="cv" data-endpoint={ENDPOINT} data-max={MAX_PICKS}>
    <header class="cv-head">
      <div class="eyebrow">Dining chairs · {FABRICS.length} fabrics</div>
      <h1>Which fabric?</h1>
      <p class="sub">
        Each picture is the real chairs with the fabric drawn at its true size. Tap up to {MAX_PICKS}
        you like, add your name, and vote. You can come back and change your vote.
      </p>
    </header>

    <p class="banner" id="cv-banner" role="status" hidden></p>
    <p class="banner mine" id="cv-mine" hidden></p>

    <div class="grid" id="cv-grid">
      {FABRICS.map((f) => (
        <figure class="card" data-slug={f.slug} data-label={f.label}>
          <button type="button" class="pick" aria-pressed="false">
            <img src={f.src} alt={`Chairs in ${f.label}`} width="1160" height="1160" loading="lazy" decoding="async" />
            <span class="tick" aria-hidden="true">✓</span>
          </button>
          <figcaption>
            <span class="label"><b>{f.name} {f.colour}</b> <span class="brand">{f.brand}</span></span>
            <button type="button" class="zoom" aria-label={`View ${f.label} larger`}>enlarge</button>
          </figcaption>
        </figure>
      ))}
    </div>

    <section class="results" aria-labelledby="cv-results-h">
      <h2 id="cv-results-h">Votes so far</h2>
      <p class="voters" id="cv-voters">Loading…</p>
      <ol class="tally" id="cv-tally">
        {FABRICS.map((f) => (
          <li data-slug={f.slug}>
            <span class="tname">{f.name} {f.colour}</span>
            <span class="bar"><span class="fill"></span></span>
            <span class="tcount">–</span>
          </li>
        ))}
      </ol>
    </section>

    <form class="ballot" id="cv-form" novalidate>
      <div class="count" id="cv-count" aria-live="polite">Pick up to {MAX_PICKS}</div>
      <input
        id="cv-name"
        name="name"
        type="text"
        maxlength="60"
        autocomplete="given-name"
        placeholder="Your name"
        aria-label="Your name"
        required
      />
      <button type="submit" id="cv-submit">Vote</button>
    </form>
  </main>

  <dialog class="viewer" id="cv-viewer">
    <form method="dialog">
      <button class="close" aria-label="Close">×</button>
    </form>
    <img id="cv-viewer-img" alt="" />
    <p id="cv-viewer-cap"></p>
  </dialog>

  <script>
    type Tallies = { tallies: Record<string, number>; voters: number };
    type Ballot = { name: string; picks: string[] };

    const STORAGE_KEY = 'chair-vote';

    const root = document.getElementById('cv') as HTMLElement;
    const endpoint = root.dataset.endpoint ?? '';
    const maxPicks = Number(root.dataset.max);
    const grid = document.getElementById('cv-grid') as HTMLElement;
    const cards = Array.from(grid.querySelectorAll<HTMLElement>('.card'));
    const banner = document.getElementById('cv-banner') as HTMLElement;
    const mine = document.getElementById('cv-mine') as HTMLElement;
    const countEl = document.getElementById('cv-count') as HTMLElement;
    const form = document.getElementById('cv-form') as HTMLFormElement;
    const nameInput = document.getElementById('cv-name') as HTMLInputElement;
    const submitBtn = document.getElementById('cv-submit') as HTMLButtonElement;
    const votersEl = document.getElementById('cv-voters') as HTMLElement;
    const tallyList = document.getElementById('cv-tally') as HTMLOListElement;
    const tallyRows = Array.from(tallyList.querySelectorAll<HTMLLIElement>('li'));
    const viewer = document.getElementById('cv-viewer') as HTMLDialogElement;
    const viewerImg = document.getElementById('cv-viewer-img') as HTMLImageElement;
    const viewerCap = document.getElementById('cv-viewer-cap') as HTMLElement;

    const labelOf = new Map(cards.map((c) => [c.dataset.slug as string, c.dataset.label as string]));
    const picked = new Set<string>();

    function showBanner(text: string, kind: 'info' | 'error' | 'ok') {
      banner.textContent = text;
      banner.dataset.kind = kind;
      banner.hidden = false;
    }

    function renderPicks() {
      const full = picked.size >= maxPicks;
      for (const card of cards) {
        const on = picked.has(card.dataset.slug as string);
        const btn = card.querySelector('.pick') as HTMLButtonElement;
        card.classList.toggle('on', on);
        // aria-disabled rather than disabled so a full ballot still lets you
        // untick a pick; the click handler enforces the cap.
        card.classList.toggle('capped', full && !on);
        btn.setAttribute('aria-pressed', String(on));
        btn.setAttribute('aria-disabled', String(full && !on));
      }
      countEl.textContent = full
        ? `${picked.size} of ${maxPicks} picked — untick one to swap`
        : picked.size === 0
          ? `Pick up to ${maxPicks}`
          : `${picked.size} of ${maxPicks} picked`;
      countEl.classList.toggle('full', full);
    }

    function renderTallies({ tallies, voters }: Tallies) {
      votersEl.textContent = `${voters} ${voters === 1 ? 'person has' : 'people have'} voted`;
      const top = Math.max(1, ...Object.values(tallies));
      const sorted = [...tallyRows].sort(
        (a, b) => (tallies[b.dataset.slug as string] ?? 0) - (tallies[a.dataset.slug as string] ?? 0),
      );
      for (const row of sorted) {
        const n = tallies[row.dataset.slug as string] ?? 0;
        (row.querySelector('.tcount') as HTMLElement).textContent = String(n);
        (row.querySelector('.fill') as HTMLElement).style.width = `${(n / top) * 100}%`;
        tallyList.appendChild(row);
      }
    }

    function renderMine(ballot: Ballot | null) {
      if (!ballot) return;
      const names = ballot.picks.map((s) => labelOf.get(s) ?? s).join(', ');
      mine.textContent = `${ballot.name}, you voted for ${names}. You can change your vote: pick again and press Vote.`;
      mine.hidden = false;
      submitBtn.textContent = 'Change vote';
    }

    function loadBallot(): Ballot | null {
      try {
        const raw = localStorage.getItem(STORAGE_KEY);
        return raw ? (JSON.parse(raw) as Ballot) : null;
      } catch {
        return null;
      }
    }

    // Apps Script answers errors with HTTP 200 and an {error} body, so both the
    // status and the payload have to be checked.
    async function call(init?: RequestInit): Promise<Tallies> {
      const res = await fetch(endpoint, init);
      const text = await res.text();
      if (!res.ok) throw new Error(`Server replied ${res.status} ${res.statusText}`);
      let data: Tallies & { error?: string };
      try {
        data = JSON.parse(text);
      } catch {
        throw new Error('Server reply was not JSON. Is the web app deployed with access set to Anyone?');
      }
      if (data.error) throw new Error(data.error);
      return data;
    }

    for (const card of cards) {
      const slug = card.dataset.slug as string;
      card.querySelector('.pick')!.addEventListener('click', () => {
        if (picked.has(slug)) picked.delete(slug);
        else if (picked.size < maxPicks) picked.add(slug);
        renderPicks();
      });
      card.querySelector('.zoom')!.addEventListener('click', () => {
        const img = card.querySelector('img') as HTMLImageElement;
        viewerImg.src = img.src;
        viewerImg.alt = img.alt;
        viewerCap.textContent = card.dataset.label as string;
        viewer.showModal();
      });
    }
    viewer.addEventListener('click', (e) => {
      if (e.target === viewer) viewer.close();
    });

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const name = nameInput.value.trim();
      if (!endpoint) return showBanner('Voting is not connected yet. Check back soon.', 'info');
      if (picked.size === 0) return showBanner('Tap at least one fabric first.', 'error');
      if (!name) {
        nameInput.focus();
        return showBanner('Add your name so a second vote replaces your first.', 'error');
      }

      const ballot: Ballot = { name, picks: [...picked] };
      submitBtn.disabled = true;
      try {
        // text/plain keeps this a "simple" request with no CORS preflight,
        // which Apps Script web apps cannot answer.
        const result = await call({
          method: 'POST',
          body: JSON.stringify(ballot),
          headers: { 'Content-Type': 'text/plain;charset=utf-8' },
        });
        try { localStorage.setItem(STORAGE_KEY, JSON.stringify(ballot)); } catch {}
        renderTallies(result);
        renderMine(ballot);
        showBanner('Thanks, your vote is in.', 'ok');
      } catch (err) {
        showBanner(`Your vote did not go through: ${(err as Error).message}`, 'error');
      } finally {
        submitBtn.disabled = false;
      }
    });

    const saved = loadBallot();
    if (saved) {
      nameInput.value = saved.name;
      for (const s of saved.picks) if (labelOf.has(s)) picked.add(s);
      renderMine(saved);
    }
    renderPicks();

    if (!endpoint) {
      showBanner('Voting is not connected yet. You can look at the fabrics, but votes cannot be saved.', 'info');
      votersEl.textContent = 'No votes yet: voting is not connected.';
      submitBtn.disabled = true;
    } else {
      call()
        .then(renderTallies)
        .catch((err) => {
          votersEl.textContent = `Could not load votes: ${(err as Error).message}`;
        });
    }
  </script>

  <style>
    .cv-page {
      max-width: var(--container-max);
      margin: 0 auto;
      /* Bottom padding clears the sticky ballot bar. */
      padding: var(--s4) var(--s2) calc(var(--s7) + var(--s4));
      position: relative;
      z-index: 1;
    }

    .eyebrow {
      font-family: var(--font-mono);
      font-size: 0.72rem;
      letter-spacing: 0.09em;
      text-transform: uppercase;
      color: var(--color-text-muted);
    }
    .cv-head h1 {
      font-family: var(--font-sans);
      font-weight: 700;
      font-size: clamp(2rem, 6vw, 3rem);
      letter-spacing: -0.02em;
      margin: var(--s0) 0 var(--s1);
    }
    .cv-head .sub { color: var(--color-text-muted); max-width: 60ch; margin: 0 0 var(--s3); }

    .banner {
      padding: var(--s2) var(--s3);
      margin-bottom: var(--s3);
      border: 1px solid var(--color-border);
      border-left: 4px solid var(--color-text-muted);
      background: var(--color-surface);
    }
    .banner[data-kind='error'] { border-left-color: var(--color-accent); }
    .banner[data-kind='ok'], .banner.mine { border-left-color: #5f7a3c; }

    /* One image per row on phones: the renders are only useful big enough to
       judge pattern scale. */
    .grid {
      display: grid;
      grid-template-columns: 1fr;
      gap: var(--s3);
    }
    @media (min-width: 640px) { .grid { grid-template-columns: repeat(2, 1fr); } }
    @media (min-width: 1000px) { .grid { grid-template-columns: repeat(3, 1fr); } }

    .card {
      margin: 0;
      background: var(--color-surface);
      border: 1px solid var(--color-border);
      transition: border-color var(--dur-micro) var(--ease-out), opacity var(--dur-short) var(--ease-out);
    }
    .card.on { border-color: var(--color-accent); box-shadow: 0 0 0 2px var(--color-accent); }
    .card.capped { opacity: 0.5; }
    .card.capped .pick { cursor: not-allowed; }

    .pick {
      display: block;
      position: relative;
      width: 100%;
      padding: 0;
      border: 0;
      background: none;
      cursor: pointer;
    }
    .pick img { display: block; width: 100%; height: auto; }
    .tick {
      position: absolute;
      top: var(--s2);
      right: var(--s2);
      width: 2.25rem;
      height: 2.25rem;
      display: grid;
      place-items: center;
      border-radius: 50%;
      font-weight: 700;
      font-size: 1.1rem;
      color: #fff;
      background: rgba(28, 25, 23, 0.35);
      border: 2px solid #fff;
    }
    .card.on .tick { background: var(--color-accent); }

    figcaption {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: var(--s1);
      padding: var(--s1) var(--s2);
    }
    .brand {
      font-family: var(--font-mono);
      font-size: 0.72rem;
      color: var(--color-text-muted);
      margin-left: var(--s0);
    }
    .zoom {
      font-family: var(--font-mono);
      font-size: 0.72rem;
      padding: var(--s0) var(--s1);
      border: 1px solid var(--color-border);
      background: none;
      color: var(--color-text-muted);
      cursor: pointer;
    }
    .zoom:hover { color: var(--color-accent); border-color: var(--color-accent); }

    .results { margin-top: var(--s5); max-width: 640px; }
    .results h2 { font-size: 1.4rem; margin-bottom: var(--s0); }
    .voters { color: var(--color-text-muted); margin: 0 0 var(--s2); }
    .tally { list-style: none; padding: 0; margin: 0; }
    .tally li {
      display: grid;
      grid-template-columns: minmax(8rem, 12rem) 1fr 2ch;
      align-items: center;
      gap: var(--s2);
      padding: var(--s0) 0;
    }
    .tname { font-size: 0.9rem; }
    .bar { height: 0.7rem; background: var(--color-border); }
    .fill {
      display: block;
      height: 100%;
      width: 0;
      background: var(--color-accent);
      transition: width var(--dur-long) var(--ease-out);
    }
    .tcount { font-family: var(--font-mono); text-align: right; }

    .ballot {
      position: fixed;
      left: 0;
      right: 0;
      bottom: 0;
      z-index: 2;
      display: grid;
      grid-template-columns: 1fr auto;
      gap: var(--s1);
      padding: var(--s1) var(--s2) calc(var(--s1) + env(safe-area-inset-bottom));
      background: var(--color-surface);
      border-top: 1px solid var(--color-border);
      box-shadow: 0 -4px 16px rgba(28, 25, 23, 0.08);
    }
    .count {
      grid-column: 1 / -1;
      font-family: var(--font-mono);
      font-size: 0.78rem;
      color: var(--color-text-muted);
    }
    .count.full { color: var(--color-accent); }
    /* 16px minimum stops iOS Safari zooming the page on focus. */
    .ballot input {
      font: inherit;
      font-size: 16px;
      padding: var(--s1) var(--s2);
      border: 1px solid var(--color-border);
      background: #fff;
      min-width: 0;
    }
    .ballot button {
      font: inherit;
      font-weight: 600;
      padding: var(--s1) var(--s3);
      border: 0;
      background: var(--color-text);
      color: var(--color-surface);
      cursor: pointer;
    }
    .ballot button:disabled { opacity: 0.4; cursor: not-allowed; }

    /* global.css zeroes margins and makes every body child position:
       relative, which together pin the modal to the top-left corner. */
    .viewer {
      position: fixed;
      margin: auto;
      max-width: min(96vw, 1160px);
      max-height: 96vh;
      padding: 0;
      border: 0;
      background: var(--color-surface);
    }
    .viewer::backdrop { background: rgba(28, 25, 23, 0.8); }
    .viewer img { display: block; width: 100%; height: auto; max-height: 88vh; object-fit: contain; }
    .viewer p { margin: 0; padding: var(--s1) var(--s2); font-weight: 600; }
    .viewer .close {
      position: absolute;
      top: var(--s1);
      right: var(--s1);
      width: 2.5rem;
      height: 2.5rem;
      border: 0;
      border-radius: 50%;
      font-size: 1.5rem;
      line-height: 1;
      background: rgba(28, 25, 23, 0.6);
      color: #fff;
      cursor: pointer;
    }
  </style>
</body>
</html>
