---
/**
 * Weekly Menu — plan the week, shop from one list, cook from big-text recipes.
 *
 * Standalone route, deliberately unlinked and outside the homepage look: no
 * global.css, its own calm palette. Recipes come from the `menuRecipes`
 * collection and ship as inline JSON; all planning state lives in the
 * visitor's localStorage. Logic lives in src/lib/menu.ts.
 */
import { getCollection } from 'astro:content';
import type { Recipe } from '../../lib/menu';

const recipes: Recipe[] = (await getCollection('menuRecipes')).map((entry) => entry.data);
// `<` is escaped so recipe text can never close the inline script early.
const recipesJson = JSON.stringify(recipes).replace(/</g, '\\u003c');
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
  <meta name="robots" content="noindex, nofollow" />
  <meta name="theme-color" content="#f4f7f6" />
  <title>Weekly Menu</title>
</head>

<body>
  <div class="app">
    <header class="masthead">
      <h1>Weekly Menu</h1>
      <p class="lede">Plan the week, then shop from one list.</p>
    </header>

    <nav class="tabs" aria-label="Sections">
      <div role="tablist" class="tablist">
        <button role="tab" id="tab-plan" aria-controls="view-plan" aria-selected="true" data-tab="plan">Plan</button>
        <button role="tab" id="tab-shop" aria-controls="view-shop" aria-selected="false" tabindex="-1" data-tab="shop">Shop</button>
        <button role="tab" id="tab-recipes" aria-controls="view-recipes" aria-selected="false" tabindex="-1" data-tab="recipes">Recipes</button>
      </div>
    </nav>

    <main>
      <section id="view-plan" role="tabpanel" aria-labelledby="tab-plan" tabindex="-1">
        <div class="view-head">
          <h2>This week</h2>
          <p class="soft">Tap a meal to choose a dish, or let Autofill pick for a day.</p>
        </div>
        <div class="actions end">
          <button type="button" class="btn quiet" id="clear-plan">Clear</button>
        </div>
        <p class="status" id="plan-status" role="status"></p>
        <div id="days" class="days"></div>
      </section>

      <section id="view-shop" role="tabpanel" aria-labelledby="tab-shop" tabindex="-1" hidden>
        <div class="view-head">
          <h2>Shopping list</h2>
          <p class="soft" id="shop-count"></p>
        </div>
        <div id="shop-body">
          <div class="actions">
            <button type="button" class="btn primary" id="share">Share list</button>
            <button type="button" class="btn quiet" id="untick">Untick all</button>
          </div>
          <p class="status" id="shop-status" role="status"></p>
          <div id="shop-list"></div>
        </div>
        <div id="shop-empty" class="card empty" hidden>
          <p>Nothing to buy yet. Choose some meals and the list builds itself.</p>
          <button type="button" class="btn primary" data-goto="plan">Go to the plan</button>
        </div>
      </section>

      <section id="view-recipes" role="tabpanel" aria-labelledby="tab-recipes" tabindex="-1" hidden>
        <div class="view-head">
          <h2>Recipes</h2>
          <p class="soft">Open one to cook from it. The screen stays on while it's open.</p>
        </div>
        <div id="recipe-list"></div>
      </section>
    </main>
  </div>

  <dialog id="picker" class="sheet" aria-labelledby="picker-title">
    <div class="sheet-head">
      <h2 id="picker-title"></h2>
      <button type="button" class="btn quiet small" data-close>Close</button>
    </div>
    <p class="soft sheet-note">Dishes already planned this week are marked.</p>
    <ul id="picker-list" class="pick-list"></ul>
    <div class="sheet-foot">
      <button type="button" class="btn quiet" id="picker-clear">Remove from this day</button>
    </div>
  </dialog>

  <dialog id="cook" class="full" aria-labelledby="cook-title">
    <div class="cook">
      <div class="cook-bar">
        <button type="button" class="btn quiet" data-close>&larr; Back</button>
        <button type="button" class="btn primary" id="cook-add">Add to plan</button>
      </div>
      <p class="status" id="cook-status" role="status"></p>
      <h2 id="cook-title"></h2>
      <div class="cook-meta" id="cook-meta"></div>
      <h3>Ingredients</h3>
      <ul id="cook-ings" class="cook-list"></ul>
      <h3>Method</h3>
      <ol id="cook-steps" class="cook-list steps"></ol>
      <aside id="cook-tip" class="tip"></aside>
    </div>
  </dialog>

  <dialog id="day-chooser" class="sheet" aria-labelledby="day-chooser-title">
    <div class="sheet-head">
      <h2 id="day-chooser-title">Which day?</h2>
      <button type="button" class="btn quiet small" data-close>Close</button>
    </div>
    <ul id="day-chooser-list" class="pick-list"></ul>
  </dialog>

  <dialog id="confirm-new" class="sheet" aria-labelledby="confirm-title">
    <form method="dialog">
      <h2 id="confirm-title">Clear the whole plan and shopping ticks?</h2>
      <p>Every meal comes off the plan and the shopping list starts unticked. The recipes stay.</p>
      <div class="actions">
        <button class="btn primary" value="clear">Clear</button>
        <button class="btn quiet" value="keep" autofocus>Keep the plan</button>
      </div>
    </form>
  </dialog>

  <script is:inline type="application/json" id="menu-data" set:html={recipesJson} />

  <script>
    import {
      DAYS,
      SLOTS,
      MAIN_MEALS,
      MEAL_LABELS,
      STORAGE_KEY,
      byId,
      dayNetCarbs,
      fillDay,
      lineAmount,
      loadState,
      saveState,
      setSlot,
      shoppingList,
      shoppingListText,
      tickLine,
      untickLine,
      currentTicks,
      usageCounts,
      type DayPlan,
      type Meal,
      type Recipe,
      type ShoppingGroup,
    } from '../../lib/menu';

    const recipes: Recipe[] = JSON.parse(document.getElementById('menu-data')!.textContent || '[]');
    const recipeMap = byId(recipes);
    const hasExtras = recipes.some((r) => r.meal === 'extra');

    function readSaved(): string | null {
      try {
        return localStorage.getItem(STORAGE_KEY);
      } catch {
        return null;
      }
    }
    let state = loadState(readSaved(), recipes);
    function save() {
      try {
        localStorage.setItem(STORAGE_KEY, saveState(state));
      } catch {
        // Private browsing or a full quota: the page still works for this visit.
      }
    }
    save();

    type Child = Node | string | null | undefined | false;
    function el<K extends keyof HTMLElementTagNameMap>(
      tag: K,
      attrs: Record<string, string | number | boolean | null | undefined> = {},
      ...kids: Child[]
    ): HTMLElementTagNameMap[K] {
      const node = document.createElement(tag);
      for (const [k, v] of Object.entries(attrs)) {
        if (v === null || v === undefined || v === false) continue;
        if (k === 'class') node.className = String(v);
        else node.setAttribute(k, v === true ? '' : String(v));
      }
      for (const kid of kids) if (kid !== null && kid !== undefined && kid !== false) node.append(kid);
      return node;
    }
    const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
    const cap = (s: string) => s.charAt(0).toUpperCase() + s.slice(1);
    const carbs = (g: number) => `~${Math.round(g)} g net carbs`;
    const slotsShown = (): readonly Meal[] => (hasExtras ? SLOTS : MAIN_MEALS);

    function tagChips(r: Recipe): HTMLElement {
      return el(
        'span',
        { class: 'chips' },
        ...r.tags.map((t) => el('span', { class: 'chip' }, t)),
        el('span', { class: 'chip carb' }, carbs(r.netCarbsG)),
        r.serves > 1 ? el('span', { class: 'chip' }, `Makes ${r.serves}`) : null,
      );
    }

    function plannedNote(count: number): string {
      if (count === 0) return '';
      return count === 1 ? 'Already planned this week' : `Planned ${count} times this week`;
    }

    // ------------------------------------------------------------ tabs

    type Tab = 'plan' | 'shop' | 'recipes';
    const TABS: Tab[] = ['plan', 'shop', 'recipes'];
    const tabButtons = TABS.map((t) => $<HTMLButtonElement>(`tab-${t}`));

    function setTab(tab: Tab, focusTab = false) {
      TABS.forEach((t, i) => {
        const on = t === tab;
        tabButtons[i].setAttribute('aria-selected', String(on));
        tabButtons[i].tabIndex = on ? 0 : -1;
        $(`view-${t}`).hidden = !on;
      });
      if (tab === 'shop') renderShop();
      if (focusTab) tabButtons[TABS.indexOf(tab)].focus();
      history.replaceState(null, '', `#${tab}`);
      window.scrollTo({ top: 0 });
    }

    tabButtons.forEach((btn, i) => {
      btn.addEventListener('click', () => setTab(TABS[i]));
      btn.addEventListener('keydown', (e) => {
        const step = e.key === 'ArrowRight' ? 1 : e.key === 'ArrowLeft' ? -1 : 0;
        if (e.key === 'Home' || e.key === 'End') {
          e.preventDefault();
          setTab(TABS[e.key === 'Home' ? 0 : TABS.length - 1], true);
        } else if (step) {
          e.preventDefault();
          setTab(TABS[(i + step + TABS.length) % TABS.length], true);
        }
      });
    });
    document.querySelectorAll<HTMLElement>('[data-goto]').forEach((b) =>
      b.addEventListener('click', () => setTab(b.dataset.goto as Tab, true)),
    );

    // ------------------------------------------------------------ dialogs

    for (const dlg of document.querySelectorAll('dialog')) {
      dlg.querySelectorAll('[data-close]').forEach((b) => b.addEventListener('click', () => dlg.close()));
    }
    // Bottom sheets close on a tap on the dimmed backdrop. Backdrop taps report
    // the dialog as their target, as do taps on its own padding, so only a
    // point outside the dialog's box counts. The full-screen recipe view has no
    // backdrop and only closes from Back or Escape.
    for (const dlg of document.querySelectorAll<HTMLDialogElement>('dialog.sheet')) {
      dlg.addEventListener('click', (e) => {
        if (e.target !== dlg) return;
        const box = dlg.getBoundingClientRect();
        const inside = e.clientX >= box.left && e.clientX <= box.right && e.clientY >= box.top && e.clientY <= box.bottom;
        if (!inside) dlg.close();
      });
    }

    // ------------------------------------------------------------ plan

    const daysEl = $('days');
    const planStatus = $('plan-status');

    // Only offer Autofill when it would actually fill something.
    const canAutofill = (day: DayPlan) => MAIN_MEALS.some((m) => !day[m] && recipes.some((r) => r.meal === m));

    function renderPlan() {
      const usage = usageCounts(state.plan);
      daysEl.replaceChildren(
        ...state.plan.map((day, d) => {
          const total = dayNetCarbs(day, recipeMap);
          return el(
            'article',
            { class: 'card day', 'aria-labelledby': `day-${d}` },
            el(
              'header',
              { class: 'day-head' },
              el('h3', { id: `day-${d}` }, DAYS[d]),
              el('span', { class: total ? 'carb-total' : 'carb-total none' }, total ? carbs(total) : 'Nothing planned'),
              canAutofill(day)
                ? el('button', { type: 'button', class: 'btn quiet small autofill', 'data-autofill': d, 'aria-label': `Autofill ${DAYS[d]}` }, 'Autofill')
                : null,
            ),
            el(
              'ul',
              { class: 'slots' },
              ...slotsShown().map((meal) => {
                const r = day[meal] ? recipeMap.get(day[meal]!) : undefined;
                const label = meal === 'extra' ? 'Extra (optional)' : MEAL_LABELS[meal];
                if (!r) {
                  return el(
                    'li',
                    { class: 'slot' },
                    el('span', { class: 'slot-meal' }, label),
                    el(
                      'button',
                      { type: 'button', class: 'slot-add', 'data-day': d, 'data-meal': meal, 'aria-label': `Add ${MEAL_LABELS[meal].toLowerCase()} for ${DAYS[d]}` },
                      '+ Add',
                    ),
                  );
                }
                return el(
                  'li',
                  { class: 'slot filled' },
                  el('span', { class: 'slot-meal' }, label),
                  el(
                    'button',
                    { type: 'button', class: 'slot-dish', 'data-day': d, 'data-meal': meal, 'aria-label': `${DAYS[d]} ${MEAL_LABELS[meal].toLowerCase()}: ${r.name}. Change` },
                    el('span', { class: 'dish-name' }, r.name),
                    el('span', { class: 'dish-carbs' }, carbs(r.netCarbsG)),
                    (usage.get(r.id) ?? 0) > 1 ? el('span', { class: 'dish-repeat' }, `${usage.get(r.id)}× this week`) : null,
                  ),
                  el('button', { type: 'button', class: 'slot-open', 'data-open': r.id, 'aria-label': `Open the recipe for ${r.name}` }, 'Recipe'),
                );
              }),
            ),
          );
        }),
      );
    }

    daysEl.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('button');
      if (!btn) return;
      if (btn.dataset.autofill) autofill(Number(btn.dataset.autofill));
      else if (btn.dataset.open) openRecipe(btn.dataset.open);
      else if (btn.dataset.day) openPicker(Number(btn.dataset.day), btn.dataset.meal as Meal);
    });

    function focusSlot(day: number, meal: Meal) {
      daysEl.querySelector<HTMLElement>(`[data-day="${day}"][data-meal="${meal}"]`)?.focus();
    }

    function autofill(d: number) {
      const empty = MAIN_MEALS.filter((m) => !state.plan[d][m]);
      state.plan = fillDay(state.plan, d, recipes, Date.now() % 2147483647);
      save();
      renderAll();
      // The day's Autofill button disappears once it is full, so focus moves to the first meal it chose.
      const first = empty.find((m) => state.plan[d][m]);
      if (first) focusSlot(d, first);
      planStatus.textContent = `${DAYS[d]} is filled in. Tap any meal to swap it.`;
    }

    const confirmNew = $<HTMLDialogElement>('confirm-new');
    $('clear-plan').addEventListener('click', () => {
      confirmNew.returnValue = '';
      confirmNew.showModal();
    });
    confirmNew.addEventListener('close', () => {
      if (confirmNew.returnValue !== 'clear') return;
      state = loadState(null, recipes);
      save();
      renderAll();
      planStatus.textContent = 'The plan is clear. Tap a meal to begin.';
    });

    // ------------------------------------------------------------ picker

    const picker = $<HTMLDialogElement>('picker');
    const pickerList = $('picker-list');
    const pickerClear = $<HTMLButtonElement>('picker-clear');
    let picking: { day: number; meal: Meal } | null = null;

    function openPicker(day: number, meal: Meal) {
      picking = { day, meal };
      const current = state.plan[day][meal];
      const usage = usageCounts(state.plan);
      const options = recipes.filter((r) => r.meal === meal);
      $('picker-title').textContent = `${MEAL_LABELS[meal]} for ${DAYS[day]}`;
      pickerClear.hidden = !current;
      pickerList.replaceChildren(
        ...(options.length
          ? options.map((r) =>
              el(
                'li',
                {},
                el(
                  'button',
                  { type: 'button', class: 'pick', 'data-id': r.id, 'aria-pressed': String(r.id === current) },
                  el('span', { class: 'pick-name' }, r.name),
                  tagChips(r),
                  r.id === current
                    ? el('span', { class: 'pick-note chosen' }, 'Chosen for this day')
                    : plannedNote(usage.get(r.id) ?? 0) && el('span', { class: 'pick-note' }, plannedNote(usage.get(r.id) ?? 0)),
                ),
              ),
            )
          : [el('li', { class: 'soft' }, 'No recipes for this meal yet.')]),
      );
      picker.showModal();
    }

    function choose(id: string | null) {
      if (!picking) return;
      state.plan = setSlot(state.plan, picking.day, picking.meal, id);
      save();
      renderAll();
      picker.close();
    }

    pickerList.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('.pick');
      if (btn?.dataset.id) choose(btn.dataset.id);
    });
    pickerClear.addEventListener('click', () => choose(null));
    picker.addEventListener('close', () => {
      // The slot button was rebuilt by the render, so put focus back by hand.
      if (picking) focusSlot(picking.day, picking.meal);
      picking = null;
    });

    // ------------------------------------------------------------ shop

    const shopList = $('shop-list');
    const shopStatus = $('shop-status');
    let groups: ShoppingGroup[] = [];

    // A ticked line waits this long before sinking to the bottom of its aisle,
    // so the next line doesn't slide under a finger mid-tap.
    const SETTLE_MS = 1000;
    const settleTimers = new Map<string, number>();

    function updateShopCount() {
      const buy = groups.filter((g) => g.id !== 'staples').flatMap((g) => g.lines);
      const left = buy.filter((l) => !(l.key in state.shopTicks)).length;
      $('shop-count').textContent =
        groups.length === 0
          ? ''
          : buy.length === 0
            ? 'Only kitchen basics this week.'
            : left === 0
              ? 'All done. Everything is in the basket.'
              : `${left} of ${buy.length} things left to get.`;
    }

    // One short row per line keeps a long list scannable; tapping opens the
    // full dish names. A single dish shows its name, clipped until opened.
    function dishesFor(dishes: string[]): HTMLElement {
      if (dishes.length === 1) {
        return el('details', { class: 'line-for one' }, el('summary', {}, el('span', {}, `For ${dishes[0]}`)));
      }
      return el(
        'details',
        { class: 'line-for' },
        el('summary', {}, el('span', {}, `For ${dishes.length} dishes`)),
        el('p', {}, dishes.join(', ')),
      );
    }

    function renderShop() {
      groups = shoppingList(state.plan, recipes);
      const live = currentTicks(groups, state.shopTicks);
      if (Object.keys(live).length !== Object.keys(state.shopTicks).length) {
        state.shopTicks = live;
        save();
      }
      for (const t of settleTimers.values()) clearTimeout(t);
      settleTimers.clear();

      const empty = groups.length === 0;
      $('shop-empty').hidden = !empty;
      $('shop-body').hidden = empty;
      updateShopCount();

      const focusedKey = (document.activeElement as HTMLElement | null)?.dataset?.key;
      shopList.replaceChildren(
        ...groups.map((g) => {
          const isOn = (key: string) => key in state.shopTicks;
          const lines = [...g.lines.filter((l) => !isOn(l.key)), ...g.lines.filter((l) => isOn(l.key))];
          return el(
            'section',
            { class: g.id === 'staples' ? 'aisle staples' : 'aisle', 'aria-labelledby': `aisle-${g.id}` },
            el('h3', { id: `aisle-${g.id}` }, g.label),
            g.id === 'staples' ? el('p', { class: 'soft aisle-note' }, 'Most kitchens have these. Tick them off as you check.') : null,
            el(
              'ul',
              { class: 'shop-lines card', 'data-group': g.id },
              ...lines.map((l) => {
                const amt = lineAmount(l);
                const on = isOn(l.key);
                return el(
                  'li',
                  { class: on ? 'shop-row done' : 'shop-row' },
                  el(
                    'label',
                    { class: 'shop-line' },
                    el('input', { type: 'checkbox', 'data-key': l.key, checked: on }),
                    el('span', { class: 'line-top' }, el('span', { class: 'line-item' }, cap(l.item)), amt ? el('span', { class: 'line-amt' }, amt) : null),
                  ),
                  g.id === 'staples' ? null : dishesFor(l.dishes),
                );
              }),
            ),
          );
        }),
      );
      if (focusedKey) shopList.querySelector<HTMLElement>(`input[data-key="${CSS.escape(focusedKey)}"]`)?.focus();
    }

    function settleGroup(ul: HTMLElement) {
      const rows = [...ul.children] as HTMLElement[];
      const sorted = [...rows.filter((r) => !r.classList.contains('done')), ...rows.filter((r) => r.classList.contains('done'))];
      if (sorted.every((r, i) => r === rows[i])) return;
      const focused = document.activeElement;
      ul.append(...sorted);
      if (focused instanceof HTMLElement && ul.contains(focused)) focused.focus();
    }

    shopList.addEventListener('change', (e) => {
      const box = e.target as HTMLInputElement;
      const key = box.dataset.key;
      const line = groups.flatMap((g) => g.lines).find((l) => l.key === key);
      const row = box.closest<HTMLElement>('li');
      const ul = row?.parentElement;
      if (!key || !line || !row || !ul) return;
      state.shopTicks = box.checked ? tickLine(state.shopTicks, line) : untickLine(state.shopTicks, key);
      save();
      row.classList.toggle('done', box.checked);
      updateShopCount();
      const group = ul.dataset.group ?? '';
      clearTimeout(settleTimers.get(group));
      settleTimers.set(
        group,
        window.setTimeout(() => {
          settleTimers.delete(group);
          settleGroup(ul);
        }, SETTLE_MS),
      );
    });

    $('untick').addEventListener('click', () => {
      state.shopTicks = {};
      save();
      renderShop();
      shopStatus.textContent = 'Everything is unticked.';
    });

    async function copyText(text: string): Promise<boolean> {
      try {
        await navigator.clipboard.writeText(text);
        return true;
      } catch {
        const area = el('textarea', { class: 'offscreen', readonly: true });
        area.value = text;
        document.body.append(area);
        area.select();
        const ok = document.execCommand('copy');
        area.remove();
        return ok;
      }
    }

    $('share').addEventListener('click', async () => {
      const text = shoppingListText(groups, state.shopTicks);
      if (navigator.share) {
        try {
          await navigator.share({ title: 'Shopping list', text });
          return;
        } catch (err) {
          if ((err as DOMException).name === 'AbortError') return;
        }
      }
      shopStatus.textContent = (await copyText(text))
        ? 'Copied. Paste it into a message or your notes.'
        : 'Sorry, that did not copy. Try again in a moment.';
    });

    // ------------------------------------------------------------ recipes

    const recipeListEl = $('recipe-list');

    function renderRecipes() {
      const usage = usageCounts(state.plan);
      if (recipes.length === 0) {
        recipeListEl.replaceChildren(el('p', { class: 'card empty' }, 'No recipes yet.'));
        return;
      }
      recipeListEl.replaceChildren(
        ...SLOTS.filter((m) => recipes.some((r) => r.meal === m)).map((meal) =>
          el(
            'section',
            { class: 'meal-group', 'aria-labelledby': `meal-${meal}` },
            el('h3', { id: `meal-${meal}` }, meal === 'extra' ? 'Extras' : MEAL_LABELS[meal]),
            el(
              'ul',
              { class: 'recipe-cards' },
              ...recipes
                .filter((r) => r.meal === meal)
                .map((r) =>
                  el(
                    'li',
                    {},
                    el(
                      'button',
                      { type: 'button', class: 'card recipe-card', 'data-open': r.id },
                      el('span', { class: 'pick-name' }, r.name),
                      tagChips(r),
                      plannedNote(usage.get(r.id) ?? 0) && el('span', { class: 'pick-note' }, plannedNote(usage.get(r.id) ?? 0)),
                    ),
                  ),
                ),
            ),
          ),
        ),
      );
    }

    recipeListEl.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-open]');
      if (btn?.dataset.open) openRecipe(btn.dataset.open);
    });

    // ------------------------------------------------------------ cooking view

    const cook = $<HTMLDialogElement>('cook');
    const cookStatus = $('cook-status');
    let cooking: Recipe | null = null;
    let wakeLock: WakeLockSentinel | null = null;
    let wakeRequest: Promise<void> | null = null;

    // One lock at most: a request still in flight blocks a second one, and a
    // lock that arrives after the recipe closed is handed straight back.
    function keepAwake() {
      if (!('wakeLock' in navigator) || wakeLock || wakeRequest) return;
      wakeRequest = navigator.wakeLock
        .request('screen')
        .then((lock) => {
          if (!cook.open || document.visibilityState !== 'visible') {
            lock.release().catch(() => {});
            return;
          }
          wakeLock = lock;
          lock.addEventListener('release', () => {
            if (wakeLock === lock) wakeLock = null;
          });
        })
        .catch(() => {})
        .finally(() => {
          wakeRequest = null;
        });
    }

    function letSleep() {
      const lock = wakeLock;
      wakeLock = null;
      lock?.release().catch(() => {});
    }

    // The browser drops the lock whenever the tab is hidden.
    document.addEventListener('visibilitychange', () => {
      if (document.visibilityState === 'visible' && cook.open) keepAwake();
    });

    function renderCook() {
      if (!cooking) return;
      const r = cooking;
      $('cook-title').textContent = r.name;
      $('cook-meta').replaceChildren(tagChips(r));
      $('cook-ings').replaceChildren(...r.ingredients.map((ing) => el('li', {}, ing.text)));
      $('cook-steps').replaceChildren(...r.method.map((step) => el('li', {}, step)));
      const tip = $('cook-tip');
      tip.hidden = !r.tip;
      tip.replaceChildren(r.tip ? el('strong', {}, 'Tip ') : '', r.tip ?? '');
    }

    function openRecipe(id: string) {
      const r = recipeMap.get(id);
      if (!r) return;
      cooking = r;
      cookStatus.textContent = '';
      renderCook();
      cook.showModal();
      cook.scrollTop = 0;
      keepAwake();
    }

    cook.addEventListener('close', () => {
      letSleep();
      cooking = null;
    });

    const dayChooser = $<HTMLDialogElement>('day-chooser');
    const dayChooserList = $('day-chooser-list');

    $('cook-add').addEventListener('click', () => {
      if (!cooking) return;
      const r = cooking;
      $('day-chooser-title').textContent = `Add to which day's ${MEAL_LABELS[r.meal].toLowerCase()}?`;
      dayChooserList.replaceChildren(
        ...DAYS.map((name, d) => {
          const current = state.plan[d][r.meal];
          const now = current ? recipeMap.get(current)?.name : null;
          return el(
            'li',
            {},
            el(
              'button',
              { type: 'button', class: 'pick', 'data-day': d, 'aria-pressed': String(current === r.id) },
              el('span', { class: 'pick-name' }, name),
              el('span', { class: 'pick-note' }, current === r.id ? 'Already there' : now ? `Swaps out ${now}` : 'Free'),
            ),
          );
        }),
      );
      dayChooser.showModal();
    });

    dayChooserList.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-day]');
      if (!btn || !cooking) return;
      const d = Number(btn.dataset.day);
      state.plan = setSlot(state.plan, d, cooking.meal, cooking.id);
      save();
      renderAll();
      dayChooser.close();
      cookStatus.textContent = `Added to ${DAYS[d]}.`;
    });

    // ------------------------------------------------------------ boot

    function renderAll() {
      renderPlan();
      renderShop();
      renderRecipes();
      renderCook();
    }

    // Keep two open tabs in step.
    window.addEventListener('storage', (e) => {
      if (e.key !== STORAGE_KEY) return;
      state = loadState(e.newValue, recipes);
      renderAll();
    });

    renderAll();
    const start = location.hash.slice(1) as Tab;
    setTab(TABS.includes(start) ? start : 'plan');
  </script>

