---
import { getEntry } from 'astro:content';
import CVHeader from '../../components/cv/CVHeader.astro';
import ViewModeToggle from '../../components/cv/ViewModeToggle.astro';
import MarkdownViewer from '../../components/cv/MarkdownViewer.astro';
import '../../styles/global.css';
import '../../styles/cv.css';

const cv = await getEntry('cv', 'kyle-snow-schwartz');
if (!cv) {
  throw new Error('CV content not found');
}

const { Content } = await cv.render();

// Get raw markdown source (body includes frontmatter-stripped content)
const rawSource = cv.body;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{cv.data.name} - CV</title>
  <meta name="description" content={`${cv.data.title} - ${cv.data.tagline || ''}`}>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link
    href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&family=Share+Tech+Mono&display=swap"
    rel="stylesheet">
</head>

<body class="cv-page" data-view-mode="html" data-zoom="125">
  <ViewModeToggle />

  <article class="cv-document">
    <!-- HTML View (default) -->
    <div class="view-html">
      <CVHeader {...cv.data} />
      <div class="cv-content">
        <Content />
      </div>
    </div>

    <!-- Markdown View -->
    <div class="view-markdown" hidden>
      <MarkdownViewer source={rawSource} />
    </div>

    <footer class="cv-footer print-hidden">
      <p>Last updated: {cv.data.updated}</p>
    </footer>
  </article>
</body>
</html>

<style>
  /* View mode visibility */
  .cv-page[data-view-mode="html"] .view-html {
    display: block;
  }

  .cv-page[data-view-mode="html"] .view-markdown {
    display: none;
  }

  .cv-page[data-view-mode="markdown"] .view-html {
    display: none;
  }

  .cv-page[data-view-mode="markdown"] .view-markdown {
    display: block;
  }
</style>
