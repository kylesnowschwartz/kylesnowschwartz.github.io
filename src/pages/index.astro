---
// Main site homepage
import '../styles/global.css';
import Header from '../components/Header.astro';
import Sidebar from '../components/Sidebar.astro';
import AboutPanel from '../components/AboutPanel.astro';
import SkillsSection from '../components/SkillsSection.astro';
import Footer from '../components/Footer.astro';

const projects = [
  { name: 'tail-claude', href: 'https://github.com/kylesnowschwartz/tail-claude', lang: 'go', desc: 'TUI for Claude sessions' },
  { name: 'SimpleClaude', href: 'https://github.com/kylesnowschwartz/SimpleClaude', lang: 'ruby', desc: 'Claude plugin framework' },
  { name: 'zsh-ai-cmd', href: 'https://github.com/kylesnowschwartz/zsh-ai-cmd', lang: 'shell', desc: 'natural language to shell' },
  { name: 'claude-bumper-lanes', href: 'https://github.com/kylesnowschwartz/claude-bumper-lanes', lang: 'go', desc: 'git-backed edit guardrails' },
  { name: 'hgnucomb', href: 'https://github.com/kylesnowschwartz/hgnucomb', lang: 'ts', desc: 'spatial terminal multiplexer' },
  { name: 'ralph-ban', href: 'https://github.com/kylesnowschwartz/ralph-ban', lang: 'go', desc: 'ralph/kanban hybrid' },
  { name: 'marmiteroids', href: '/marmiteroids/', lang: 'threejs', desc: '' },
];

const skills = [
  {
    title: 'Languages & Frameworks & Infra',
    items: ['Ruby-on-Rails', 'JavaScript', 'AWS', 'Cloudflare', 'Jenkins', 'CLI Tooling'],
  },
  {
    title: 'AI & Automation',
    items: ['LLM Tooling', 'Prompt Engineering', 'Claude Code', 'AI Enablement'],
  },
  {
    title: 'Ways of Working',
    items: ['Technical Leadership', 'Remote-First', 'TDD', 'DevX'],
  },
];

const values = [
  {
    title: 'Communication',
    items: ['Written Clarity', 'Async-First', 'Direct Feedback'],
  },
  {
    title: 'Craft',
    items: ['Clean Code', 'Continuous Improvement', 'Simplicity'],
  },
  {
    title: 'Culture',
    items: ['Autonomy', 'Accountability', 'Humanism'],
  },
  {
    title: 'Growth',
    items: ['Mentoring', 'Learning in Public', 'Curiosity'],
  },
];

const socialLinks = [
  { name: 'github', href: 'https://github.com/kylesnowschwartz' },
  { name: 'linkedin', href: 'https://www.linkedin.com/in/kyle-snow-schwartz-432697103' },
];
---

<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Kyle Snow Schwartz</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link
    href="https://fonts.googleapis.com/css2?family=Instrument+Sans:wght@400;500;600;700&family=Share+Tech+Mono&display=swap"
    rel="stylesheet">
  <script type="importmap">
  {
    "imports": {
      "three": "https://cdn.jsdelivr.net/npm/three@0.170.0/build/three.module.js"
    }
  }
  </script>
</head>

<body>
  <Header />

  <div class="container">
    <main>
      <Sidebar projects={projects} />

      <section class="content">
        <div class="about-grid">
          <AboutPanel title="Who">
            <p>Kyle Snow Schwartz.</p>
            <p>Software engineer, occasional pizzaiolo, shaver of yaks.</p>
            <p>I build things for the web and sometimes wander off to take photos of sheep.</p>
          </AboutPanel>

          <AboutPanel title="What">
            <p>Currently building things at <a href="https://elements.envato.com/">Envato Elements</a>. Previously at
              <a href="https://www.powershop.co.nz/">Powershop</a>.
            </p>
            <p>I care about clean code, humanism, and developer-experience.</p>
          </AboutPanel>

          <AboutPanel title="Where">
            <p>Based in New Zealand since before it was cool.</p>
            <p>Find me on <a href="https://github.com/kylesnowschwartz">GitHub</a> or <a
                href="https://www.linkedin.com/in/kyle-snow-schwartz-432697103">LinkedIn</a>.</p>
          </AboutPanel>
        </div>

        <SkillsSection header="What I know" categories={skills} variant="skills" />
        <SkillsSection header="What I believe" categories={values} variant="values" />
      </section>
    </main>
  </div>

  <Footer socialLinks={socialLinks} />

  <!-- Background bouncing jars (click on background to spawn) -->
  <script type="module" src="/scripts/background-jars.js"></script>

  <!-- Spinning Marmite jar icon in sidebar -->
  <script type="module">
    import * as THREE from 'three';

    const canvas = document.getElementById('marmite-jar');
    if (canvas) {
      const size = 150;

      const scene = new THREE.Scene();
      const camera = new THREE.PerspectiveCamera(50, 1, 0.1, 100);
      camera.position.z = 9;

      const renderer = new THREE.WebGLRenderer({canvas, alpha: true, antialias: true});
      renderer.setSize(size, size);
      renderer.setPixelRatio(window.devicePixelRatio);

      // Jar geometry - same proportions as marmiteroids
      const geometry = new THREE.CylinderGeometry(0.75, 0.75, 1.5, 32);

      // Load textures from marmiteroids folder
      const textureLoader = new THREE.TextureLoader();
      const labelTexture = textureLoader.load('/marmiteroids/images/marmiteroids_label2.jpg');
      const topTexture = textureLoader.load('/marmiteroids/images/cap_red.jpg');
      const bottomTexture = textureLoader.load('/marmiteroids/images/bottom.jpg');
      labelTexture.colorSpace = THREE.SRGBColorSpace;
      topTexture.colorSpace = THREE.SRGBColorSpace;
      bottomTexture.colorSpace = THREE.SRGBColorSpace;

      const materials = [
        new THREE.MeshBasicMaterial({map: labelTexture}),
        new THREE.MeshBasicMaterial({map: topTexture}),
        new THREE.MeshBasicMaterial({map: bottomTexture})
      ];

      // Spawn 3 jars, spaced side by side with independent chaotic motion
      const jars = [];
      const jarScale = 0.85;
      const xPositions = [-2, 0, 2];
      for (let i = 0; i < 3; i++) {
        const jar = new THREE.Mesh(geometry, materials);
        jar.scale.set(jarScale, jarScale, jarScale);
        scene.add(jar);

        jars.push({
          mesh: jar,
          baseX: xPositions[i],
          rotationSpeeds: [
            0.0001 + Math.random() * 0.0029,
            0.0001 + Math.random() * 0.0029,
            0.0001 + Math.random() * 0.0029,
          ],
          wobble: [
            [0.0001 + Math.random() * 0.0002, 0.2 + Math.random() * 0.4],
            [0.0001 + Math.random() * 0.0002, 0.2 + Math.random() * 0.4],
            [0.0001 + Math.random() * 0.0002, 0.2 + Math.random() * 0.3],
          ],
          scalePulse: {
            freq: 0.0005 + Math.random() * 0.001,
            amount: 0.03 + Math.random() * 0.07,
          },
          // Stagger spawn times so jars start at different phases
          timeOffset: Math.random() * 10000,
        });
      }

      const startTime = Date.now();

      function animate() {
        requestAnimationFrame(animate);
        const now = Date.now();

        for (const j of jars) {
          const elapsed = now - startTime + j.timeOffset;

          j.mesh.rotation.x = elapsed * j.rotationSpeeds[0];
          j.mesh.rotation.y = elapsed * j.rotationSpeeds[1];
          j.mesh.rotation.z = elapsed * j.rotationSpeeds[2];

          j.mesh.position.x = j.baseX + Math.sin(elapsed * j.wobble[0][0]) * j.wobble[0][1];
          j.mesh.position.y = Math.sin(elapsed * j.wobble[1][0]) * j.wobble[1][1];
          j.mesh.position.z = Math.sin(elapsed * j.wobble[2][0]) * j.wobble[2][1];

          const s = jarScale + Math.sin(elapsed * j.scalePulse.freq) * j.scalePulse.amount;
          j.mesh.scale.set(s, s, s);
        }

        renderer.render(scene, camera);
      }
      animate();
    }
  </script>
</body>

</html>

<style>
  /* Main layout grid */
  main {
    display: grid;
    grid-template-columns: var(--sidebar-width) 1fr;
    min-height: calc(100vh - 200px);
  }

  .content {
    padding: 2rem 0 2rem 2rem;
  }

  .about-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--gap);
  }

  /* Responsive */
  @media (max-width: 900px) {
    main {
      grid-template-columns: 1fr;
    }

    .content {
      padding: 2rem 0;
    }

    .about-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
