---
// Main site homepage
import '../styles/global.css';
import Header from '../components/Header.astro';
import OnSiteShelf from '../components/OnSiteShelf.astro';
import ProjectsPanel from '../components/ProjectsPanel.astro';
import AboutPanel from '../components/AboutPanel.astro';
import SkillsSection from '../components/SkillsSection.astro';
import Footer from '../components/Footer.astro';

// External code (GitHub) — the full-width marquee band. Reading order =
// importance: proven adoption first, then the newest agent-tooling
// direction, then distinctive ecosystem work, one product closer.
const repos = [
  { name: 'tail-claude', href: 'https://github.com/kylesnowschwartz/tail-claude', lang: 'go', desc: 'TUI for Claude sessions' },
  { name: 'SimpleClaude', href: 'https://github.com/kylesnowschwartz/SimpleClaude', lang: 'ruby', desc: 'practical minimalism for AI-assisted programming' },
  { name: 'zsh-ai-cmd', href: 'https://github.com/kylesnowschwartz/zsh-ai-cmd', lang: 'shell', desc: 'natural language to shell' },
  { name: 'claude-code-hero', href: 'https://github.com/kylesnowschwartz/claude-code-hero', lang: 'ruby', desc: 'gamified Claude Code quest' },
  { name: 'claude-bumper-lanes', href: 'https://github.com/kylesnowschwartz/claude-bumper-lanes', lang: 'go', desc: 'git-backed edit guardrails' },
  { name: 'ralph-ban', href: 'https://github.com/kylesnowschwartz/ralph-ban', lang: 'go', desc: 'ralph/kanban hybrid' },
  { name: 'agent-ouija', href: 'https://github.com/kylesnowschwartz/agent-ouija', lang: 'go', desc: 'read agent session state off disk' },
  { name: 'agent-love-letters', href: 'https://github.com/kylesnowschwartz/agent-love-letters', lang: 'js', desc: 'one-shot letters for agents in other repos' },
  { name: 'tail-claude-mux', href: 'https://github.com/kylesnowschwartz/tail-claude-mux', lang: 'go', desc: 'tmux sidebar with live agent state' },
  { name: 'gearshifter', href: 'https://github.com/kylesnowschwartz/gearshifter', lang: 'go', desc: 'tmux control-deck popup for Claude Code' },
  { name: 'hgnucomb', href: 'https://github.com/kylesnowschwartz/hgnucomb', lang: 'ts', desc: 'spatial terminal multiplexer' },
  { name: 'prompt-intercept-pattern', href: 'https://github.com/kylesnowschwartz/prompt-intercept-pattern', lang: 'shell', desc: 'hook-intercepted commands, no API call' },
  { name: 'plugin-dev', href: 'https://github.com/kylesnowschwartz/plugin-dev', lang: 'shell', desc: 'toolkit for building Claude Code plugins' },
  { name: 'tail-claude-hud', href: 'https://github.com/kylesnowschwartz/tail-claude-hud', lang: 'go', desc: 'statusline for Claude sessions' },
  { name: 'shelf', href: 'https://github.com/kylesnowschwartz/shelf', lang: 'js', desc: 'local reading-recommendation engine' },
];

// On-site destinations — each rendered as a bespoke object that leaks the
// world it leads to (see OnSiteShelf.astro). `kind` selects the treatment.
const onSite = [
  { name: 'marmiteroids', href: '/marmiteroids/', kind: 'jar' as const, desc: 'floating 3D art piece' },
  { name: 'cv', href: '/cv/', kind: 'paper' as const },
  { name: 'reading-list', href: '/reading-list/', kind: 'spines' as const, desc: 'filterable map of books read' },
  { name: 'worst-commish-ever', href: '/worst-commish-ever/', kind: 'trophy' as const, desc: '25 years of fantasy-football crimes' },
];

const skills = [
  {
    title: 'Languages & Frameworks & Infra',
    items: ['Language-agnostic (hand-code in Ruby)', 'API Design', 'AWS', 'Cloudflare', 'Terraform', 'Buildkite', 'CLI Tooling'],
  },
  {
    title: 'AI & Automation',
    items: ['Context Engineering', 'Harness Engineering', 'Multi-Agent Orchestration', 'Agent & Tool Design', 'AI Enablement'],
  },
  {
    title: 'Ways of Working',
    items: ['Technical Leadership', 'Remote-First', 'TDD', 'DevX'],
  },
];

const values = [
  {
    title: 'Communication',
    items: ['Written Clarity', 'Async-First', 'Direct Feedback'],
  },
  {
    title: 'Craft',
    items: ['Clean Code', 'Continuous Improvement', 'Simplicity'],
  },
  {
    title: 'Culture',
    items: ['Autonomy', 'Accountability', 'Humanism'],
  },
  {
    title: 'Growth',
    items: ['Mentoring', 'Learning in Public', 'Curiosity'],
  },
];

const socialLinks = [
  { name: 'github', href: 'https://github.com/kylesnowschwartz' },
  { name: 'linkedin', href: 'https://www.linkedin.com/in/kyle-snow-schwartz-432697103' },
];
---

<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Kyle Snow Schwartz</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link
    href="https://fonts.googleapis.com/css2?family=Instrument+Sans:wght@400;500;600;700&family=Share+Tech+Mono&family=Space+Grotesk:wght@400;500;700&display=swap"
    rel="stylesheet">
  <script type="importmap">
  {
    "imports": {
      "three": "https://cdn.jsdelivr.net/npm/three@0.170.0/build/three.module.js"
    }
  }
  </script>
</head>

<body class="home">
  <!-- Asymmetric background composition (behind content, z-index 0):
       a tilted "sheet", a masked diagonal weave corner, a diagonal accent
       rule, and an oversized faint glyph. Reads as bespoke and designed. -->
  <div class="bg-layers" aria-hidden="true">
    <div class="sheet"></div>
    <div class="weave-corner"></div>
    <div class="accent-rule"></div>
    <div class="glyph">&gt;_</div>
  </div>

  <Header />

  <div class="container">
    <main class="page-grid">
      <div class="onsite-box g-onsite">
        <OnSiteShelf items={onSite} />
      </div>

      <AboutPanel title="Who" class="g-who who">
        <p>Kyle Snow Schwartz.</p>
        <p>Software engineer, occasional pizzaiolo, shaver of yaks.</p>
        <p>I build things for the web and sometimes wander off to take photos of sheep.</p>
      </AboutPanel>

      <AboutPanel title="What" class="g-what">
        <p>Spreading tidings of Claude Code and Pi amongst fellow engineers.</p>
        <p>Never passing up an opportunity to say "I built this in Claude 6 months ago."</p>
        <p>Wondering why my markdown files haven't racked up 10,000 stars on GitHub yet.</p>
      </AboutPanel>

      <AboutPanel title="Where" class="g-where">
        <p>Based in New Zealand since before it was cool.</p>
        <p>Find me on <a href="https://github.com/kylesnowschwartz">GitHub</a> or <a
            href="https://www.linkedin.com/in/kyle-snow-schwartz-432697103">LinkedIn</a>, read my <a
            href="/cv/">CV</a>, or email:</p>
        <p class="email-line"><a href="mailto:Kyle.SnowSchwartz@gmail.com">Kyle.SnowSchwartz@<wbr />gmail.com</a></p>
      </AboutPanel>

      <ProjectsPanel repos={repos} class="g-projects" />

      <SkillsSection header="What I know" categories={skills} variant="skills" class="g-know" />
      <SkillsSection header="What I believe" categories={values} variant="values" class="g-believe" />
    </main>
  </div>

  <Footer socialLinks={socialLinks} />

  <!-- Background bouncing jars (click on background to spawn) -->
  <script type="module" src="/scripts/background-jars.js"></script>

  <!-- Spinning Marmite jar icon in sidebar -->
  <script type="module">
    import * as THREE from 'three';

    const canvas = document.getElementById('marmite-jar');
    if (canvas) {
      const size = 150;

      const scene = new THREE.Scene();
      const camera = new THREE.PerspectiveCamera(50, 1, 0.1, 100);
      camera.position.z = 9;

      const renderer = new THREE.WebGLRenderer({canvas, alpha: true, antialias: true});
      renderer.setSize(size, size);
      renderer.setPixelRatio(window.devicePixelRatio);

      // Jar geometry - same proportions as marmiteroids
      const geometry = new THREE.CylinderGeometry(0.75, 0.75, 1.5, 32);

      // Load textures from marmiteroids folder
      const textureLoader = new THREE.TextureLoader();
      const labelTexture = textureLoader.load('/marmiteroids/images/marmiteroids_label2.jpg');
      const topTexture = textureLoader.load('/marmiteroids/images/cap_red.jpg');
      const bottomTexture = textureLoader.load('/marmiteroids/images/bottom.jpg');
      labelTexture.colorSpace = THREE.SRGBColorSpace;
      topTexture.colorSpace = THREE.SRGBColorSpace;
      bottomTexture.colorSpace = THREE.SRGBColorSpace;

      const materials = [
        new THREE.MeshBasicMaterial({map: labelTexture}),
        new THREE.MeshBasicMaterial({map: topTexture}),
        new THREE.MeshBasicMaterial({map: bottomTexture})
      ];

      // Spawn 3 jars, spaced side by side with independent chaotic motion
      const jars = [];
      const jarScale = 0.85;
      const xPositions = [-2, 0, 2];
      for (let i = 0; i < 3; i++) {
        const jar = new THREE.Mesh(geometry, materials);
        jar.scale.set(jarScale, jarScale, jarScale);
        scene.add(jar);

        jars.push({
          mesh: jar,
          baseX: xPositions[i],
          rotationSpeeds: [
            0.0001 + Math.random() * 0.0029,
            0.0001 + Math.random() * 0.0029,
            0.0001 + Math.random() * 0.0029,
          ],
          wobble: [
            [0.0001 + Math.random() * 0.0002, 0.2 + Math.random() * 0.4],
            [0.0001 + Math.random() * 0.0002, 0.2 + Math.random() * 0.4],
            [0.0001 + Math.random() * 0.0002, 0.2 + Math.random() * 0.3],
          ],
          scalePulse: {
            freq: 0.0005 + Math.random() * 0.001,
            amount: 0.03 + Math.random() * 0.07,
          },
          // Stagger spawn times so jars start at different phases
          timeOffset: Math.random() * 10000,
        });
      }

      const startTime = Date.now();

      function animate() {
        requestAnimationFrame(animate);
        const now = Date.now();

        for (const j of jars) {
          const elapsed = now - startTime + j.timeOffset;

          j.mesh.rotation.x = elapsed * j.rotationSpeeds[0];
          j.mesh.rotation.y = elapsed * j.rotationSpeeds[1];
          j.mesh.rotation.z = elapsed * j.rotationSpeeds[2];

          j.mesh.position.x = j.baseX + Math.sin(elapsed * j.wobble[0][0]) * j.wobble[0][1];
          j.mesh.position.y = Math.sin(elapsed * j.wobble[1][0]) * j.wobble[1][1];
          j.mesh.position.z = Math.sin(elapsed * j.wobble[2][0]) * j.wobble[2][1];

          const s = jarScale + Math.sin(elapsed * j.scalePulse.freq) * j.scalePulse.amount;
          j.mesh.scale.set(s, s, s);
        }

        renderer.render(scene, camera);
      }
      animate();
    }
  </script>
</body>

</html>

<style>
  /* === THE PAGE GRID — "making & breaking the grid" (see CLAUDE.md) ===
     One shared 13-column grid. Every block is placed by column span and
     shares alignment lines; folds land on Fibonacci ratios (≈ φ):
       line 6  → shelf : content = 5 : 8
       line 11 → what : where    = 5 : 3
       line 9  → know : believe  = 8 : 5
     Projects runs full-width (1 / 14) as the marquee band, echoing the
     wordmark's horizontal energy.
     No negative-margin nudges. The only break is the header wordmark. */
  .page-grid {
    display: grid;
    grid-template-columns: repeat(13, 1fr);
    column-gap: var(--col-gap);
    row-gap: var(--s5);
    margin-top: var(--s6);
    margin-bottom: var(--s7);
    min-height: calc(100dvh - 240px);
    align-content: start;
  }

  /* The email is as wide as the Where box: give it its own mono line that
     breaks only at the <wbr> after the @, never mid-word. */
  .email-line a {
    font-family: var(--font-mono);
    overflow-wrap: normal;
    word-break: keep-all;
  }

  /* Placement lives here; component styling stays in each component.
     g-* classes ride on the child component roots, so target them global. */
  .page-grid > .g-onsite           { grid-column: 1 / 6;  grid-row: 1 / 3; }
  .page-grid > :global(.g-who)     { grid-column: 6 / 14; grid-row: 1 / 2; }
  .page-grid > :global(.g-what)    { grid-column: 6 / 11; grid-row: 2 / 3; }
  .page-grid > :global(.g-where)   { grid-column: 11 / 14; grid-row: 2 / 3; }
  .page-grid > :global(.g-projects) { grid-column: 1 / 14; grid-row: 3 / 4; }
  .page-grid > :global(.g-know)    { grid-column: 1 / 9;  grid-row: 4 / 5; }
  .page-grid > :global(.g-believe) { grid-column: 9 / 14; grid-row: 4 / 5; }

  /* Page-load orchestration: one staggered entrance in grid reading order
     (left→right, top→bottom), then stillness. Total stagger stays under
     500ms so the page settles fast. Reduced-motion zeroes duration+delay
     globally (global.css), so the fill jumps straight to visible. */
  .page-grid > * , .page-grid > :global(*) {
    opacity: 0;
    transform: translateY(8px);
    animation: grid-reveal var(--dur-long) var(--ease-out) forwards;
    animation-delay: calc(var(--i, 0) * 60ms);
  }
  .page-grid > .g-onsite            { --i: 0; }
  .page-grid > :global(.g-who)      { --i: 1; }
  .page-grid > :global(.g-what)     { --i: 2; }
  .page-grid > :global(.g-where)    { --i: 3; }
  .page-grid > :global(.g-projects) { --i: 4; }
  .page-grid > :global(.g-know)     { --i: 5; }
  .page-grid > :global(.g-believe)  { --i: 6; }

  @keyframes grid-reveal {
    to { opacity: 1; transform: none; }
  }

  /* On-site shelf as a standalone surface box; the shelf drops its
     "section divider" chrome because the box provides the boundary. */
  .onsite-box {
    padding: 1rem;
    border: 1px solid var(--color-border);
    background: var(--color-surface);
    transition: border-color var(--dur-short) var(--ease-out), box-shadow var(--dur-short) var(--ease-out);
  }

  .onsite-box:hover {
    border-color: var(--color-accent-secondary);
    box-shadow: 0 0 20px rgba(0, 255, 222, 0.2);
  }

  .onsite-box :global(.onsite) {
    margin-top: 0;
    padding-top: 0;
    border-top: none;
  }

  /* === ASYMMETRIC BACKGROUND COMPOSITION (z-index 0, behind content) === */
  .bg-layers {
    position: fixed;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    overflow: hidden;
  }

  /* tilted "sheet" anchored near the content's right alignment region */
  .bg-layers .sheet {
    position: absolute;
    top: -14%;
    left: 66%;
    right: -16%;
    height: 132%;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    transform: rotate(-4deg);
    background-image: repeating-linear-gradient(45deg, rgba(60, 40, 20, 0.1) 0 1px, transparent 1px 5px);
    box-shadow: -30px 40px 80px rgba(60, 40, 20, 0.05);
  }

  /* masked diagonal weave in the top-left corner */
  .bg-layers .weave-corner {
    position: absolute;
    top: -10%;
    left: -8%;
    width: 46.2%;
    height: 61.8%;
    background-image: repeating-linear-gradient(45deg, rgba(60, 40, 20, 0.13) 0 1px, transparent 1px 5px);
    -webkit-mask-image: radial-gradient(ellipse at top left, #000 10%, transparent 70%);
    mask-image: radial-gradient(ellipse at top left, #000 10%, transparent 70%);
  }

  /* diagonal accent rule — the bleed's energy is aligned to this angle */
  .bg-layers .accent-rule {
    position: absolute;
    left: -10%;
    top: 61.8%;
    width: 70%;
    height: 2px;
    background: linear-gradient(90deg, transparent, var(--color-accent-tertiary) 30%, var(--color-accent) 90%, transparent);
    transform: rotate(-8deg);
    opacity: 0.5;
  }

  /* oversized faint terminal glyph, bottom-left */
  .bg-layers .glyph {
    position: absolute;
    left: -3vw;
    bottom: -10vh;
    font-family: var(--font-mono);
    font-size: 44vh;
    line-height: 1;
    color: var(--color-text);
    opacity: 0.025;
    user-select: none;
  }

  /* === RESPONSIVE — below the breakpoint every block returns to one
     deliberate column; with no grid, there is nothing to break. === */
  @media (max-width: 900px) {
    .page-grid {
      grid-template-columns: 1fr;
      row-gap: var(--s5);
      margin-top: var(--s5);
      min-height: 0;
    }

    .page-grid > .g-onsite,
    .page-grid > :global(.g-who),
    .page-grid > :global(.g-what),
    .page-grid > :global(.g-where),
    .page-grid > :global(.g-projects),
    .page-grid > :global(.g-know),
    .page-grid > :global(.g-believe) {
      grid-column: 1 / -1;
      grid-row: auto;
    }

    .bg-layers .sheet {
      left: 55%;
      right: -40%;
    }
  }
</style>
