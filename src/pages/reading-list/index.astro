---
/**
 * Reading List — "The House" (a Piranesi callback): everything Kyle's read.
 *
 * Standalone route (like marmiteroids / bumper-lanes): own <head> + fonts. It
 * imports global.css for the reset, spacing scale and easing tokens, then
 * dresses itself as a museum catalogue of red-figure pottery: terracotta and
 * bone on black glaze, Cinzel capitals over EB Garamond, square hairline
 * controls, a duotone Piranesi etching and an engraved wave band behind the
 * header, and a genre ornament band at the top of every card. Three layers:
 * data (src/data/reading-list.ts), model (src/lib/reading-list.ts), view (the
 * components below).
 */
import '../../styles/global.css';
import { BOOKS } from '../../data/reading-list';
import FilterSidebar from '../../components/reading-list/FilterSidebar.astro';
import BookGrid from '../../components/reading-list/BookGrid.astro';
import WaveBand from '../../components/reading-list/WaveBand.astro';
import { ornamentVars } from '../../components/reading-list/ornaments';

const total = BOOKS.length;
---

<!DOCTYPE html>
<html lang="en" class="rl-root">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>The House — Kyle Snow Schwartz</title>
  <meta name="description" content={`Everything I've read so I can remember — ${total} books, filterable by genre.`} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;500;600&family=EB+Garamond:ital,wght@0,400;0,500;0,600;1,400&display=swap"
    rel="stylesheet"
  />
</head>

<body class="rl-body">
  <div class="rl-page" style={ornamentVars}>
    <header class="rl-head">
      <img
        class="plate"
        src="/reading-list/carceri-plate.webp"
        alt=""
        aria-hidden="true"
        width="900"
        height="828"
        decoding="async"
        fetchpriority="low"
      />
      <h1>The House</h1>
    </header>

    <div class="tide"><WaveBand /></div>

    <div class="layout">
      <FilterSidebar />
      <BookGrid />
    </div>

    <footer class="rl-foot">
      <div class="meander" aria-hidden="true"></div>
      <p>editorial classification — one reader's map, not gospel. argue with it.</p>
    </footer>
  </div>

  <script>
    import { BOOKS, GROUPS } from '../../data/reading-list';
    import {
      emptyActive,
      activeCount,
      visible,
      countForMode,
      availableCounts,
      type Mode,
    } from '../../lib/reading-list';

    type FK = 'g' | 's' | 'b';

    const active = emptyActive();
    let mode: Mode = 'or';

    const grid = document.getElementById('rl-grid') as HTMLElement;
    const cards = Array.from(grid.querySelectorAll<HTMLElement>('.card'));
    const tags = Array.from(grid.querySelectorAll<HTMLElement>('.tag'));
    const pills = Array.from(document.querySelectorAll<HTMLElement>('.pill'));
    const fgroups = Array.from(document.querySelectorAll<HTMLElement>('.fgroup'));
    const modeBtns = Array.from(document.querySelectorAll<HTMLElement>('#rl-mode button'));
    const empty = document.getElementById('rl-empty') as HTMLElement;
    const countEl = document.getElementById('rl-count') as HTMLElement;
    const clearBtn = document.getElementById('rl-clear') as HTMLElement;
    const mcOr = document.getElementById('rl-mc-or') as HTMLElement;
    const mcAnd = document.getElementById('rl-mc-and') as HTMLElement;
    const hintEl = document.getElementById('rl-modehint') as HTMLElement;
    const modeWrap = document.getElementById('rl-mode') as HTMLElement;

    function toggle(group: FK, val: string) {
      const set = active[group];
      if (set.has(val)) set.delete(val);
      else set.add(val);
      render();
    }

    function render() {
      let shown = 0;
      for (const card of cards) {
        const bk = BOOKS[Number(card.dataset.idx)];
        if (!bk) continue;
        const vis = visible(bk, active, GROUPS, mode);
        card.hidden = !vis;
        if (vis) shown++;
      }
      empty.hidden = shown !== 0;

      // Faceted pill narrowing: a pill's count reflects how many books it would
      // still reach given the OTHER groups' active filters; a pill that reaches
      // zero (e.g. "Hard Magic" once "Nonfiction" is picked) is hidden so no
      // dead-end combo is offered. A selected pill always stays visible so it
      // can be toggled back off, even if its own contextual count is 0.
      const avail = {
        g: availableCounts(BOOKS, active, GROUPS, 'g', mode),
        s: availableCounts(BOOKS, active, GROUPS, 's', mode),
        b: availableCounts(BOOKS, active, GROUPS, 'b', mode),
      };
      for (const p of pills) {
        const g = p.dataset.group as FK;
        const val = p.dataset.val as string;
        const on = active[g].has(val);
        const n = avail[g].get(val) ?? 0;
        const nEl = p.querySelector('.n');
        if (nEl) nEl.textContent = String(n);
        p.hidden = n === 0 && !on;
        p.classList.toggle('on', on);
        p.setAttribute('aria-pressed', String(on));
      }
      // Collapse a whole facet group once all its pills are hidden, so an empty
      // "Genre blend" label never lingers under a narrowing selection.
      for (const fg of fgroups) {
        const anyVisible = Array.from(fg.querySelectorAll<HTMLElement>('.pill')).some((p) => !p.hidden);
        fg.hidden = !anyVisible;
      }
      for (const t of tags) {
        const g = t.dataset.group as FK;
        const on = active[g].has(t.dataset.val as string);
        t.classList.toggle('match', on);
        t.setAttribute('aria-pressed', String(on));
      }

      const total = BOOKS.length;
      countEl.innerHTML = `<b>${shown}</b> of ${total} books${shown < total ? ' · filtered' : ''}`;
      clearBtn.classList.toggle('on', activeCount(active) > 0);

      updateModeToggle();
    }

    // The ANY/ALL toggle is only worth showing when it actually changes the
    // result — i.e. the two modes yield different counts. Otherwise (single
    // pill, single-valued genre, non-overlapping picks) hide the whole control.
    function updateModeToggle() {
      const nOr = countForMode(BOOKS, active, GROUPS, 'or');
      const nAnd = countForMode(BOOKS, active, GROUPS, 'and');
      const meaningful = nOr !== nAnd;
      modeWrap.hidden = !meaningful;
      hintEl.hidden = !meaningful;
      if (!meaningful) {
        if (mode !== 'or') setMode('or');
        return;
      }
      mcOr.textContent = String(nOr);
      mcAnd.textContent = String(nAnd);
      hintEl.textContent = `switching to ALL drops ${nOr - nAnd} book${nOr - nAnd === 1 ? '' : 's'}`;
      hintEl.classList.add('active');
    }

    function setMode(next: Mode) {
      mode = next;
      for (const b of modeBtns) {
        const on = b.dataset.mode === next;
        b.classList.toggle('on', on);
        b.setAttribute('aria-pressed', String(on));
      }
    }

    for (const p of pills) {
      p.addEventListener('click', () => toggle(p.dataset.group as FK, p.dataset.val as string));
    }
    for (const t of tags) {
      t.addEventListener('click', () => toggle(t.dataset.group as FK, t.dataset.val as string));
    }
    clearBtn.addEventListener('click', () => {
      active.g.clear();
      active.s.clear();
      active.b.clear();
      render();
    });
    for (const btn of modeBtns) {
      btn.addEventListener('click', () => {
        setMode(btn.dataset.mode as Mode);
        render();
      });
    }

    // --- sorting: reorders the card DOM in place; orthogonal to filtering ---
    const sortSel = document.getElementById('rl-sort') as HTMLSelectElement;
    const stripArticle = (s: string) => s.replace(/^(the|a|an)\s+/i, '');
    const surname = (a: string) => {
      const parts = a.split(/ & |, /)[0].trim().split(/\s+/);
      return parts[parts.length - 1].toLowerCase();
    };
    function applySort(by: string) {
      const arr = [...cards];
      arr.sort((x, y) => {
        const bx = BOOKS[Number(x.dataset.idx)];
        const by2 = BOOKS[Number(y.dataset.idx)];
        if (!bx || !by2) return 0;
        switch (by) {
          case 'title':
            return stripArticle(bx.t).localeCompare(stripArticle(by2.t));
          case 'author':
            return surname(bx.a).localeCompare(surname(by2.a)) || stripArticle(bx.t).localeCompare(stripArticle(by2.t));
          case 'year-asc':
            return (bx.year ?? Infinity) - (by2.year ?? Infinity);
          case 'year-desc':
            return (by2.year ?? -Infinity) - (bx.year ?? -Infinity);
          default:
            return Number(x.dataset.idx) - Number(y.dataset.idx); // curated
        }
      });
      for (const c of arr) grid.appendChild(c);
    }
    sortSel.addEventListener('change', () => applySort(sortSel.value));

    // --- view toggle: cards (default) vs condensed list. Restyles the same
    //     cards via a class on the grid; preference persists in localStorage. ---
    const viewBtns = Array.from(document.querySelectorAll<HTMLElement>('.viewbtn'));
    function setView(v: string) {
      grid.classList.toggle('list', v === 'list');
      for (const b of viewBtns) {
        const on = b.dataset.view === v;
        b.classList.toggle('on', on);
        b.setAttribute('aria-pressed', String(on));
      }
      try { localStorage.setItem('rl-view', v); } catch {}
    }
    for (const b of viewBtns) {
      b.addEventListener('click', () => setView(b.dataset.view as string));
    }
    let savedView: string | null = null;
    try { savedView = localStorage.getItem('rl-view'); } catch {}
    if (savedView === 'list') setView('list');

    render();
  </script>

  <style>
    /* Hallmark · genre: editorial · macrostructure: Catalogue · theme: custom (vibe: "red-figure vase, Piranesi etching, museum catalogue") · paper oklch(17% 0.012 45) · accent oklch(64% 0.14 45) terracotta · Cinzel + EB Garamond · enrichment: Tier B (duotone public-domain etching + hand-built SVG ornament) · nav: N9 · footer: Ft2 · merge: A card bands + B sidebar/cards */

    /* Red-figure palette: terracotta figures and bone slip on black glaze.
       Declared on the root of this route only, so body, page and both child
       components read the same names. */
    :global(html.rl-root) {
      --rl-paper: oklch(17% 0.012 45);
      --rl-paper-2: oklch(20.5% 0.014 45);
      --rl-ink: oklch(90% 0.022 75);
      --rl-ink-2: oklch(72% 0.03 60);
      --rl-clay: oklch(64% 0.14 45);
      --rl-clay-2: oklch(74% 0.12 55);
      --rl-rule: oklch(36% 0.035 45);
      --rl-display: 'Cinzel', 'Trajan Pro', serif;
      --rl-body: 'EB Garamond', 'Garamond', Georgia, serif;
      --rl-ease: var(--ease-out);
      --rl-dur: 140ms;
      background: var(--rl-paper);
      color-scheme: dark;
      overflow-x: clip;
    }
    :global(body.rl-body) {
      background: var(--rl-paper);
      color: var(--rl-ink);
      font-family: var(--rl-body);
      font-size: 1.0625rem;
      line-height: 1.55;
      overflow-x: clip;
    }
    /* The site's paper-grain and diagonal-weave layers are tuned for a cream
       ground and only muddy the glaze, so this route switches them off. */
    :global(body.rl-body)::before,
    :global(body.rl-body)::after {
      content: none;
    }
    :global(html.rl-root ::selection) {
      background: var(--rl-clay);
      color: var(--rl-paper);
    }
    :global(html.rl-root :focus-visible) {
      outline: 2px solid var(--rl-clay-2);
      outline-offset: 2px;
      transition: none;
    }

    .rl-page {
      max-width: var(--container-max);
      margin: 0 auto;
      padding: var(--s4) var(--s3) var(--s5);
      position: relative;
      z-index: 1;
    }

    /* --- header: the title over one decorative plate; nothing in it is
       interactive --- */
    .rl-head {
      position: relative;
      min-height: 15rem;
      display: flex;
      flex-direction: column;
      justify-content: flex-end;
      padding-bottom: var(--s3);
      isolation: isolate;
    }
    .plate {
      position: absolute;
      top: calc(-1 * var(--s4));
      /* runs to the viewport's right edge; html/body clip the overrun */
      right: calc((100% - 100vw) / 2);
      width: min(62%, 820px);
      height: calc(100% + var(--s4));
      object-fit: cover;
      object-position: 60% 30%;
      opacity: 0.3;
      pointer-events: none;
      user-select: none;
      z-index: -1;
      -webkit-mask-image:
        linear-gradient(to right, transparent 0%, black 62%),
        linear-gradient(to top, transparent 0%, black 45%);
      -webkit-mask-composite: source-in;
      mask-image:
        linear-gradient(to right, transparent 0%, black 62%),
        linear-gradient(to top, transparent 0%, black 45%);
      mask-composite: intersect;
    }
    .rl-head h1 {
      position: relative;
      font-family: var(--rl-display);
      font-weight: 500;
      font-style: normal;
      font-size: clamp(2.6rem, 8vw, 5rem);
      line-height: 1;
      letter-spacing: 0.04em;
      color: var(--rl-clay);
      margin: 0;
    }

    .tide {
      margin: 0 calc(-1 * var(--s3)) var(--s4);
      pointer-events: none;
    }

    /* No column rule: the gutter alone separates the index from the plates. */
    .layout {
      display: grid;
      grid-template-columns: 270px minmax(0, 1fr);
      gap: var(--s5);
      align-items: start;
    }

    /* --- footer: meander rule over a quiet colophon line --- */
    .rl-foot { margin-top: var(--s5); }
    .meander {
      height: 14px;
      background-color: var(--rl-clay);
      -webkit-mask: var(--orn-meander) round no-repeat left center / auto 14px;
      mask: var(--orn-meander) round no-repeat left center / auto 14px;
      opacity: 0.8;
    }
    .rl-foot p {
      margin: var(--s2) 0 0;
      font-family: var(--rl-display);
      font-size: 0.72rem;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--rl-ink-2);
      text-align: left;
    }

    @media (max-width: 900px) {
      .layout { grid-template-columns: minmax(0, 1fr); gap: var(--s3); }
    }

    /* Narrow screens: the plate becomes a short banner above the title, so no
       text ever sits on the etched lines and nothing overruns the viewport. */
    @media (max-width: 700px) {
      .rl-page { padding: var(--s3) var(--s2) var(--s5); }
      .rl-head { min-height: 0; }
      .plate {
        position: relative;
        display: block;
        top: auto;
        right: auto;
        width: calc(100% + 2 * var(--s2));
        max-width: none;
        height: 170px;
        margin: var(--s1) calc(-1 * var(--s2)) calc(-1 * var(--s4));
        opacity: 0.32;
        -webkit-mask-image:
          linear-gradient(to right, transparent 0%, black 40%),
          linear-gradient(to top, transparent 0%, black 70%);
        mask-image:
          linear-gradient(to right, transparent 0%, black 40%),
          linear-gradient(to top, transparent 0%, black 70%);
      }
      .tide { margin: 0 calc(-1 * var(--s2)) var(--s3); }
    }
  </style>
</body>
</html>
