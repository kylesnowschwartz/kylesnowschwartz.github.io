---
/**
 * 404 — "Not in the House": the not-found page, dressed in the reading list's
 * red-figure palette (terracotta and bone on black glaze, Cinzel over EB
 * Garamond). Standalone route like the reading list: own <head> and fonts,
 * global.css for the reset, spacing scale and easing tokens.
 *
 * The amphora and kylix are one fixed isometric view exported as static SVG
 * from a figure made with Colorfigures by April Zhu
 * (https://april-zhu.com/colorfigures), which builds on ISO-GLOW by April Zhu
 * and iso-figure by Tolga Cohce. All three are MIT licensed. The plinth is
 * dark stone so the figure sits on the glaze ground instead of glowing on it.
 */
import '../styles/global.css';
import amphora from '../components/not-found/amphora.svg?raw';
---

<!DOCTYPE html>
<html lang="en" class="nf-root">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Not in the House — Kyle Snow Schwartz</title>
  <meta name="robots" content="noindex" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;500;600&family=EB+Garamond:ital,wght@0,400;0,500;0,600;1,400&display=swap"
    rel="stylesheet"
  />
</head>

<body class="nf-body">
  <main class="nf-page">
    <span class="amphora" aria-hidden="true" set:html={amphora} />
    <h1>Not in the House</h1>
    <p class="nf-line">This hall holds no page by that name; the tide may have taken it.</p>
    <nav class="nf-links" aria-label="Ways back">
      <a href="/">Home</a>
      <a href="/reading-list/">The reading list</a>
    </nav>
  </main>

  <style>
    /* The reading list's red-figure palette, declared on this route's root. */
    :global(html.nf-root) {
      --rl-paper: oklch(17% 0.012 45);
      --rl-ink: oklch(90% 0.022 75);
      --rl-ink-2: oklch(72% 0.03 60);
      --rl-clay: oklch(64% 0.14 45);
      --rl-clay-2: oklch(74% 0.12 55);
      --rl-rule: oklch(36% 0.035 45);
      --rl-display: 'Cinzel', 'Trajan Pro', serif;
      --rl-body: 'EB Garamond', 'Garamond', Georgia, serif;
      background: var(--rl-paper);
      color-scheme: dark;
      overflow-x: clip;
    }
    :global(body.nf-body) {
      background: var(--rl-paper);
      color: var(--rl-ink);
      font-family: var(--rl-body);
      font-size: 1.0625rem;
      line-height: 1.55;
      overflow-x: clip;
    }
    /* The site's paper-grain and diagonal-weave layers are tuned for a cream
       ground, so this route switches them off as the reading list does. */
    :global(body.nf-body)::before,
    :global(body.nf-body)::after {
      content: none;
    }
    :global(html.nf-root :focus-visible) {
      outline: 2px solid var(--rl-clay-2);
      outline-offset: 2px;
    }

    .nf-page {
      min-height: 100dvh;
      max-width: 40rem;
      margin: 0 auto;
      padding: var(--s5) var(--s3);
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      text-align: center;
    }
    .amphora {
      display: block;
      width: min(300px, 100%);
      margin-bottom: var(--s4);
      pointer-events: none;
    }
    .amphora :global(svg) {
      display: block;
      width: 100%;
      height: auto;
    }
    h1 {
      font-family: var(--rl-display);
      font-weight: 500;
      font-size: clamp(2rem, 6vw, 3rem);
      line-height: 1.1;
      letter-spacing: 0.04em;
      color: var(--rl-clay);
      margin: 0;
    }
    .nf-line {
      margin: var(--s2) 0 0;
      font-style: italic;
      font-size: 1.1rem;
      color: var(--rl-ink-2);
    }
    .nf-links {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: var(--s1) var(--s4);
      margin-top: var(--s4);
    }
    .nf-links a {
      font-family: var(--rl-display);
      font-size: 0.78rem;
      font-weight: 500;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: var(--rl-ink);
      text-decoration: underline;
      text-decoration-color: var(--rl-rule);
      text-underline-offset: 5px;
      text-decoration-thickness: 1px;
      transition: color 140ms var(--ease-out), text-decoration-color 140ms var(--ease-out);
    }
    .nf-links a:hover {
      color: var(--rl-clay-2);
      text-decoration-color: var(--rl-clay-2);
    }
  </style>
</body>
</html>
