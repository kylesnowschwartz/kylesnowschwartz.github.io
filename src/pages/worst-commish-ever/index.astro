---
// Worst Commish Ever - GeoCities-style fantasy football league site
// Refactored to use Astro's static rendering

import { CONTENT } from '../../data/wce-content.ts';
import {
  LEAGUE_DATA,
  TEAMS,
  CURRENT_YEAR,
  HEROES,
  HERO_POPUPS,
  displayName,
  getLeagueYears,
  getHeroesSorted
} from '../../data/wce-data.ts';

// Pre-compute data at build time
const leagueYears = getLeagueYears();
const sortedHeroes = getHeroesSorted();
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{CONTENT.site.title}</title>
</head>
<body>

  <div class="page-wrapper">

    <!-- HEADER -->
    <header class="site-header">
      <h1 class="logo-title">{CONTENT.site.logoTitle}</h1>
      <p class="tagline">{CONTENT.site.tagline}</p>
      <p class="established">{CONTENT.site.established}</p>

      <div class="hit-counter">
        <span>{CONTENT.site.visitorPrefix}</span><span class="counter-display">000047</span>
      </div>
    </header>

    <!-- NAVIGATION -->
    <nav class="nav-section">
      <ul class="nav-list">
        {CONTENT.nav.map(item => (
          <li><a href={item.href}>{item.label}</a></li>
        ))}
      </ul>
    </nav>

    <!-- MARQUEE ANNOUNCEMENT -->
    <div class="announcement-bar">
      <div class="marquee-track">
        <span class="marquee-content">{CONTENT.marquee}</span>
        <span class="marquee-content">{CONTENT.marquee}</span>
      </div>
    </div>

    <!-- DREAM TEAMS -->
    <section id="dream-teams" class="content-section">
      <h2 class="section-title">{CONTENT.sections.dreamTeams.title}</h2>
      <div class="section-content">
        <p class="section-subtitle">{CONTENT.sections.dreamTeams.subtitle}</p>
        <div class="teams-grid">
          {TEAMS.map(team => (
            <div class="team-card">
              <div class="team-name">{team.name}</div>
              <div class="team-owner">Owner: {displayName(team.manager)}</div>
              <div class="team-record">{CURRENT_YEAR} Record: {team.wins}-{team.losses}</div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- WALL OF FAME & SHAME -->
    <section id="fame-shame" class="content-section fame-shame-section">
      <h2 class="section-title">{CONTENT.sections.fameShame.title}</h2>
      <div class="section-content">
        <p class="section-subtitle">{CONTENT.sections.fameShame.subtitle}</p>
        <table class="fame-shame-table">
          <thead>
            <tr>
              <th>Year</th>
              <th>Champion</th>
              <th>Last Place</th>
            </tr>
          </thead>
          <tbody>
            {leagueYears.map(year => {
              const d = LEAGUE_DATA[year];
              return (
                <tr class={d.missing ? 'missing-year' : ''}>
                  <td class="year-col">{year}</td>
                  <td class="fame-col">{d.champion}</td>
                  <td class="shame-col">{d.lastPlace}</td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </div>
    </section>

    <!-- HEROES -->
    <section id="heroes" class="content-section heroes-section">
      <h2 class="section-title">{CONTENT.sections.heroes.title}</h2>
      <div class="section-content">
        <p class="section-subtitle">{CONTENT.sections.heroes.subtitle}</p>
        <div class="heroes-grid">
          {sortedHeroes.map(([name, data]) => {
            const popup = HERO_POPUPS[name];
            return (
              <div class={`hero-card ${data.retired ? 'retired' : ''}`}>
                {popup ? (
                  <div
                    class="hero-name clickable"
                    data-popup-src={popup.src}
                    data-popup-title={popup.title}
                  >
                    {name}
                  </div>
                ) : (
                  <div class="hero-name">{name}</div>
                )}
                <div class="hero-years">{data.years} ({data.seasons} seasons)</div>
                <div class="hero-teams">
                  {data.teamNames.map(t => (
                    <span>{t}</span>
                  ))}
                </div>
                {data.retired && (
                  <div class="hero-status">~ Gone but not forgotten ~</div>
                )}
              </div>
            );
          })}
        </div>
      </div>
    </section>

    <!-- LEAGUE HISTORY -->
    <section id="history" class="content-section">
      <h2 class="section-title">{CONTENT.sections.history.title}</h2>
      <div class="section-content">
        <p class="section-subtitle">{CONTENT.sections.history.subtitle}</p>
        <div class="timeline">
          {CONTENT.sections.history.timeline.map(item => (
            <div class="timeline-item">
              <div class="timeline-year">{item.year}</div>
              <div class="timeline-event">
                {item.rainbow && item.prefix ? (
                  <><span class="rainbow-text">{item.prefix}</span> {item.event}</>
                ) : (
                  item.event
                )}
              </div>
            </div>
          ))}
        </div>
        <div class="under-construction">
          <div class="construction-gif">&#128218;</div>
          <p class="construction-text">{CONTENT.sections.history.underConstruction}</p>
        </div>
      </div>
    </section>

    <!-- LEAGUE RULES -->
    <section id="rules" class="content-section">
      <h2 class="section-title">{CONTENT.sections.rules.title}</h2>
      <div class="section-content">
        <p class="section-subtitle">{CONTENT.sections.rules.subtitle}</p>
        <ol class="rules-list">
          {CONTENT.sections.rules.rules.map(rule => (
            <li>
              <span class="rule-title">{rule.title}</span>
              {rule.description}
            </li>
          ))}
        </ol>
        <div class="under-construction">
          <div class="construction-gif">&#128220;</div>
          <p class="construction-text">{CONTENT.sections.rules.underConstruction}</p>
        </div>
      </div>
    </section>

    <!-- FOOTER -->
    <footer class="site-footer">
      <div class="footer-badges">
        {CONTENT.footer.badges.map(badge => (
          <span class="badge">{badge}</span>
        ))}
      </div>
      <p class="copyright">
        &copy; {CONTENT.footer.copyright}<br />
        {CONTENT.footer.copyrightNote}
      </p>
      <a href={`mailto:${CONTENT.footer.contactEmail}`} class="email-link">
        {CONTENT.footer.contactText}
      </a>
    </footer>

  </div>

  <!-- Reusable popup container (content injected by JS) -->
  <div class="popup-overlay" id="popup-overlay"></div>

  <!-- Client-side only: Hit counter and popup system -->
  <script>
    // Fake hit counter (client-side only - uses localStorage)
    const counter = document.querySelector('.counter-display');
    if (counter) {
      let visits = parseInt(localStorage.getItem('wce_visits') || '46', 10);
      visits++;
      localStorage.setItem('wce_visits', visits.toString());
      counter.textContent = visits.toString().padStart(6, '0');
    }

    // Generic image popup system
    const overlay = document.getElementById('popup-overlay');

    function openPopup(src: string, title: string) {
      if (!overlay) return;
      overlay.innerHTML = `
        <div class="popup-window">
          <div class="popup-titlebar">
            <span class="popup-title">${title} - Windows Picture Viewer</span>
            <button class="popup-close" title="Close">X</button>
          </div>
          <div class="popup-content">
            <img src="${src}" alt="${title}">
          </div>
        </div>
      `;
      overlay.classList.add('active');
    }

    function closePopup() {
      overlay?.classList.remove('active');
    }

    // Delegate click on any element with data-popup-src
    document.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;
      const trigger = target.closest('[data-popup-src]') as HTMLElement;
      if (trigger) {
        openPopup(
          trigger.dataset.popupSrc || '',
          trigger.dataset.popupTitle || 'Image'
        );
      }
    });

    // Close handlers
    overlay?.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;
      if (e.target === overlay || target.matches('.popup-close')) {
        closePopup();
      }
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && overlay?.classList.contains('active')) {
        closePopup();
      }
    });
  </script>
</body>
</html>

<style>
  /* === GEOCITIES AESTHETIC WITH MODERN CSS === */

  /* Color palette - straight from 1996 */
  :root {
    --bg-black: #000000;
    --text-red: #ff0000;
    --text-yellow: #ffff00;
    --text-lime: #00ff00;
    --text-cyan: #00ffff;
    --text-magenta: #ff00ff;
    --link-salmon: #ff4c4c;
    --gold: #ffd700;
    --silver: #c0c0c0;
    --bronze: #cd7f32;
  }

  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  body {
    background-color: var(--bg-black);
    background-image:
      radial-gradient(white 1px, transparent 1px),
      radial-gradient(white 1px, transparent 1px),
      radial-gradient(rgba(255,255,255,0.5) 1px, transparent 1px);
    background-size: 100px 100px, 50px 50px, 150px 150px;
    background-position: 0 0, 25px 25px, 75px 50px;
    color: var(--text-red);
    font-family: 'Times New Roman', Times, serif;
    font-size: 16px;
    line-height: 1.4;
    min-height: 100vh;
  }

  a {
    color: var(--link-salmon);
    text-decoration: underline;
  }

  a:visited {
    color: var(--link-salmon);
  }

  a:hover {
    color: var(--text-yellow);
  }

  /* === LAYOUT - Tables vibes via CSS === */
  .page-wrapper {
    max-width: 800px;
    margin: 0 auto;
    padding: 20px;
  }

  /* === HEADER === */
  .site-header {
    text-align: center;
    padding: 20px 0 40px;
  }

  .logo-title {
    font-family: 'Impact', 'Arial Black', sans-serif;
    font-size: clamp(2rem, 8vw, 4rem);
    color: var(--text-yellow);
    text-shadow:
      3px 3px 0 var(--text-red),
      6px 6px 0 #660000;
    letter-spacing: 0.05em;
    margin-bottom: 10px;
  }

  .tagline {
    font-size: 1.25rem;
    color: var(--text-lime);
    font-style: italic;
  }

  .established {
    font-size: 0.875rem;
    color: var(--text-cyan);
    margin-top: 10px;
  }

  /* Hit counter */
  .hit-counter {
    margin-top: 20px;
    font-family: 'Courier New', monospace;
    font-size: 0.875rem;
    color: var(--text-yellow);
  }

  .counter-display {
    display: inline-block;
    background: #111;
    border: 2px inset #444;
    padding: 4px 12px;
    font-family: 'Courier New', monospace;
    color: var(--text-lime);
    letter-spacing: 0.2em;
  }

  /* === NAVIGATION === */
  .nav-section {
    text-align: center;
    padding: 20px 0;
    border-top: 2px solid var(--text-magenta);
    border-bottom: 2px solid var(--text-magenta);
    margin-bottom: 30px;
  }

  .nav-list {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 10px 20px;
  }

  .nav-list a {
    display: inline-block;
    padding: 8px 16px;
    background: linear-gradient(180deg, #444 0%, #222 100%);
    border: 2px outset #666;
    color: var(--text-yellow);
    text-decoration: none;
    font-family: 'Arial', sans-serif;
    font-weight: bold;
    font-size: 0.875rem;
    text-transform: uppercase;
  }

  .nav-list a:hover {
    background: linear-gradient(180deg, #555 0%, #333 100%);
    border-style: inset;
    color: var(--text-cyan);
  }

  /* === MARQUEE === */
  .announcement-bar {
    background: var(--text-red);
    color: var(--text-yellow);
    padding: 8px;
    font-weight: bold;
    font-size: 1rem;
    margin-bottom: 30px;
    overflow: hidden;
  }

  .marquee-track {
    display: flex;
    width: max-content;
    animation: marquee 30s linear infinite;
  }

  .marquee-content {
    white-space: nowrap;
    padding-right: 4rem;
  }

  @keyframes marquee {
    0% { transform: translateX(0); }
    100% { transform: translateX(-50%); }
  }

  /* === SECTIONS === */
  .content-section {
    background: rgba(0, 0, 0, 0.7);
    border: 3px ridge var(--text-magenta);
    margin-bottom: 30px;
    padding: 20px;
  }

  .section-title {
    font-family: 'Impact', 'Arial Black', sans-serif;
    font-size: 1.75rem;
    color: var(--text-cyan);
    text-align: center;
    margin-bottom: 20px;
    text-shadow: 2px 2px 0 #006666;
    border-bottom: 2px dashed var(--text-cyan);
    padding-bottom: 10px;
  }

  .section-content {
    color: var(--text-yellow);
  }

  .section-subtitle {
    text-align: center;
    margin-bottom: 20px;
  }

  /* === DREAM TEAMS === */
  .teams-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 15px;
  }

  .team-card {
    background: linear-gradient(180deg, #1a1a2e 0%, #0a0a15 100%);
    border: 2px solid var(--text-magenta);
    padding: 15px;
    text-align: center;
  }

  .team-name {
    font-family: 'Arial Black', sans-serif;
    font-size: 1rem;
    color: var(--text-lime);
    margin-bottom: 5px;
  }

  .team-owner {
    font-size: 0.875rem;
    color: var(--text-cyan);
  }

  .team-record {
    font-size: 0.75rem;
    color: var(--silver);
    margin-top: 5px;
  }

  /* === WALL OF FAME & SHAME === */
  .fame-shame-section {
    border-color: var(--gold);
  }

  .fame-shame-section .section-title {
    color: var(--gold);
    text-shadow: 2px 2px 0 #8B4513;
    border-bottom-color: var(--gold);
  }

  .fame-shame-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.875rem;
  }

  .fame-shame-table th {
    background: linear-gradient(180deg, #333 0%, #111 100%);
    color: var(--silver);
    padding: 10px;
    text-align: left;
    border: 2px solid #444;
    font-size: 1rem;
  }

  .fame-shame-table td {
    padding: 8px 10px;
    border: 1px solid #444;
  }

  .fame-shame-table tr:nth-child(even) {
    background: rgba(255, 255, 255, 0.05);
  }

  .fame-shame-table tr:hover {
    background: rgba(255, 255, 255, 0.1);
  }

  .fame-shame-table tr.missing-year {
    opacity: 0.4;
    font-style: italic;
  }

  .fame-shame-table .year-col {
    color: var(--silver);
    font-family: 'Courier New', monospace;
  }

  .fame-shame-table .fame-col {
    color: var(--text-yellow);
  }

  .fame-shame-table .shame-col {
    color: var(--text-red);
  }

  /* === HEROES === */
  .heroes-section {
    border-color: var(--text-lime);
  }

  .heroes-section .section-title {
    color: var(--text-lime);
    text-shadow: 2px 2px 0 #006600;
    border-bottom-color: var(--text-lime);
  }

  .heroes-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 15px;
  }

  .hero-card {
    background: linear-gradient(180deg, #1a2e1a 0%, #0a150a 100%);
    border: 2px solid var(--text-lime);
    padding: 15px;
  }

  .hero-card.retired {
    opacity: 0.6;
    border-style: dashed;
  }

  .hero-name {
    font-family: 'Arial Black', sans-serif;
    font-size: 1.1rem;
    color: var(--text-lime);
    margin-bottom: 5px;
  }

  .hero-years {
    font-size: 0.75rem;
    color: var(--silver);
    margin-bottom: 8px;
  }

  .hero-teams {
    font-size: 0.8rem;
    color: var(--text-cyan);
    line-height: 1.4;
  }

  .hero-teams span {
    display: inline-block;
    background: rgba(0, 255, 255, 0.1);
    padding: 2px 6px;
    margin: 2px;
    border-radius: 3px;
  }

  .hero-status {
    font-size: 0.7rem;
    color: var(--text-magenta);
    margin-top: 8px;
    font-style: italic;
  }

  /* === LEAGUE HISTORY === */
  .timeline {
    position: relative;
    padding-left: 30px;
  }

  .timeline::before {
    content: '';
    position: absolute;
    left: 10px;
    top: 0;
    bottom: 0;
    width: 2px;
    background: var(--text-magenta);
  }

  .timeline-item {
    position: relative;
    margin-bottom: 20px;
    padding-left: 20px;
  }

  .timeline-item::before {
    content: '';
    position: absolute;
    left: -24px;
    top: 5px;
    width: 12px;
    height: 12px;
    background: var(--text-cyan);
    border-radius: 50%;
    border: 2px solid var(--text-magenta);
  }

  .timeline-year {
    font-family: 'Courier New', monospace;
    font-size: 1rem;
    color: var(--text-lime);
    font-weight: bold;
  }

  .timeline-event {
    color: var(--text-yellow);
    font-size: 0.9375rem;
    margin-top: 5px;
  }

  /* === LEAGUE RULES === */
  .rules-list {
    list-style: none;
    counter-reset: rule-counter;
  }

  .rules-list li {
    counter-increment: rule-counter;
    margin-bottom: 15px;
    padding-left: 40px;
    position: relative;
    color: var(--text-yellow);
  }

  .rules-list li::before {
    content: counter(rule-counter);
    position: absolute;
    left: 0;
    top: 0;
    width: 28px;
    height: 28px;
    background: var(--text-magenta);
    color: var(--bg-black);
    font-weight: bold;
    text-align: center;
    line-height: 28px;
    font-size: 0.875rem;
  }

  .rule-title {
    font-weight: bold;
    color: var(--text-cyan);
    display: block;
    margin-bottom: 5px;
  }

  /* === UNDER CONSTRUCTION === */
  .under-construction {
    text-align: center;
    padding: 40px 20px;
    color: var(--text-yellow);
  }

  .construction-gif {
    font-size: 3rem;
    margin-bottom: 10px;
    animation: blink 1s step-end infinite;
  }

  @keyframes blink {
    50% { opacity: 0; }
  }

  .construction-text {
    font-family: 'Comic Sans MS', 'Arial', sans-serif;
    font-size: 1.25rem;
    color: var(--text-yellow);
  }

  /* === FOOTER === */
  .site-footer {
    text-align: center;
    padding: 30px 20px;
    border-top: 2px solid var(--text-magenta);
    margin-top: 30px;
  }

  .footer-badges {
    margin-bottom: 20px;
  }

  .badge {
    display: inline-block;
    background: #111;
    border: 2px outset #444;
    padding: 5px 10px;
    margin: 5px;
    font-size: 0.75rem;
    color: var(--silver);
  }

  .copyright {
    font-size: 0.75rem;
    color: var(--text-yellow);
  }

  .email-link {
    display: block;
    margin-top: 10px;
    font-size: 0.875rem;
  }

  /* === RESPONSIVE === */
  @media (max-width: 600px) {
    .page-wrapper {
      padding: 10px;
    }

    .content-section {
      padding: 15px;
    }

    .nav-list {
      flex-direction: column;
      align-items: center;
    }

    .teams-grid {
      grid-template-columns: 1fr;
    }

    .champions-table {
      font-size: 0.75rem;
    }

    .champions-table th,
    .champions-table td {
      padding: 6px;
    }
  }

  /* === 90s POPUP MODAL === */
  .popup-overlay {
    display: none;
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: rgba(0, 0, 0, 0.8);
    z-index: 9999;
    justify-content: center;
    align-items: center;
  }

  .popup-overlay.active {
    display: flex;
    animation: fadeIn 0.2s ease-out;
  }

  @keyframes fadeIn {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  /* Clickable hero name */
  .hero-name.clickable {
    cursor: pointer;
    text-decoration: underline;
    text-decoration-style: dashed;
  }

  .hero-name.clickable:hover {
    color: var(--text-yellow);
    text-shadow: 0 0 8px var(--text-lime);
  }

  /* === SPECIAL EFFECTS === */
  .rainbow-text {
    background: linear-gradient(90deg,
      var(--text-red),
      var(--text-yellow),
      var(--text-lime),
      var(--text-cyan),
      var(--text-magenta)
    );
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    animation: rainbow-shift 3s linear infinite;
    background-size: 200% auto;
  }

  @keyframes rainbow-shift {
    0% { background-position: 0% center; }
    100% { background-position: 200% center; }
  }

  /* Starfield fallback if image doesn't load */
  @supports not (background-image: url('/worst-commish-ever/images/stars.gif')) {
    body {
      background: radial-gradient(white 1px, transparent 1px),
                  radial-gradient(white 1px, transparent 1px);
      background-size: 50px 50px;
      background-position: 0 0, 25px 25px;
      background-color: var(--bg-black);
    }
  }
</style>

<style is:global>
  /* Global styles for dynamically created popup content */
  .popup-window {
    background: linear-gradient(180deg, #c0c0c0 0%, #808080 100%);
    border: 4px outset #c0c0c0;
    box-shadow:
      inset 2px 2px 0 #fff,
      inset -2px -2px 0 #404040,
      8px 8px 0 rgba(0, 0, 0, 0.5);
    max-width: 90vw;
    max-height: 90vh;
    animation: dropIn 0.3s linear;
  }

  @keyframes dropIn {
    0% {
      transform: translateY(-100vh);
    }
    100% {
      transform: translateY(0);
    }
  }

  .popup-titlebar {
    background: linear-gradient(90deg, #000080 0%, #1084d0 100%);
    padding: 4px 8px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    cursor: default;
  }

  .popup-title {
    color: #fff;
    font-family: 'Arial', sans-serif;
