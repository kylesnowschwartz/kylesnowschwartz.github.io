---
/**
 * Worst Commish Ever - GeoCities-style fantasy football league site
 * Refactored to use Astro component patterns
 */

// Content and data
import { CONTENT } from '../../data/wce-content.ts';
import {
  LEAGUE_DATA,
  TEAMS,
  CURRENT_YEAR,
  HERO_POPUPS,
  displayName,
  getLeagueYears,
  getHeroesSorted
} from '../../data/wce-data.ts';

// Components
import Navigation from '../../components/wce/Navigation.astro';
import Section from '../../components/wce/Section.astro';
import TeamCard from '../../components/wce/TeamCard.astro';
import FameShameTable from '../../components/wce/FameShameTable.astro';
import HeroCard from '../../components/wce/HeroCard.astro';
import TimelineItem from '../../components/wce/TimelineItem.astro';
import UnderConstruction from '../../components/wce/UnderConstruction.astro';

// Pre-compute data at build time
const leagueYears = getLeagueYears();
const sortedHeroes = getHeroesSorted();
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{CONTENT.site.title}</title>
</head>
<body>

  <div class="page-wrapper">

    <!-- HEADER -->
    <header class="site-header">
      <h1 class="logo-title">{CONTENT.site.logoTitle}</h1>
      <p class="tagline">{CONTENT.site.tagline}</p>
      <p class="established">{CONTENT.site.established}</p>
      <div class="hit-counter">
        <span>{CONTENT.site.visitorPrefix}</span><span class="counter-display">000067</span>
      </div>
    </header>

    <!-- NAVIGATION -->
    <Navigation items={CONTENT.nav} />

    <!-- MARQUEE -->
    <div class="announcement-bar">
      <div class="marquee-track">
        <span class="marquee-content">{CONTENT.marquee}</span>
        <span class="marquee-content">{CONTENT.marquee}</span>
      </div>
    </div>

    <!-- DREAM TEAMS -->
    <Section id="dream-teams" title={CONTENT.sections.dreamTeams.title} subtitle={CONTENT.sections.dreamTeams.subtitle}>
      <div class="teams-grid">
        {TEAMS.map(team => (
          <TeamCard
            name={team.name}
            manager={displayName(team.manager)}
            wins={team.wins}
            losses={team.losses}
            year={CURRENT_YEAR}
          />
        ))}
      </div>
    </Section>

    <!-- WALL OF FAME & SHAME -->
    <Section id="fame-shame" title={CONTENT.sections.fameShame.title} subtitle={CONTENT.sections.fameShame.subtitle} variant="gold">
      <FameShameTable years={leagueYears} data={LEAGUE_DATA} />
    </Section>

    <!-- HEROES -->
    <Section id="heroes" title={CONTENT.sections.heroes.title} subtitle={CONTENT.sections.heroes.subtitle} variant="lime">
      <div class="heroes-grid">
        {sortedHeroes.map(([name, data]) => (
          <HeroCard
            name={name}
            years={data.years}
            seasons={data.seasons}
            teamNames={data.teamNames}
            retired={data.retired}
            popup={HERO_POPUPS[name]}
          />
        ))}
      </div>
    </Section>

    <!-- LEAGUE HISTORY -->
    <Section id="history" title={CONTENT.sections.history.title} subtitle={CONTENT.sections.history.subtitle}>
      <div class="timeline">
        {CONTENT.sections.history.timeline.map(item => (
          <TimelineItem
            year={item.year}
            event={item.event}
            rainbow={item.rainbow}
            prefix={item.prefix}
          />
        ))}
      </div>
      <UnderConstruction emoji="📚">
        {CONTENT.sections.history.underConstruction}
      </UnderConstruction>
    </Section>

    <!-- LEAGUE RULES -->
    <Section id="rules" title={CONTENT.sections.rules.title} subtitle={CONTENT.sections.rules.subtitle}>
      <ol class="rules-list">
        {CONTENT.sections.rules.rules.map(rule => (
          <li>
            <span class="rule-title">{rule.title}</span>
            {rule.description}
          </li>
        ))}
      </ol>
      <UnderConstruction emoji="📜">
        {CONTENT.sections.rules.underConstruction}
      </UnderConstruction>
    </Section>

    <!-- FOOTER -->
    <footer class="site-footer">
      <div class="footer-badges">
        {CONTENT.footer.badges.map(badge => (
          <span class="badge">{badge}</span>
        ))}
      </div>
      <p class="copyright">
        &copy; {CONTENT.footer.copyright}<br />
        {CONTENT.footer.copyrightNote}
      </p>
      <a href={`mailto:${CONTENT.footer.contactEmail}`} class="email-link">
        {CONTENT.footer.contactText}
      </a>
    </footer>

  </div>

  <!-- Popup container (content injected by JS) -->
  <div class="popup-overlay" id="popup-overlay"></div>

  <!-- Client-side: Hit counter and popup system -->
  <script>
    // Hit counter (localStorage)
    const counter = document.querySelector('.counter-display');
    if (counter) {
      let visits = parseInt(localStorage.getItem('wce_visits') || '46', 10);
      visits++;
      localStorage.setItem('wce_visits', visits.toString());
      counter.textContent = visits.toString().padStart(6, '0');
    }

    // Popup system
    const overlay = document.getElementById('popup-overlay');

    function openPopup(src: string, title: string) {
      if (!overlay) return;
      overlay.innerHTML = `
        <div class="popup-window">
          <div class="popup-titlebar">
            <span class="popup-title">${title} - Windows Picture Viewer</span>
            <button class="popup-close" title="Close">X</button>
          </div>
          <div class="popup-content">
            <img src="${src}" alt="${title}">
          </div>
        </div>
      `;
      overlay.classList.add('active');
    }

    function closePopup() {
      overlay?.classList.remove('active');
    }

    document.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;
      const trigger = target.closest('[data-popup-src]') as HTMLElement;
      if (trigger) {
        openPopup(
          trigger.dataset.popupSrc || '',
          trigger.dataset.popupTitle || 'Image'
        );
      }
    });

    overlay?.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;
      if (e.target === overlay || target.matches('.popup-close')) {
        closePopup();
      }
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && overlay?.classList.contains('active')) {
        closePopup();
      }
    });
  </script>
</body>
</html>

<style>
  /* Page-level styles - components handle their own styling */
  @import '../../styles/wce-theme.css';

  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  body {
    background-color: var(--wce-bg-black);
    background-image:
      radial-gradient(white 1px, transparent 1px),
      radial-gradient(white 1px, transparent 1px),
      radial-gradient(rgba(255,255,255,0.5) 1px, transparent 1px);
    background-size: 100px 100px, 50px 50px, 150px 150px;
    background-position: 0 0, 25px 25px, 75px 50px;
    color: var(--wce-text-red);
    font-family: var(--wce-font-body);
    font-size: 16px;
    line-height: 1.4;
    min-height: 100vh;
  }

  a {
    color: var(--wce-link-salmon);
    text-decoration: underline;
  }
  a:visited { color: var(--wce-link-salmon); }
  a:hover { color: var(--wce-text-yellow); }

  .page-wrapper {
    max-width: 800px;
    margin: 0 auto;
    padding: var(--wce-space-lg);
  }

  /* === HEADER === */
  .site-header {
    text-align: center;
    padding: var(--wce-space-lg) 0 var(--wce-space-2xl);
  }

  .logo-title {
    font-family: var(--wce-font-display);
    font-size: clamp(2rem, 8vw, 4rem);
    color: var(--wce-text-yellow);
    text-shadow: 3px 3px 0 var(--wce-text-red), 6px 6px 0 var(--wce-shadow-red);
    letter-spacing: 0.05em;
    margin-bottom: var(--wce-space-sm);
  }

  .tagline {
    font-size: 1.25rem;
    color: var(--wce-text-lime);
    font-style: italic;
  }

  .established {
    font-size: 0.875rem;
    color: var(--wce-text-cyan);
    margin-top: var(--wce-space-sm);
  }

  .hit-counter {
    margin-top: var(--wce-space-lg);
    font-family: var(--wce-font-mono);
    font-size: 0.875rem;
    color: var(--wce-text-yellow);
  }

  .counter-display {
    display: inline-block;
    background: var(--wce-gray-900);
    border: 2px inset var(--wce-gray-500);
    padding: 4px 12px;
    color: var(--wce-text-lime);
    letter-spacing: 0.2em;
  }

  /* === MARQUEE === */
  .announcement-bar {
    background: var(--wce-text-red);
    color: var(--wce-text-yellow);
    padding: 8px;
    font-weight: bold;
    margin-bottom: var(--wce-space-xl);
    overflow: hidden;
  }

  .marquee-track {
    display: flex;
    width: max-content;
    animation: marquee 30s linear infinite;
  }

  .marquee-content {
    white-space: nowrap;
    padding-right: 4rem;
  }

  @keyframes marquee {
    0% { transform: translateX(0); }
    100% { transform: translateX(-50%); }
  }

  /* === GRID LAYOUTS === */
  .teams-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: var(--wce-space-md);
  }

  .heroes-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: var(--wce-space-md);
  }

  /* === TIMELINE === */
  .timeline {
    position: relative;
    padding-left: var(--wce-space-xl);
  }

  .timeline::before {
    content: '';
    position: absolute;
    left: var(--wce-space-sm);
    top: 0;
    bottom: 0;
    width: 2px;
    background: var(--wce-text-magenta);
  }

  /* === RULES LIST === */
  .rules-list {
    list-style: none;
    counter-reset: rule-counter;
  }

  .rules-list li {
    counter-increment: rule-counter;
    margin-bottom: var(--wce-space-md);
    padding-left: var(--wce-space-2xl);
    position: relative;
    color: var(--wce-text-yellow);
  }

  .rules-list li::before {
    content: counter(rule-counter);
    position: absolute;
    left: 0;
    top: 0;
    width: 28px;
    height: 28px;
    background: var(--wce-text-magenta);
    color: var(--wce-bg-black);
    font-weight: bold;
    text-align: center;
    line-height: 28px;
    font-size: 0.875rem;
  }

  .rule-title {
    font-weight: bold;
    color: var(--wce-text-cyan);
    display: block;
    margin-bottom: var(--wce-space-xs);
  }

  /* === FOOTER === */
  .site-footer {
    text-align: center;
    padding: var(--wce-space-xl) var(--wce-space-lg);
    border-top: var(--wce-border-width) solid var(--wce-text-magenta);
    margin-top: var(--wce-space-xl);
  }

  .footer-badges { margin-bottom: var(--wce-space-lg); }

  .badge {
    display: inline-block;
    background: var(--wce-gray-900);
    border: 2px outset var(--wce-gray-500);
    padding: var(--wce-space-xs) var(--wce-space-sm);
    margin: var(--wce-space-xs);
    font-size: 0.75rem;
    color: var(--wce-silver);
  }

  .copyright {
    font-size: 0.75rem;
    color: var(--wce-text-yellow);
  }

  .email-link {
    display: block;
    margin-top: var(--wce-space-sm);
    font-size: 0.875rem;
  }

  /* === POPUP === */
  .popup-overlay {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.8);
    z-index: 9999;
    justify-content: center;
    align-items: center;
  }

  .popup-overlay.active {
    display: flex;
    animation: fadeIn 0.2s ease-out;
  }

  @keyframes fadeIn {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  /* === RESPONSIVE === */
  @media (max-width: 600px) {
    .page-wrapper { padding: var(--wce-space-sm); }
    .teams-grid { grid-template-columns: 1fr; }
  }
</style>

<style is:global>
  /* Global: dynamically created popup content */
  .popup-window {
    background: linear-gradient(180deg, var(--wce-win95-button-face) 0%, var(--wce-win95-button-shadow) 100%);
    border: var(--wce-border-win95) outset var(--wce-win95-button-face);
    box-shadow:
      inset 2px 2px 0 var(--wce-win95-button-highlight),
      inset -2px -2px 0 var(--wce-win95-button-dark-shadow),
      8px 8px 0 rgba(0, 0, 0, 0.5);
    max-width: 90vw;
    max-height: 90vh;
    animation: dropIn 0.3s linear;
  }

  @keyframes dropIn {
    0% { transform: translateY(-100vh); }
    100% { transform: translateY(0); }
  }

  .popup-titlebar {
    background: linear-gradient(90deg, var(--wce-win95-titlebar-dark) 0%, var(--wce-win95-titlebar-light) 100%);
    padding: 4px 8px;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .popup-title {
    color: #fff;
    font-family: var(--wce-font-ui);
    font-weight: bold;
    font-size: 0.875rem;
    text-shadow: 1px 1px 0 #000;
  }

  .popup-close {
    background: linear-gradient(180deg, var(--wce-win95-button-face) 0%, var(--wce-win95-button-shadow) 100%);
    border: 2px outset var(--wce-win95-button-face);
    color: #000;
    font-family: var(--wce-font-ui);
    font-weight: bold;
    font-size: 0.75rem;
    width: 20px;
    height: 20px;
    line-height: 14px;
    text-align: center;
    cursor: pointer;
    padding: 0;
  }

  .popup-close:hover {
    background: linear-gradient(180deg, var(--wce-gray-50) 0%, var(--wce-gray-200) 100%);
  }

  .popup-close:active {
    border-style: inset;
  }

  .popup-content {
    padding: 8px;
    background: #000;
    border: 2px inset var(--wce-win95-button-shadow);
    margin: 8px;
  }

  .popup-content img {
    display: block;
    max-width: min(80vw, 600px);
    max-height: 70vh;
    width: auto;
    height: auto;
  }

  @media (max-width: 600px) {
    .popup-content img {
      max-width: 85vw;
      max-height: 60vh;
    }
  }
</style>
