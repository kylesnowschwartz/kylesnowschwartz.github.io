---
// Worst Commish Ever - GeoCities-style fantasy football league site
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>WORST COMMISH EVER</title>
  <style>
    /* === GEOCITIES AESTHETIC WITH MODERN CSS === */

    /* Color palette - straight from 1996 */
    :root {
      --bg-black: #000000;
      --text-red: #ff0000;
      --text-yellow: #ffff00;
      --text-lime: #00ff00;
      --text-cyan: #00ffff;
      --text-magenta: #ff00ff;
      --link-salmon: #ff4c4c;
      --gold: #ffd700;
      --silver: #c0c0c0;
      --bronze: #cd7f32;
    }

    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      background-color: var(--bg-black);
      background-image:
        radial-gradient(white 1px, transparent 1px),
        radial-gradient(white 1px, transparent 1px),
        radial-gradient(rgba(255,255,255,0.5) 1px, transparent 1px);
      background-size: 100px 100px, 50px 50px, 150px 150px;
      background-position: 0 0, 25px 25px, 75px 50px;
      color: var(--text-red);
      font-family: 'Times New Roman', Times, serif;
      font-size: 16px;
      line-height: 1.4;
      min-height: 100vh;
    }

    a {
      color: var(--link-salmon);
      text-decoration: underline;
    }

    a:visited {
      color: var(--link-salmon);
    }

    a:hover {
      color: var(--text-yellow);
    }

    /* === LAYOUT - Tables vibes via CSS === */
    .page-wrapper {
      max-width: 800px;
      margin: 0 auto;
      padding: 20px;
    }

    /* === HEADER === */
    .site-header {
      text-align: center;
      padding: 20px 0 40px;
    }

    .logo-title {
      font-family: 'Impact', 'Arial Black', sans-serif;
      font-size: clamp(2rem, 8vw, 4rem);
      color: var(--text-yellow);
      text-shadow:
        3px 3px 0 var(--text-red),
        6px 6px 0 #660000;
      letter-spacing: 0.05em;
      margin-bottom: 10px;
    }

    .tagline {
      font-size: 1.25rem;
      color: var(--text-lime);
      font-style: italic;
    }

    .established {
      font-size: 0.875rem;
      color: var(--text-cyan);
      margin-top: 10px;
    }

    /* Hit counter */
    .hit-counter {
      margin-top: 20px;
      font-family: 'Courier New', monospace;
      font-size: 0.875rem;
      color: var(--text-yellow);
    }

    .counter-display {
      display: inline-block;
      background: #111;
      border: 2px inset #444;
      padding: 4px 12px;
      font-family: 'Courier New', monospace;
      color: var(--text-lime);
      letter-spacing: 0.2em;
    }

    /* === NAVIGATION === */
    .nav-section {
      text-align: center;
      padding: 20px 0;
      border-top: 2px solid var(--text-magenta);
      border-bottom: 2px solid var(--text-magenta);
      margin-bottom: 30px;
    }

    .nav-list {
      list-style: none;
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: 10px 20px;
    }

    .nav-list a {
      display: inline-block;
      padding: 8px 16px;
      background: linear-gradient(180deg, #444 0%, #222 100%);
      border: 2px outset #666;
      color: var(--text-yellow);
      text-decoration: none;
      font-family: 'Arial', sans-serif;
      font-weight: bold;
      font-size: 0.875rem;
      text-transform: uppercase;
    }

    .nav-list a:hover {
      background: linear-gradient(180deg, #555 0%, #333 100%);
      border-style: inset;
      color: var(--text-cyan);
    }

    /* === MARQUEE === */
    .announcement-bar {
      background: var(--text-red);
      color: var(--text-yellow);
      padding: 8px;
      font-weight: bold;
      font-size: 1rem;
      margin-bottom: 30px;
      overflow: hidden;
    }

    .marquee-track {
      display: flex;
      width: max-content;
      animation: marquee 30s linear infinite;
    }

    .marquee-content {
      white-space: nowrap;
      padding-right: 4rem;
    }

    @keyframes marquee {
      0% { transform: translateX(0); }
      100% { transform: translateX(-50%); }
    }

    /* === SECTIONS === */
    .content-section {
      background: rgba(0, 0, 0, 0.7);
      border: 3px ridge var(--text-magenta);
      margin-bottom: 30px;
      padding: 20px;
    }

    .section-title {
      font-family: 'Impact', 'Arial Black', sans-serif;
      font-size: 1.75rem;
      color: var(--text-cyan);
      text-align: center;
      margin-bottom: 20px;
      text-shadow: 2px 2px 0 #006666;
      border-bottom: 2px dashed var(--text-cyan);
      padding-bottom: 10px;
    }

    .section-content {
      color: var(--text-yellow);
    }

    /* === DREAM TEAMS === */
    .teams-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
      gap: 15px;
    }

    .team-card {
      background: linear-gradient(180deg, #1a1a2e 0%, #0a0a15 100%);
      border: 2px solid var(--text-magenta);
      padding: 15px;
      text-align: center;
    }

    .team-name {
      font-family: 'Arial Black', sans-serif;
      font-size: 1rem;
      color: var(--text-lime);
      margin-bottom: 5px;
    }

    .team-owner {
      font-size: 0.875rem;
      color: var(--text-cyan);
    }

    .team-record {
      font-size: 0.75rem;
      color: var(--silver);
      margin-top: 5px;
    }

    /* === WALL OF FAME & SHAME === */
    .fame-shame-section {
      border-color: var(--gold);
    }

    .fame-shame-section .section-title {
      color: var(--gold);
      text-shadow: 2px 2px 0 #8B4513;
      border-bottom-color: var(--gold);
    }

    .fame-shame-table {
      width: 100%;
      border-collapse: collapse;
      font-size: 0.875rem;
    }

    .fame-shame-table th {
      background: linear-gradient(180deg, #333 0%, #111 100%);
      color: var(--silver);
      padding: 10px;
      text-align: left;
      border: 2px solid #444;
      font-size: 1rem;
    }

    .fame-shame-table td {
      padding: 8px 10px;
      border: 1px solid #444;
    }

    .fame-shame-table tr:nth-child(even) {
      background: rgba(255, 255, 255, 0.05);
    }

    .fame-shame-table tr:hover {
      background: rgba(255, 255, 255, 0.1);
    }

    .fame-shame-table .year-col {
      color: var(--silver);
      font-family: 'Courier New', monospace;
    }

    .fame-shame-table .fame-col {
      color: var(--text-yellow);
    }

    .fame-shame-table .shame-col {
      color: var(--text-red);
    }

    /* === HEROES === */
    .heroes-section {
      border-color: var(--text-lime);
    }

    .heroes-section .section-title {
      color: var(--text-lime);
      text-shadow: 2px 2px 0 #006600;
      border-bottom-color: var(--text-lime);
    }

    .heroes-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
      gap: 15px;
    }

    .hero-card {
      background: linear-gradient(180deg, #1a2e1a 0%, #0a150a 100%);
      border: 2px solid var(--text-lime);
      padding: 15px;
    }

    .hero-card.retired {
      opacity: 0.6;
      border-style: dashed;
    }

    .hero-name {
      font-family: 'Arial Black', sans-serif;
      font-size: 1.1rem;
      color: var(--text-lime);
      margin-bottom: 5px;
    }

    .hero-years {
      font-size: 0.75rem;
      color: var(--silver);
      margin-bottom: 8px;
    }

    .hero-teams {
      font-size: 0.8rem;
      color: var(--text-cyan);
      line-height: 1.4;
    }

    .hero-teams span {
      display: inline-block;
      background: rgba(0, 255, 255, 0.1);
      padding: 2px 6px;
      margin: 2px;
      border-radius: 3px;
    }

    .hero-status {
      font-size: 0.7rem;
      color: var(--text-magenta);
      margin-top: 8px;
      font-style: italic;
    }

    /* === LEAGUE HISTORY === */
    .timeline {
      position: relative;
      padding-left: 30px;
    }

    .timeline::before {
      content: '';
      position: absolute;
      left: 10px;
      top: 0;
      bottom: 0;
      width: 2px;
      background: var(--text-magenta);
    }

    .timeline-item {
      position: relative;
      margin-bottom: 20px;
      padding-left: 20px;
    }

    .timeline-item::before {
      content: '';
      position: absolute;
      left: -24px;
      top: 5px;
      width: 12px;
      height: 12px;
      background: var(--text-cyan);
      border-radius: 50%;
      border: 2px solid var(--text-magenta);
    }

    .timeline-year {
      font-family: 'Courier New', monospace;
      font-size: 1rem;
      color: var(--text-lime);
      font-weight: bold;
    }

    .timeline-event {
      color: var(--text-yellow);
      font-size: 0.9375rem;
      margin-top: 5px;
    }

    /* === LEAGUE RULES === */
    .rules-list {
      list-style: none;
      counter-reset: rule-counter;
    }

    .rules-list li {
      counter-increment: rule-counter;
      margin-bottom: 15px;
      padding-left: 40px;
      position: relative;
      color: var(--text-yellow);
    }

    .rules-list li::before {
      content: counter(rule-counter);
      position: absolute;
      left: 0;
      top: 0;
      width: 28px;
      height: 28px;
      background: var(--text-magenta);
      color: var(--bg-black);
      font-weight: bold;
      text-align: center;
      line-height: 28px;
      font-size: 0.875rem;
    }

    .rule-title {
      font-weight: bold;
      color: var(--text-cyan);
      display: block;
      margin-bottom: 5px;
    }

    /* === UNDER CONSTRUCTION === */
    .under-construction {
      text-align: center;
      padding: 40px 20px;
      color: var(--text-yellow);
    }

    .construction-gif {
      font-size: 3rem;
      margin-bottom: 10px;
      animation: blink 1s step-end infinite;
    }

    @keyframes blink {
      50% { opacity: 0; }
    }

    .construction-text {
      font-family: 'Comic Sans MS', 'Arial', sans-serif;
      font-size: 1.25rem;
      color: var(--text-yellow);
    }

    /* === FOOTER === */
    .site-footer {
      text-align: center;
      padding: 30px 20px;
      border-top: 2px solid var(--text-magenta);
      margin-top: 30px;
    }

    .footer-badges {
      margin-bottom: 20px;
    }

    .badge {
      display: inline-block;
      background: #111;
      border: 2px outset #444;
      padding: 5px 10px;
      margin: 5px;
      font-size: 0.75rem;
      color: var(--silver);
    }

    .copyright {
      font-size: 0.75rem;
      color: var(--text-yellow);
    }

    .email-link {
      display: block;
      margin-top: 10px;
      font-size: 0.875rem;
    }

    /* === RESPONSIVE === */
    @media (max-width: 600px) {
      .page-wrapper {
        padding: 10px;
      }

      .content-section {
        padding: 15px;
      }

      .nav-list {
        flex-direction: column;
        align-items: center;
      }

      .teams-grid {
        grid-template-columns: 1fr;
      }

      .champions-table {
        font-size: 0.75rem;
      }

      .champions-table th,
      .champions-table td {
        padding: 6px;
      }
    }

    /* === 90s POPUP MODAL === */
    .popup-overlay {
      display: none;
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      bottom: 0;
      background: rgba(0, 0, 0, 0.8);
      z-index: 9999;
      justify-content: center;
      align-items: center;
    }

    .popup-overlay.active {
      display: flex;
      animation: fadeIn 0.2s ease-out;
    }

    @keyframes fadeIn {
      from { opacity: 0; }
      to { opacity: 1; }
    }

    .popup-window {
      background: linear-gradient(180deg, #c0c0c0 0%, #808080 100%);
      border: 4px outset #c0c0c0;
      box-shadow:
        inset 2px 2px 0 #fff,
        inset -2px -2px 0 #404040,
        8px 8px 0 rgba(0, 0, 0, 0.5);
      max-width: 90vw;
      max-height: 90vh;
      animation: dropIn 0.3s linear;
    }

    @keyframes dropIn {
      0% {
        transform: translateY(-100vh);
      }
      100% {
        transform: translateY(0);
      }
    }

    .popup-titlebar {
      background: linear-gradient(90deg, #000080 0%, #1084d0 100%);
      padding: 4px 8px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      cursor: default;
    }

    .popup-title {
      color: #fff;
      font-family: 'Arial', sans-serif;
      font-weight: bold;
      font-size: 0.875rem;
      text-shadow: 1px 1px 0 #000;
    }

    .popup-close {
      background: linear-gradient(180deg, #c0c0c0 0%, #808080 100%);
      border: 2px outset #c0c0c0;
      color: #000;
      font-family: 'Arial', sans-serif;
      font-weight: bold;
      font-size: 0.75rem;
      width: 20px;
      height: 20px;
      line-height: 14px;
      text-align: center;
      cursor: pointer;
      padding: 0;
    }

    .popup-close:hover {
      background: linear-gradient(180deg, #d0d0d0 0%, #909090 100%);
    }

    .popup-close:active {
      border-style: inset;
    }

    .popup-content {
      padding: 8px;
      background: #000;
      border: 2px inset #808080;
      margin: 8px;
    }

    .popup-content img {
      display: block;
      max-width: min(80vw, 600px);
      max-height: 70vh;
      width: auto;
      height: auto;
      image-rendering: auto;
    }

    @media (max-width: 600px) {
      .popup-content img {
        max-width: 85vw;
        max-height: 60vh;
      }
    }

    /* Clickable hero name */
    .hero-name.clickable {
      cursor: pointer;
      text-decoration: underline;
      text-decoration-style: dashed;
    }

    .hero-name.clickable:hover {
      color: var(--text-yellow);
      text-shadow: 0 0 8px var(--text-lime);
    }

    /* === SPECIAL EFFECTS === */
    .rainbow-text {
      background: linear-gradient(90deg,
        var(--text-red),
        var(--text-yellow),
        var(--text-lime),
        var(--text-cyan),
        var(--text-magenta)
      );
      -webkit-background-clip: text;
      background-clip: text;
      -webkit-text-fill-color: transparent;
      animation: rainbow-shift 3s linear infinite;
      background-size: 200% auto;
    }

    @keyframes rainbow-shift {
      0% { background-position: 0% center; }
      100% { background-position: 200% center; }
    }

    /* Starfield fallback if image doesn't load */
    @supports not (background-image: url('/worst-commish-ever/images/stars.gif')) {
      body {
        background: radial-gradient(white 1px, transparent 1px),
                    radial-gradient(white 1px, transparent 1px);
        background-size: 50px 50px;
        background-position: 0 0, 25px 25px;
        background-color: var(--bg-black);
      }
    }
  </style>
</head>
<body>

  <div class="page-wrapper">

    <!-- HEADER -->
    <header class="site-header">
      <h1 class="logo-title" id="logo-title"></h1>
      <p class="tagline" id="tagline"></p>
      <p class="established" id="established"></p>

      <div class="hit-counter">
        <span id="visitor-prefix"></span><span class="counter-display">000047</span>
      </div>
    </header>

    <!-- NAVIGATION -->
    <nav class="nav-section">
      <ul class="nav-list" id="nav-list"></ul>
    </nav>

    <!-- MARQUEE ANNOUNCEMENT -->
    <div class="announcement-bar">
      <div class="marquee-track" id="marquee-track">
        <span class="marquee-content"></span>
        <span class="marquee-content"></span>
      </div>
    </div>

    <!-- DREAM TEAMS -->
    <section id="dream-teams" class="content-section">
      <h2 class="section-title" id="dream-teams-title"></h2>
      <div class="section-content">
        <p style="text-align: center; margin-bottom: 20px;" id="dream-teams-subtitle"></p>
        <div class="teams-grid" id="teams-grid"></div>
      </div>
    </section>

    <!-- WALL OF FAME & SHAME -->
    <section id="fame-shame" class="content-section fame-shame-section">
      <h2 class="section-title" id="fame-shame-title"></h2>
      <div class="section-content">
        <p style="text-align: center; margin-bottom: 20px;" id="fame-shame-subtitle"></p>
        <table class="fame-shame-table">
          <thead id="fame-shame-thead"></thead>
          <tbody id="fame-shame-tbody"></tbody>
        </table>
      </div>
    </section>

    <!-- HEROES -->
    <section id="heroes" class="content-section heroes-section">
      <h2 class="section-title" id="heroes-title"></h2>
      <div class="section-content">
        <p style="text-align: center; margin-bottom: 20px;" id="heroes-subtitle"></p>
        <div class="heroes-grid" id="heroes-grid"></div>
      </div>
    </section>

    <!-- LEAGUE HISTORY -->
    <section id="history" class="content-section">
      <h2 class="section-title" id="history-title"></h2>
      <div class="section-content">
        <p style="text-align: center; margin-bottom: 20px;" id="history-subtitle"></p>
        <div class="timeline" id="timeline"></div>
        <div class="under-construction">
          <div class="construction-gif">&#128218;</div>
          <p class="construction-text" id="history-under-construction"></p>
        </div>
      </div>
    </section>

    <!-- LEAGUE RULES -->
    <section id="rules" class="content-section">
      <h2 class="section-title" id="rules-title"></h2>
      <div class="section-content">
        <p style="text-align: center; margin-bottom: 20px;" id="rules-subtitle"></p>
        <ol class="rules-list" id="rules-list"></ol>
        <div class="under-construction">
          <div class="construction-gif">&#128220;</div>
          <p class="construction-text" id="rules-under-construction"></p>
        </div>
      </div>
    </section>

    <!-- FOOTER -->
    <footer class="site-footer">
      <div class="footer-badges" id="footer-badges"></div>
      <p class="copyright" id="footer-copyright"></p>
      <a href="" class="email-link" id="footer-contact"></a>
    </footer>

  </div>

  <!-- Reusable popup container (content injected by JS) -->
  <div class="popup-overlay" id="popup-overlay"></div>

  <!-- Content CMS -->
  <script is:inline src="/worst-commish-ever/content.js"></script>
  <script is:inline src="/worst-commish-ever/data.js"></script>
  <script is:inline>
    // === RENDER SITE FROM CONTENT ===

    // Helper to set text content by ID
    const setText = (id, text) => {
      const el = document.getElementById(id);
      if (el) el.textContent = text;
    };

    // Helper to set innerHTML by ID
    const setHTML = (id, html) => {
      const el = document.getElementById(id);
      if (el) el.innerHTML = html;
    };

    // Site header
    document.title = CONTENT.site.title;
    setText('logo-title', CONTENT.site.logoTitle);
    setText('tagline', CONTENT.site.tagline);
    setText('established', CONTENT.site.established);
    setText('visitor-prefix', CONTENT.site.visitorPrefix);

    // Navigation
    setHTML('nav-list', CONTENT.nav.map(item =>
      `<li><a href="${item.href}">${item.label}</a></li>`
    ).join(''));

    // Marquee (duplicate for seamless loop)
    document.querySelectorAll('.marquee-content').forEach(el => {
      el.textContent = CONTENT.marquee;
    });

    // Dream Teams section
    setText('dream-teams-title', CONTENT.sections.dreamTeams.title);
    setText('dream-teams-subtitle', CONTENT.sections.dreamTeams.subtitle);
    setHTML('teams-grid', TEAMS.map(team => `
      <div class="team-card">
        <div class="team-name">${team.name}</div>
        <div class="team-owner">Owner: ${displayName(team.manager)}</div>
        <div class="team-record">${CURRENT_YEAR} Record: ${team.wins}-${team.losses}</div>
      </div>
    `).join(''));

    // Fame & Shame section
    setText('fame-shame-title', CONTENT.sections.fameShame.title);
    setText('fame-shame-subtitle', CONTENT.sections.fameShame.subtitle);
    setHTML('fame-shame-thead', `<tr>${CONTENT.sections.fameShame.tableHeaders.map(h =>
      `<th>${h}</th>`
    ).join('')}</tr>`);

    const years = Object.keys(LEAGUE_DATA).map(Number).sort((a, b) => b - a);
    setHTML('fame-shame-tbody', years.map(year => {
      const d = LEAGUE_DATA[year];
      const rowStyle = d.missing ? 'style="opacity: 0.4; font-style: italic;"' : '';
      return `
        <tr ${rowStyle}>
          <td class="year-col">${year}</td>
          <td class="fame-col">${d.champion}</td>
          <td class="shame-col">${d.lastPlace}</td>
        </tr>
      `;
    }).join(''));

    // Heroes section
    // Popup config: hero name -> { src, title }
    const HERO_POPUPS = {
      'Gary': { src: '/worst-commish-ever/images/Gary-Claude-Van-Damme.jpg', title: 'gary.jpg' }
    };

    setText('heroes-title', CONTENT.sections.heroes.title);
    setText('heroes-subtitle', CONTENT.sections.heroes.subtitle);
    setHTML('heroes-grid', Object.entries(HEROES)
      .sort((a, b) => b[1].seasons - a[1].seasons) // Sort by seasons played
      .map(([name, data]) => {
        const retiredClass = data.retired ? 'retired' : '';
        const status = data.retired ? '<div class="hero-status">~ Gone but not forgotten ~</div>' : '';
        const popup = HERO_POPUPS[name];
        const popupAttrs = popup
          ? `class="hero-name clickable" data-popup-src="${popup.src}" data-popup-title="${popup.title}"`
          : 'class="hero-name"';
        return `
          <div class="hero-card ${retiredClass}">
            <div ${popupAttrs}>${name}</div>
            <div class="hero-years">${data.years} (${data.seasons} seasons)</div>
            <div class="hero-teams">${data.teamNames.map(t => `<span>${t}</span>`).join('')}</div>
            ${status}
          </div>
        `;
      }).join(''));

    // History section
    setText('history-title', CONTENT.sections.history.title);
    setText('history-subtitle', CONTENT.sections.history.subtitle);
    setText('history-under-construction', CONTENT.sections.history.underConstruction);
    setHTML('timeline', CONTENT.sections.history.timeline.map(item => {
      let eventHTML = item.event;
      if (item.rainbow && item.prefix) {
        eventHTML = `<span class="rainbow-text">${item.prefix}</span> ${item.event}`;
      }
      return `
        <div class="timeline-item">
          <div class="timeline-year">${item.year}</div>
          <div class="timeline-event">${eventHTML}</div>
        </div>
      `;
    }).join(''));

    // Rules section
    setText('rules-title', CONTENT.sections.rules.title);
    setText('rules-subtitle', CONTENT.sections.rules.subtitle);
    setText('rules-under-construction', CONTENT.sections.rules.underConstruction);
    setHTML('rules-list', CONTENT.sections.rules.rules.map(rule => `
      <li>
        <span class="rule-title">${rule.title}</span>
        ${rule.description}
      </li>
    `).join(''));

    // Footer
    setHTML('footer-badges', CONTENT.footer.badges.map(badge =>
      `<span class="badge">${badge}</span>`
    ).join(''));
    setHTML('footer-copyright',
      `&copy; ${CONTENT.footer.copyright}<br>${CONTENT.footer.copyrightNote}`
    );
    const contactLink = document.getElementById('footer-contact');
    if (contactLink) {
      contactLink.href = `mailto:${CONTENT.footer.contactEmail}`;
      contactLink.textContent = CONTENT.footer.contactText;
    }

    // Fake hit counter
    (function() {
      const counter = document.querySelector('.counter-display');
      if (counter) {
        let visits = parseInt(localStorage.getItem('wce_visits') || '46', 10);
        visits++;
        localStorage.setItem('wce_visits', visits.toString());
        counter.textContent = visits.toString().padStart(6, '0');
      }
    })();

    // Generic image popup system
    // Usage: Add data-popup-src="path/to/image.jpg" data-popup-title="Title" to any element
    (function() {
      const overlay = document.getElementById('popup-overlay');

      function openPopup(src, title) {
        overlay.innerHTML = `
          <div class="popup-window">
            <div class="popup-titlebar">
              <span class="popup-title">${title} - Windows Picture Viewer</span>
              <button class="popup-close" title="Close">X</button>
            </div>
            <div class="popup-content">
              <img src="${src}" alt="${title}">
            </div>
          </div>
        `;
        overlay.classList.add('active');
      }

      function closePopup() {
        overlay.classList.remove('active');
      }

      // Delegate click on any element with data-popup-src
      document.addEventListener('click', (e) => {
        const trigger = e.target.closest('[data-popup-src]');
        if (trigger) {
          openPopup(trigger.dataset.popupSrc, trigger.dataset.popupTitle || 'Image');
        }
      });

      // Close handlers (delegated since content is dynamic)
      overlay.addEventListener('click', (e) => {
        if (e.target === overlay || e.target.matches('.popup-close')) {
          closePopup();
        }
      });

      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && overlay.classList.contains('active')) {
          closePopup();
        }
      });
    })();
  </script>

</body>
</html>
