---
// Sidebar component with projects navigation
interface Project {
  name: string;
  href: string;
  lang?: string;
  desc?: string;
}

interface Props {
  projects: Project[];
  class?: string;
}

const { projects, class: className } = Astro.props;

// Short text labels for language badges — readable at any size, terminal-native
const langBadges: Record<string, string> = {
  go: 'Go',
  ruby: 'Rb',
  shell: 'Sh',
  ts: 'TS',
  threejs: '3D',
};

---

<aside class:list={['sidebar', className]}>
  <div class="sidebar-box">
    <h2 class="sidebar-title">Projects</h2>
    <details class="projects-dropdown" open>
      <summary class="projects-toggle" aria-label="Toggle projects menu">
        <svg class="hamburger-icon" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <line x1="3" y1="6" x2="21" y2="6" />
          <line x1="3" y1="12" x2="21" y2="12" />
          <line x1="3" y1="18" x2="21" y2="18" />
        </svg>
        <span>Projects</span>
      </summary>
      <ul class="project-list">
        {projects.map((project) => {
          const badge = project.lang ? langBadges[project.lang] : null;
          return (
            <li>
              {project.name === 'marmiteroids' ? (
                <a href={project.href} class="marmite-link">
                  <canvas id="marmite-jar" width="150" height="150"></canvas>
                  <span class="sr-only">marmiteroids</span>
                  {project.desc && <span class="project-desc">{project.desc}</span>}
                </a>
              ) : (
                <a href={project.href}>
                  <span class="project-name">
                    {project.name}
                    {badge && <span class="lang-badge">{badge}</span>}
                  </span>
                  {project.desc && <span class="project-desc">{project.desc}</span>}
                </a>
              )}
            </li>
          );
        })}
      </ul>
    </details>
  </div>
</aside>

<style>
  .sidebar {
    /* No outer padding on desktop: the page grid's column-gap is the gutter,
       so the box fills its grid cell and aligns top/bottom with its neighbours.
       (Mobile re-adds breathing room below.) */
    padding: 0;
    display: flex;
    flex-direction: column;
  }

  .sidebar-box {
    padding: 1rem;
    border: 1px solid var(--color-border);
    background: var(--color-surface);
    transition: border-color 0.3s ease, box-shadow 0.3s ease;
    flex: 1;
  }

  .sidebar-box:hover {
    border-color: var(--color-accent-secondary);
    box-shadow: 0 0 20px rgba(0, 255, 222, 0.2);
  }

  .sidebar-title {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-text-muted);
    margin-bottom: 0.75rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--color-border);
  }

  /* Desktop: dropdown contents visible, no toggle */
  .projects-dropdown {
    display: contents;
  }

  .projects-toggle {
    display: none;
  }

  .project-list {
    list-style: none;
  }

  .project-list li {
    margin-bottom: 0.5rem;
  }

  .project-list a {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--color-text-muted);
    text-decoration: none;
    display: block;
    position: relative;
    padding: 0.125rem 0;
    transition: color 0.2s ease;
  }

  .project-list a::before {
    content: '>';
    position: absolute;
    left: -0.85rem;
    color: var(--color-accent);
    opacity: 0;
    transition: opacity 0.2s ease;
  }

  .project-list a:hover {
    color: var(--color-text);
  }

  .project-list a:hover::before {
    opacity: 1;
  }

  .project-name {
    display: block;
  }

  .lang-badge {
    display: inline-block;
    font-size: 0.6rem;
    line-height: 1;
    padding: 0.1em 0.3em;
    border: 1px solid var(--color-border);
    border-radius: 2px;
    color: var(--color-text-muted);
    opacity: 0.6;
    vertical-align: 0.1em;
    margin-right: 0.2rem;
    transition: opacity 0.2s ease, color 0.2s ease, border-color 0.2s ease;
  }

  .project-list a:hover .lang-badge {
    opacity: 1;
    color: var(--color-accent-tertiary);
    border-color: var(--color-accent-tertiary);
  }

  .project-desc {
    display: block;
    font-size: 0.7rem;
    color: var(--color-text-muted);
    opacity: 0.4;
    margin-top: 0.1rem;
    letter-spacing: 0.02em;
    line-height: 1.2;
  }

  /* Marmite jar link */
  .marmite-link {
    display: block;
    padding: 0;
    transition: padding-left 0.2s ease;
  }

  .marmite-link::before {
    display: none;
  }

  .marmite-link:hover {
    padding-left: 0.5rem;
  }

  .marmite-link canvas {
    display: inline-block;
    vertical-align: middle;
    border-bottom: 2px solid transparent;
    transition: border-color 0.2s ease;
  }

  .marmite-link:hover canvas {
    border-bottom-color: var(--color-accent);
  }

  /* Mobile responsive */
  @media (max-width: 900px) {
    .sidebar {
      padding: 1.5rem 0;
    }

    .sidebar-box {
      border: none;
      padding: 0;
      background: transparent;
    }

    .sidebar-box:hover {
      border-color: transparent;
      box-shadow: none;
    }

    .sidebar-title {
      display: none;
    }

    .projects-dropdown {
      display: block;
    }

    .projects-toggle {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      font-family: var(--font-mono);
      font-size: 0.875rem;
      color: var(--color-text-muted);
      cursor: pointer;
      padding: 0.5rem 0;
      list-style: none;
    }

    .projects-toggle::-webkit-details-marker {
      display: none;
    }

    .projects-toggle .hamburger-icon {
      color: var(--color-accent);
      transition: transform 0.2s ease;
    }

    .projects-dropdown[open] .hamburger-icon {
      transform: rotate(90deg);
    }

    .projects-toggle:hover {
      color: var(--color-text);
    }

    /* The toggle is a focusable <summary>; the global focus ring only
       targets anchors, so give it the same visible keyboard outline. */
    .projects-toggle:focus-visible {
      outline: 2px solid var(--color-accent);
      outline-offset: 4px;
    }

    .project-list {
      padding: 1rem 0 0 0;
    }

    .project-list li {
      margin-bottom: 0.5rem;
    }
  }
</style>
