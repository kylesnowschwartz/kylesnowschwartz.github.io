---
// Footer component
interface SocialLink {
  name: string;
  href: string;
}

interface Props {
  year?: number;
  socialLinks: SocialLink[];
}

const { year = new Date().getFullYear(), socialLinks } = Astro.props;
---

<div class="theme-banner-bottom"></div>
<footer>
  <div class="container">
    <div class="footer-content">
      <p>&copy; {year} kyle snow schwartz</p>
      <nav class="social-links">
        {socialLinks.map((link) => (
          <a href={link.href}>{link.name}</a>
        ))}
      </nav>
    </div>
  </div>
</footer>

<style>
  /* Bottom bezel edge — mirrors the header's fixed top bar so the viewport
     is framed top and bottom; fixed so the overscroll bounce can't move it. */
  .theme-banner-bottom {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    height: 2px;
    background: linear-gradient(90deg, var(--color-accent-tertiary), var(--color-accent));
    z-index: 10;
  }

  footer {
    border-top: 1px solid var(--color-border);
    padding: 2rem 0;
    margin-top: 4rem;
  }

  .footer-content {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .footer-content p {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-text-muted);
  }

  .social-links {
    display: flex;
    gap: 1.5rem;
  }

  .social-links a {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-text-muted);
    text-decoration: none;
    transition: color var(--dur-micro) var(--ease-out);
  }

  .social-links a:hover {
    color: var(--color-accent);
  }

  @media (max-width: 600px) {
    .footer-content {
      flex-direction: column;
      gap: 1rem;
      text-align: center;
    }
  }
</style>
