---
// About panel — placed on the page φ-grid by the class passed from index.astro
interface Props {
  title: string;
  class?: string;
}

const { title, class: className } = Astro.props;
---

<article class:list={['about-panel', className]}>
  <h3 class="panel-header">{title}</h3>
  <div class="panel-content">
    <slot />
  </div>
</article>

<style>
  .about-panel {
    padding: 1.5rem;
    border: 1px solid var(--color-border);
    background: var(--color-surface);
    transition: border-color 0.3s ease, box-shadow 0.3s ease;
    height: 100%; /* fill the grid cell so row neighbours align */
  }

  /* "Who" is the lead narrative (tier 2): its first line reads larger and
     in the display mono, anchoring the reading order below the wordmark. */
  .who .panel-content :global(p:first-child) {
    font-family: var(--font-mono);
    font-size: 1.375rem;
    color: var(--color-text);
    line-height: 1.3;
    margin-bottom: 1rem;
  }

  .about-panel:hover {
    border-color: var(--color-accent-secondary);
    box-shadow: 0 0 20px rgba(0, 255, 222, 0.2);
  }

  /* Terminal-poster header: the panel title IS the loud element — display-
     sized mono with a prompt glyph, instead of a whispering eyebrow. */
  .panel-header {
    font-family: var(--font-mono);
    font-size: clamp(1.75rem, 2.6vw, 2.25rem);
    text-transform: uppercase;
    letter-spacing: 0.02em;
    line-height: 1;
    color: var(--color-accent-tertiary);
    margin-bottom: var(--s3);
  }

  .panel-header::before {
    content: '> ';
    color: var(--color-accent);
  }

  .panel-content {
    font-family: var(--font-grotesk);
    font-weight: 500;
    font-size: 1rem;
    color: var(--color-text);
    line-height: 1.55;
    overflow-wrap: anywhere;
  }

  .panel-content :global(p) {
    margin-bottom: 0.75rem;
  }

  .panel-content :global(p:last-child) {
    margin-bottom: 0;
  }

  .panel-content :global(a) {
    color: var(--color-accent);
    text-decoration: none;
    border-bottom: 1px solid transparent;
    transition: border-color 0.2s ease;
  }

  .panel-content :global(a:hover) {
    border-bottom-color: var(--color-accent);
  }
</style>
