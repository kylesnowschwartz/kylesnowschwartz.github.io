---
// About panel component for the three-column grid
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<article class="about-panel">
  <h3 class="panel-header">{title}</h3>
  <div class="panel-content">
    <slot />
  </div>
</article>

<style>
  .about-panel {
    padding: 1.5rem;
    border: 1px solid var(--color-border);
    background: var(--color-surface);
    transition: border-color 0.3s ease, box-shadow 0.3s ease;
  }

  .about-panel:hover {
    border-color: var(--color-accent-secondary);
    box-shadow: 0 0 20px rgba(0, 255, 222, 0.2);
  }

  .panel-header {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-accent-tertiary);
    margin-bottom: 1rem;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .panel-header::before {
    content: '';
    width: 24px;
    height: 1px;
    background: var(--color-accent-tertiary);
  }

  .panel-content {
    font-size: 0.9375rem;
    color: var(--color-text-muted);
    line-height: 1.7;
  }

  .panel-content :global(p) {
    margin-bottom: 0.75rem;
  }

  .panel-content :global(p:last-child) {
    margin-bottom: 0;
  }

  .panel-content :global(a) {
    color: var(--color-accent);
    text-decoration: none;
    border-bottom: 1px solid transparent;
    transition: border-color 0.2s ease;
  }

  .panel-content :global(a:hover) {
    border-bottom-color: var(--color-accent);
  }
</style>
