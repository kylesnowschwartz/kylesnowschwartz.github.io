---
/**
 * TeamCard.astro - Display a fantasy team with their record
 *
 * Patterns demonstrated:
 * - Simple TypeScript Props interface
 * - Computed values in template (record string)
 * - Scoped CSS with theme variables
 */

interface Props {
  name: string;
  manager: string;
  wins: number;
  losses: number;
  year: number;
}

const { name, manager, wins, losses, year } = Astro.props;
---

<div class="team-card">
  <div class="team-name">{name}</div>
  <div class="team-owner">Owner: {manager}</div>
  <div class="team-record">{year} Record: {wins}-{losses}</div>
</div>

<style>
  .team-card {
    background: linear-gradient(180deg, #1a1a2e 0%, #0a0a15 100%);
    border: var(--wce-border-width) solid var(--wce-text-magenta);
    padding: var(--wce-space-md);
    text-align: center;
  }

  .team-name {
    font-family: var(--wce-font-display);
    font-size: 1rem;
    color: var(--wce-text-lime);
    margin-bottom: var(--wce-space-xs);
  }

  .team-owner {
    font-size: 0.875rem;
    color: var(--wce-text-cyan);
  }

  .team-record {
    font-size: 0.75rem;
    color: var(--wce-silver);
    margin-top: var(--wce-space-xs);
  }
</style>
