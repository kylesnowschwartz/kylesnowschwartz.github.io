---
// The "shelf" of on-site destinations. Each is an object that leaks the world
// it leads to: a spinning 3D jar (marmiteroids), fan-out book spines
// (reading-list), and a deliberately-1996 trophy (worst-commish-ever).
// The jar's WebGL init lives in index.astro (it needs the page's three.js
// importmap), so this component owns markup + style only.
interface OnSiteItem {
  name: string;
  href: string;
  kind: 'jar' | 'spines' | 'trophy' | 'paper';
  desc?: string;
}

interface Props {
  items: OnSiteItem[];
}

const { items } = Astro.props;
---

<section class="onsite">
  <h3 class="onsite-title">On site</h3>
  <ul class="onsite-list">
    {items.map((item) => (
      <li class:list={['onsite-item', `kind-${item.kind}`]}>
        <a href={item.href} class:list={['onsite-link', `link-${item.kind}`]}>
          {item.kind === 'jar' && (
            <canvas id="marmite-jar" width="150" height="150"></canvas>
          )}
          {item.kind === 'spines' && (
            <span class="spines" aria-hidden="true">
              <i style="--c:#ff204e; --h:90%; --r:-18deg"></i>
              <i style="--c:#1f6fa8; --h:70%; --r:-9deg"></i>
              <i style="--c:#8a2233; --h:100%; --r:0deg"></i>
              <i style="--c:#5f7a3c; --h:80%; --r:9deg"></i>
              <i style="--c:#b07d2b; --h:92%; --r:18deg"></i>
            </span>
          )}
          {item.kind === 'paper' && (
            <span class="paper" aria-hidden="true">
              <span class="paper-rule"></span>
              <i></i><i></i><i></i><i style="--w:60%"></i>
            </span>
          )}
          {item.kind === 'trophy' && (
            <span class="trophy" aria-hidden="true">
              <span class="trophy-cup">🏆</span>
              <span class="blink-badge">NEW!</span>
            </span>
          )}
          <span class="onsite-label">{item.name}</span>
          {item.desc && <span class="onsite-desc">{item.desc}</span>}
        </a>
      </li>
    ))}
  </ul>
</section>

<style>
  .onsite {
    margin-top: 1rem;
    padding-top: 0.75rem;
    border-top: 1px solid var(--color-border);
  }

  /* Matches .sidebar-title: same supporting-tier terminal voice. */
  .onsite-title {
    font-family: var(--font-mono);
    font-size: clamp(1.25rem, 1.9vw, 1.5rem);
    text-transform: uppercase;
    letter-spacing: 0.02em;
    line-height: 1;
    color: var(--color-text);
    margin-bottom: 0.75rem;
  }

  .onsite-title::before {
    content: '> ';
    color: var(--color-accent);
  }

  .onsite-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .onsite-link {
    display: block;
    font-family: var(--font-mono);
    text-decoration: none;
    border: 1px solid var(--color-border);
    background: var(--color-surface);
    padding: 0.6rem;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .onsite-link:hover {
    border-color: var(--color-accent-secondary);
    box-shadow: 0 0 16px rgba(0, 255, 222, 0.15);
  }

  .onsite-label {
    display: block;
    font-size: 1rem;
    color: var(--color-text);
  }

  .onsite-desc {
    display: block;
    font-size: 0.8125rem;
    color: var(--color-text-muted);
    opacity: 0.6;
    margin-top: 0.15rem;
    line-height: 1.2;
  }

  /* marmiteroids — the live spinning jar, centered above its label */
  .link-jar {
    text-align: center;
  }

  .link-jar canvas {
    display: block;
    margin: 0 auto 0.4rem;
    border-bottom: 2px solid transparent;
    transition: border-color 0.2s ease;
  }

  .link-jar:hover canvas {
    border-bottom-color: var(--color-accent);
  }

  /* reading-list — five book spines (genre-colored) that fan out on hover,
     like pulling books off a shelf. Decorative; the label carries the name. */
  .link-spines {
    text-align: center;
  }

  .spines {
    display: flex;
    align-items: flex-end;
    justify-content: center;
    gap: 3px;
    height: 56px;
    margin-bottom: 0.5rem;
  }

  .spines i {
    display: block;
    width: 9px;
    height: var(--h, 80%);
    background: var(--c);
    border: 1px solid rgba(60, 40, 20, 0.35);
    transform-origin: bottom center;
    transition: transform 0.28s cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .link-spines:hover .spines i {
    transform: rotate(var(--r)) translateY(-3px);
  }

  /* cv — a tilted A4 sheet with the CV's green header rule and faint text
     lines; straightens on hover, like picking the page up off the desk. */
  .link-paper {
    text-align: center;
  }

  .paper {
    display: flex;
    flex-direction: column;
    gap: 5px;
    width: 42px;
    height: 56px;
    margin: 0 auto 0.5rem;
    padding: 7px 6px;
    background: #fdfdfc;
    border: 1px solid rgba(60, 60, 60, 0.45);
    transform: rotate(-4deg);
    transition: transform 0.28s cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .paper-rule {
    display: block;
    height: 3px;
    background: #1d6a45;
  }

  .paper i {
    display: block;
    width: var(--w, 100%);
    height: 2px;
    background: rgba(60, 60, 60, 0.35);
  }

  .link-paper:hover .paper {
    transform: rotate(0deg) translateY(-2px);
  }

  @media (prefers-reduced-motion: reduce) {
    .paper {
      transition: none;
    }
    .link-paper:hover .paper {
      transform: none;
    }
  }

  /* worst-commish-ever — a deliberately 1996 GeoCities artifact: navy tiled
     bg, beveled Win95 button, Comic Sans, a trophy and a blinking NEW! badge.
     The clash is the point; it's quarantined to this one cell so it reads as
     authored, not broken. Hover "presses" the bevel (outset -> inset). */
  .link-trophy {
    background:
      repeating-linear-gradient(0deg, rgba(255, 255, 255, 0.05) 0 1px, transparent 1px 4px),
      #000080;
    border: 3px outset #c0c0c0;
    text-align: center;
  }

  .link-trophy:hover {
    border-color: #c0c0c0;
    border-style: inset;
    box-shadow: none;
  }

  .link-trophy .onsite-label {
    font-family: 'Comic Sans MS', 'Comic Sans', cursive;
    font-weight: 700;
    color: #ffff00;
    text-shadow: 1px 1px 0 #ff00ff;
  }

  .link-trophy .onsite-desc {
    font-family: 'Comic Sans MS', 'Comic Sans', cursive;
    color: #00ffff;
    opacity: 1;
  }

  .trophy {
    display: block;
    margin-bottom: 0.3rem;
  }

  .trophy-cup {
    font-size: 1.7rem;
    vertical-align: middle;
  }

  .blink-badge {
    display: inline-block;
    vertical-align: middle;
    margin-left: 5px;
    padding: 0 3px;
    font-family: 'Comic Sans MS', 'Comic Sans', cursive;
    font-size: 0.6rem;
    font-weight: 700;
    color: #ff0000;
    background: #ffff00;
    border: 1px solid #ff0000;
    animation: blink 1s steps(1, end) infinite;
  }

  @keyframes blink {
    50% { opacity: 0; }
  }

  /* Respect reduced-motion: hold the spines still (no fan), stop the blink. */
  @media (prefers-reduced-motion: reduce) {
    .spines i {
      transition: none;
    }
    .link-spines:hover .spines i {
      transform: none;
    }
    .blink-badge {
      animation: none;
    }
  }
</style>
