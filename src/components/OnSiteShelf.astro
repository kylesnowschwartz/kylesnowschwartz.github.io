---
// The "shelf" of on-site destinations. Each is an object that leaks the world
// it leads to: a spinning 3D jar (marmiteroids), a dot-matrix printer feeding
// out a CV (cv), a bookshelf with a book sliding out (reading-list), and a
// deliberately-1996 trophy (worst-commish-ever). The jar's WebGL init lives in
// index.astro (it needs the page's three.js importmap); the printer and
// bookshelf are static SVG components with CSS-only hover motion.
import PrinterFigure from './onsite/PrinterFigure.astro';
import BookshelfFigure from './onsite/BookshelfFigure.astro';

interface OnSiteItem {
  name: string;
  href: string;
  kind: 'jar' | 'bookshelf' | 'trophy' | 'printer';
  desc?: string;
}

interface Props {
  items: OnSiteItem[];
}

const { items } = Astro.props;
---

<section class="onsite">
  <h3 class="onsite-title">On site</h3>
  <ul class="onsite-list">
    {items.map((item) => (
      <li class:list={['onsite-item', `kind-${item.kind}`]}>
        <a href={item.href} class:list={['onsite-link', `link-${item.kind}`]}>
          {item.kind === 'jar' && (
            <canvas id="marmite-jar" width="180" height="180"></canvas>
          )}
          {item.kind === 'printer' && <PrinterFigure />}
          {item.kind === 'bookshelf' && <BookshelfFigure />}
          {item.kind === 'trophy' && (
            <span class="trophy" aria-hidden="true">
              <span class="trophy-cup">🏆</span>
              <span class="blink-badge">NEW!</span>
            </span>
          )}
          <span class="onsite-label">{item.name}</span>
          {item.desc && <span class="onsite-desc">{item.desc}</span>}
        </a>
      </li>
    ))}
  </ul>
</section>

<style>
  .onsite {
    margin-top: 1rem;
    padding-top: 0.75rem;
    border-top: 1px solid var(--color-border);
  }

  /* Matches .sidebar-title: same supporting-tier terminal voice. */
  .onsite-title {
    font-family: var(--font-mono);
    font-size: clamp(1.25rem, 1.9vw, 1.5rem);
    text-transform: uppercase;
    letter-spacing: 0.02em;
    line-height: 1;
    color: var(--color-text);
    margin-bottom: 0.75rem;
  }

  .onsite-title::before {
    content: '> ';
    color: var(--color-accent);
  }

  .onsite-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .onsite-link {
    display: block;
    font-family: var(--font-mono);
    text-decoration: none;
    border: 1px solid var(--color-border);
    background: var(--color-surface);
    padding: 0.6rem;
    transition: border-color var(--dur-short) var(--ease-out), box-shadow var(--dur-short) var(--ease-out),
      transform var(--dur-micro) var(--ease-out);
  }

  .onsite-link:hover {
    transform: translateY(-1.5px);
  }

  .onsite-link:active {
    transform: translateY(1px);
  }

  .onsite-label {
    display: block;
    font-size: 1rem;
    color: var(--color-text);
  }

  .onsite-desc {
    display: block;
    font-size: 0.8125rem;
    color: var(--color-text-muted);
    opacity: 0.6;
    margin-top: 0.15rem;
    line-height: 1.2;
  }

  /* marmiteroids — the live spinning jar, centered above its label */
  .link-jar {
    text-align: center;
  }

  .link-jar canvas {
    display: block;
    margin: 0 auto 0.4rem;
    border-bottom: 2px solid transparent;
    transition: border-color var(--dur-micro) var(--ease-out);
  }

  .link-jar:hover canvas {
    border-bottom-color: var(--color-accent);
  }

  /* cv (printer) and reading-list (bookshelf) — 150px figures, centred above
     their labels like the jar; motion lives in the figure components. */
  .link-printer,
  .link-bookshelf {
    text-align: center;
  }

  /* worst-commish-ever — a deliberately 1996 GeoCities artifact: navy tiled
     bg, beveled Win95 button, Comic Sans, a trophy and a blinking NEW! badge.
     The clash is the point; it's quarantined to this one cell so it reads as
     authored, not broken. Hover "presses" the bevel (outset -> inset). */
  .link-trophy {
    background:
      repeating-linear-gradient(0deg, rgba(255, 255, 255, 0.05) 0 1px, transparent 1px 4px),
      #000080;
    border: 3px outset #c0c0c0;
    text-align: center;
  }

  .link-trophy:hover {
    border-color: #c0c0c0;
    border-style: inset;
    box-shadow: none;
  }

  .link-trophy .onsite-label {
    font-family: 'Comic Sans MS', 'Comic Sans', cursive;
    font-weight: 700;
    color: #ffff00;
    text-shadow: 1px 1px 0 #ff00ff;
  }

  .link-trophy .onsite-desc {
    font-family: 'Comic Sans MS', 'Comic Sans', cursive;
    color: #00ffff;
    opacity: 1;
  }

  .trophy {
    display: block;
    margin-bottom: 0.3rem;
  }

  .trophy-cup {
    font-size: 1.7rem;
    vertical-align: middle;
  }

  .blink-badge {
    display: inline-block;
    vertical-align: middle;
    margin-left: 5px;
    padding: 0 3px;
    font-family: 'Comic Sans MS', 'Comic Sans', cursive;
    font-size: 0.6rem;
    font-weight: 700;
    color: #ff0000;
    background: #ffff00;
    border: 1px solid #ff0000;
    animation: blink 1s steps(1, end) infinite;
  }

  @keyframes blink {
    50% { opacity: 0; }
  }

  /* Respect reduced-motion: stop the blink. */
  @media (prefers-reduced-motion: reduce) {
    .blink-badge {
      animation: none;
    }
  }
</style>
