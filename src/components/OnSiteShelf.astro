---
// The "shelf" of on-site destinations. Each is an object that leaks the world
// it leads to: a spinning 3D jar (marmiteroids), fan-out book spines
// (reading-list), and a deliberately-1996 trophy (worst-commish-ever).
// The jar's WebGL init lives in index.astro (it needs the page's three.js
// importmap), so this component owns markup + style only.
interface OnSiteItem {
  name: string;
  href: string;
  kind: 'jar' | 'spines' | 'trophy';
  desc?: string;
}

interface Props {
  items: OnSiteItem[];
}

const { items } = Astro.props;
---

<section class="onsite">
  <h3 class="onsite-title">On site</h3>
  <ul class="onsite-list">
    {items.map((item) => (
      <li class:list={['onsite-item', `kind-${item.kind}`]}>
        <a href={item.href} class:list={['onsite-link', `link-${item.kind}`]}>
          {item.kind === 'jar' && (
            <canvas id="marmite-jar" width="150" height="150"></canvas>
          )}
          {item.kind === 'spines' && (
            <span class="spines" aria-hidden="true">
              <i style="--c:#ff204e; --h:90%; --r:-18deg"></i>
              <i style="--c:#1f6fa8; --h:70%; --r:-9deg"></i>
              <i style="--c:#8a2233; --h:100%; --r:0deg"></i>
              <i style="--c:#5f7a3c; --h:80%; --r:9deg"></i>
              <i style="--c:#b07d2b; --h:92%; --r:18deg"></i>
            </span>
          )}
          <span class="onsite-label">{item.name}</span>
          {item.desc && <span class="onsite-desc">{item.desc}</span>}
        </a>
      </li>
    ))}
  </ul>
</section>

<style>
  .onsite {
    margin-top: 1rem;
    padding-top: 0.75rem;
    border-top: 1px solid var(--color-border);
  }

  .onsite-title {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-text-muted);
    margin-bottom: 0.75rem;
  }

  .onsite-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .onsite-link {
    display: block;
    font-family: var(--font-mono);
    text-decoration: none;
    border: 1px solid var(--color-border);
    background: var(--color-surface);
    padding: 0.6rem;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .onsite-link:hover {
    border-color: var(--color-accent-secondary);
    box-shadow: 0 0 16px rgba(0, 255, 222, 0.15);
  }

  .onsite-label {
    display: block;
    font-size: 0.85rem;
    color: var(--color-text);
  }

  .onsite-desc {
    display: block;
    font-size: 0.7rem;
    color: var(--color-text-muted);
    opacity: 0.6;
    margin-top: 0.15rem;
    line-height: 1.2;
  }

  /* marmiteroids — the live spinning jar, centered above its label */
  .link-jar {
    text-align: center;
  }

  .link-jar canvas {
    display: block;
    margin: 0 auto 0.4rem;
    border-bottom: 2px solid transparent;
    transition: border-color 0.2s ease;
  }

  .link-jar:hover canvas {
    border-bottom-color: var(--color-accent);
  }

  /* reading-list — five book spines (genre-colored) that fan out on hover,
     like pulling books off a shelf. Decorative; the label carries the name. */
  .link-spines {
    text-align: center;
  }

  .spines {
    display: flex;
    align-items: flex-end;
    justify-content: center;
    gap: 3px;
    height: 56px;
    margin-bottom: 0.5rem;
  }

  .spines i {
    display: block;
    width: 9px;
    height: var(--h, 80%);
    background: var(--c);
    border: 1px solid rgba(60, 40, 20, 0.35);
    transform-origin: bottom center;
    transition: transform 0.28s cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .link-spines:hover .spines i {
    transform: rotate(var(--r)) translateY(-3px);
  }

  /* Respect reduced-motion: hold the spines still (no fan), keep the colors. */
  @media (prefers-reduced-motion: reduce) {
    .spines i {
      transition: none;
    }
    .link-spines:hover .spines i {
      transform: none;
    }
  }
</style>
