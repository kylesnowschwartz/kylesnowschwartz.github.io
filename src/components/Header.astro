---
// Header component with ASCII banner and tagline
import { readFileSync } from 'node:fs';

interface Props {
  tagline?: string;
}

const { tagline = '// # TODO: set inspired tagline' } = Astro.props;

// Inline the wordmark at build time: the ASCII must be in the initial HTML
// payload so the header renders complete on first paint, in step with the
// page-grid's load cascade.
const ascii = (name: string) => readFileSync(`public/ascii/${name}.txt`, 'utf-8');
const kyle = ascii('kyle');
const snow = ascii('snow');
const schwartz = ascii('schwartz');
---

<div class="theme-banner"></div>
<header>
  <div class="container">
    <!-- PRIMARY BREAK: the identity wordmark goes full-bleed past the
         container's right edge while staying pinned left to grid line 1. -->
    <div class="ascii-bleed">
      <div class="ascii-banner" aria-label="Kyle Snow Schwartz">
        <span class="name name-kyle">{kyle}</span>
        <span class="name name-snow">{snow}</span>
        <span class="name name-schwartz">{schwartz}</span>
      </div>
    </div>
    <p class="tagline"><span>{tagline}</span></p>
  </div>
</header>

<script>
  // Fire-and-complete glitch: mouseenter arms it, animationend disarms it.
  // While armed, re-entries are ignored, so the gesture always plays whole.
  const header = document.querySelector('header')!;
  const banner = header.querySelector('.ascii-banner')!;
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

  header.addEventListener('mouseenter', () => {
    if (reducedMotion.matches) return;
    banner.classList.add('is-glitching');
  });

  banner.addEventListener('animationend', (e) => {
    if ((e.target as HTMLElement).classList.contains('name-schwartz')) {
      banner.classList.remove('is-glitching');
    }
  });
</script>

<style>
  /* Viewport chrome, not document content: fixed so the rubber-band bounce
     can't peel it off the top. Reads as the chassis bezel edge. */
  .theme-banner {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    height: 2px;
    background: linear-gradient(90deg, var(--color-accent-tertiary), var(--color-accent));
    z-index: 10;
  }

  header {
    padding: var(--s6) 0 var(--s5);
    border-bottom: 1px solid var(--color-border);
    overflow: visible; /* allow the wordmark to bleed past the header box */
  }

  /* The bleed wrapper: left edge sits at the container's content edge
     (grid line 1); the right edge is released to run to the viewport edge.
     width = half the viewport + half the container - the container gutter. */
  .ascii-bleed {
    position: relative;
    /* Land the right edge exactly at the viewport. The bleed formula is
       derived for the centered-container range (≥ ~1200px); below that the
       container is full-width, so cap at the viewport minus the left gutter
       to keep the right edge (and its accent marker) on-screen rather than
       overflowing by one gutter-width into body's overflow-x clip. */
    width: min(
      calc(100vw - var(--gap)),
      calc(50vw + var(--container-max) / 2 - var(--gap))
    );
  }

  /* A thin accent edge marks the boundary the wordmark crossed, so the
     break reads as authored rather than as an overflow accident. */
  .ascii-bleed::after {
    content: '';
    position: absolute;
    top: 50%;
    right: 0;
    transform: translateY(-50%);
    width: var(--s2);
    height: 78%;
    background: linear-gradient(
      180deg,
      transparent,
      var(--color-accent) 40%,
      var(--color-accent-tertiary) 60%,
      transparent
    );
    opacity: 0.55;
    pointer-events: none;
  }

  .ascii-banner {
    font-family: var(--font-mono);
    font-size: clamp(0.4rem, 1.45vw, 0.82rem);
    line-height: 1.2;
    color: var(--color-text);
    white-space: pre;
    letter-spacing: -0.05em;
    user-select: none;
  }

  /* CRT sync-loss glitch: one-shot chromatic aberration on hover-in — the
     red and cyan channels split in hard steps, then snap clean. The glitch
     rolls down the wordmark (each name fires 60ms after the one above, like
     sync loss traveling down a screen) while the stair-step deepens: each
     name slides one further grid step right and holds while hovered. */
  /* Split amplitude decays 3→2→1→0, keyframed to the boomerang's timeline:
     hardest split at launch, flip at the 40% turnaround, dead by the time
     the name settles home. Both animations share one 600ms clock. */
  @keyframes crt-glitch {
    0% {
      text-shadow: -3px 0 var(--color-accent), 3px 0 var(--color-accent-secondary);
      animation-timing-function: step-end;
    }
    40% {
      text-shadow: 2px 0 var(--color-accent), -2px 0 var(--color-accent-secondary);
      animation-timing-function: step-end;
    }
    65% {
      text-shadow: -1px 0 var(--color-accent), 1px 0 var(--color-accent-secondary);
      animation-timing-function: step-end;
    }
    85%, 100% {
      text-shadow: none;
    }
  }

  /* Boomerang: each name shoots out to its deepened step, then eases back
     home — a one-shot gesture, not a held state. Distance set per name. */
  @keyframes stair-boomerang {
    0% {
      transform: translateX(0);
      animation-timing-function: var(--ease-out);
    }
    40% {
      transform: translateX(var(--step, 13px));
      animation-timing-function: var(--ease-in-out);
    }
    100% {
      transform: translateX(0);
    }
  }

  /* Triggered by the .is-glitching class (added on mouseenter, removed on
     animationend) rather than :hover, so a fast mouse pass still plays the
     full gesture instead of cancelling mid-flight. */
  .ascii-banner.is-glitching .name {
    animation: crt-glitch 600ms 1, stair-boomerang 600ms 1;
  }
  .ascii-banner.is-glitching .name-snow {
    --step: calc(var(--s2) * 2);
    animation-delay: 40ms;
  }
  .ascii-banner.is-glitching .name-schwartz {
    --step: calc(var(--s2) * 3);
    animation-delay: 80ms;
  }

  /* Stair-step stack: each tier indents further, so the longest line
     (SCHWARTZ) reaches furthest right and is the part that breaks the grid. */
  .ascii-banner .name {
    display: block;
  }

  .ascii-banner .name-snow {
    padding-left: 8ch;
  }

  .ascii-banner .name-schwartz {
    padding-left: 16ch;
  }

  /* Below the grid breakpoint there is no grid to break: the wordmark
     returns fully inside the container and the accent edge retires. */
  @media (max-width: 900px) {
    .ascii-bleed {
      width: 100%;
      max-width: 100%;
    }

    .ascii-bleed::after {
      display: none;
    }
  }

  @media (max-width: 600px) {
    .ascii-banner {
      font-size: 0.35rem;
    }

    .ascii-banner .name-snow {
      padding-left: 4ch;
    }

    .ascii-banner .name-schwartz {
      padding-left: 8ch;
    }

    header {
      padding: var(--s5) 0 var(--s4);
    }
  }

  .tagline {
    font-family: var(--font-mono);
    font-size: clamp(1rem, 1.6vw, 1.375rem);
    color: var(--color-text-muted);
    margin-top: var(--s4);
  }

  .tagline span {
    color: var(--color-accent);
  }
</style>
