---
// Skills/Values section component
interface SkillCategory {
  title: string;
  items: string[];
}

interface Props {
  header: string;
  categories: SkillCategory[];
  variant?: 'skills' | 'values';
}

const { header, categories, variant = 'skills' } = Astro.props;
---

<section class:list={['skills-section', { 'values-section': variant === 'values' }]}>
  <h3 class:list={['skills-header', { 'values-header': variant === 'values' }]}>{header}</h3>
  <div class="skills-grid">
    {categories.map((category) => (
      <div class="skill-category">
        <h4 class="skill-category-title">{category.title}</h4>
        <ul class="skill-list">
          {category.items.map((item) => (
            <li class="skill-item">{item}</li>
          ))}
        </ul>
      </div>
    ))}
  </div>
</section>

<style>
  .skills-section {
    margin-top: var(--gap);
    padding: 2rem;
    border: 1px solid var(--color-border);
    background: var(--color-surface);
    transition: border-color 0.3s ease, box-shadow 0.3s ease;
  }

  .skills-section:hover {
    border-color: var(--color-accent);
    box-shadow: 0 0 20px rgba(255, 32, 78, 0.15);
  }

  .skills-header {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-accent);
    margin-bottom: 1.5rem;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .skills-header::before {
    content: '';
    width: 24px;
    height: 1px;
    background: var(--color-accent);
  }

  .skills-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 2rem;
  }

  .skill-category {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .skill-category-title {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: var(--color-text-muted);
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--color-border);
  }

  .skill-list {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .skill-item {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--color-text);
    padding: 0.375rem 0.75rem;
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    transition: border-color 0.2s ease, color 0.2s ease, background 0.2s ease;
  }

  .skill-item:hover {
    border-color: var(--color-accent-secondary);
    color: var(--color-accent-secondary);
    background: rgba(0, 255, 222, 0.05);
  }

  /* Values variant - purple accent */
  .values-section:hover {
    border-color: var(--color-accent-tertiary);
    box-shadow: 0 0 20px rgba(67, 0, 255, 0.15);
  }

  .values-header {
    color: var(--color-accent-tertiary);
  }

  .values-header::before {
    background: var(--color-accent-tertiary);
  }

  .values-section .skill-item:hover {
    border-color: var(--color-accent-tertiary);
    color: var(--color-accent-tertiary);
    background: rgba(67, 0, 255, 0.05);
  }

  @media (max-width: 600px) {
    .skills-grid {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }

    .skills-section {
      padding: 1.5rem;
    }
  }
</style>
