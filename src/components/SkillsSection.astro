---
// Skills/Values section component
interface SkillCategory {
  title: string;
  items: string[];
}

interface Props {
  header: string;
  categories: SkillCategory[];
  variant?: 'skills' | 'values';
  class?: string;
}

const { header, categories, variant = 'skills', class: className } = Astro.props;
---

<section class:list={['skills-section', { 'values-section': variant === 'values' }, className]}>
  <h3 class:list={['skills-header', { 'values-header': variant === 'values' }]}>{header}</h3>
  <div class="skills-grid">
    {categories.map((category) => (
      <div class="skill-category">
        <h4 class="skill-category-title">{category.title}</h4>
        <ul class="skill-list">
          {category.items.map((item) => (
            <li>
              <button type="button" class="skill-item" data-pill={item} data-category={category.title}>{item}</button>
            </li>
          ))}
        </ul>
      </div>
    ))}
  </div>

  <!-- Phosphor readout: the pill overlay. One dialog per section; the script
       fills it from the clicked pill's data attributes. Accent color inherits
       the section variant via --pill-accent. -->
  <dialog class="pill-readout">
    <div class="readout-bezel" aria-hidden="true"></div>
    <div class="readout-body">
      <p class="readout-kicker"></p>
      <h5 class="readout-title"></h5>
      <div class="readout-copy">
        <p>Lorem ipsum dolor sit amet, consectetur adipiscing elit. Integer nec
          odio vitae massa suscipit tincidunt. Curabitur euismod, nisl a
          fermentum volutpat, augue justo aliquet nunc, non commodo lorem
          sapien in arcu.</p>
        <p>Praesent sit amet dictum sem. Vestibulum ante ipsum primis in
          faucibus orci luctus et ultrices posuere cubilia curae; Donec
          vulputate, magna sed porta pretium, elit ligula tempor ante.</p>
      </div>
    </div>
  </dialog>
</section>

<style>
  .skills-section {
    /* variant accent consumed by pills and the readout dialog */
    --pill-accent: var(--color-accent);
    --pill-accent-glow: rgba(255, 32, 78, 0.15);
    /* spacing is governed by the page grid's row-gap, not a component margin */
    padding: 2rem;
    border: 1px solid var(--color-border);
    background: var(--color-surface);
    transition: border-color var(--dur-short) var(--ease-out), box-shadow var(--dur-short) var(--ease-out);
    height: 100%; /* fill the grid cell so row neighbours align at the top */
  }

  .skills-section:hover {
    border-color: var(--color-accent);
    box-shadow: 0 0 20px rgba(255, 32, 78, 0.15);
  }

  /* Terminal-poster header — same display-mono voice as the about panels. */
  .skills-header {
    font-family: var(--font-mono);
    font-size: clamp(1.75rem, 2.6vw, 2.25rem);
    text-transform: uppercase;
    letter-spacing: 0.02em;
    line-height: 1;
    color: var(--color-accent);
    margin-bottom: 1.5rem;
  }

  .skills-header::before {
    content: '> ';
    color: var(--color-accent-tertiary);
  }

  .skills-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 2rem;
  }

  .skill-category {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .skill-category-title {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: var(--color-text-muted);
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--color-border);
  }

  .skill-list {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .skill-item {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--color-text);
    padding: 0.375rem 0.75rem;
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    cursor: pointer;
    transition: border-color var(--dur-micro) var(--ease-out), color var(--dur-micro) var(--ease-out), background var(--dur-micro) var(--ease-out), transform var(--dur-micro) var(--ease-out);
  }

  .skill-item:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
    background: rgba(255, 32, 78, 0.05);
  }

  .skill-item:focus-visible {
    outline: 2px solid var(--pill-accent);
    outline-offset: 2px;
  }

  .skill-item:active {
    transform: translateY(1px);
  }

  /* === PILL READOUT CARD === */
  /* Non-modal corner card: pinned bottom-right, no backdrop, the page stays
     visible and interactive. Clicking another pill swaps the content.
     The script hoists it to <body> — the page-grid cells carry transforms
     (reveal animation), which would otherwise capture position:fixed. It
     therefore can't inherit --pill-accent from the section; the variant
     class below carries the accent instead. */
  .pill-readout {
    --pill-accent: var(--color-accent);
    --pill-accent-glow: rgba(255, 32, 78, 0.15);
    position: fixed;
    inset: auto var(--s4) var(--s4) auto;
    margin: 0;
    width: min(24rem, calc(100vw - 2 * var(--s3)));
    max-height: min(60dvh, 34rem);
    overflow-y: auto;
    padding: 0;
    border: 1px solid var(--pill-accent);
    background: var(--color-surface);
    color: var(--color-text);
    box-shadow: 0 0 35px var(--pill-accent-glow);
    z-index: 10;
    /* the dialog container receives focus on show(); the accent border is
       already the visible boundary, so the UA focus ring is redundant */
    outline: none;
  }

  .pill-readout[open] {
    animation: readout-on var(--dur-short) var(--ease-out);
  }

  @keyframes readout-on {
    from { opacity: 0; transform: translateY(var(--s2)); }
    to   { opacity: 1; transform: translateY(0); }
  }

  /* 2px gradient bezel across the top — same trim as the viewport bars */
  .readout-bezel {
    height: 2px;
    background: linear-gradient(90deg, var(--pill-accent), var(--color-accent-secondary));
  }

  .readout-body {
    position: relative;
    padding: var(--s3);
  }

  /* faint phosphor scanlines over the card surface */
  .readout-body::after {
    content: '';
    position: absolute;
    inset: 0;
    background: repeating-linear-gradient(
      to bottom,
      rgba(28, 25, 23, 0.05) 0,
      rgba(28, 25, 23, 0.05) 1px,
      transparent 1px,
      transparent 3px
    );
    pointer-events: none;
  }

  .readout-kicker {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: var(--color-text-muted);
    margin-bottom: var(--s2);
  }

  .readout-title {
    font-family: var(--font-mono);
    font-size: clamp(1.125rem, 2.2vw, 1.375rem);
    text-transform: uppercase;
    letter-spacing: 0.02em;
    line-height: 1.1;
    color: var(--pill-accent);
    margin-bottom: var(--s3);
  }

  .readout-title::before {
    content: '> ';
    color: var(--color-accent-tertiary);
  }

  .readout-title::after {
    content: '▌';
    margin-left: 0.15em;
    animation: cursor-blink 1.1s steps(1) infinite;
  }

  @keyframes cursor-blink {
    50% { opacity: 0; }
  }

  .readout-copy p {
    font-family: var(--font-sans);
    font-size: 0.9375rem;
    line-height: 1.6;
  }

  .readout-copy p + p {
    margin-top: var(--s2);
  }

  /* Values variant - purple accent */
  .values-section {
    --pill-accent: var(--color-accent-tertiary);
    --pill-accent-glow: rgba(67, 0, 255, 0.15);
  }

  .values-section:hover {
    border-color: var(--color-accent-tertiary);
    box-shadow: 0 0 20px rgba(67, 0, 255, 0.15);
  }

  /* values readout: violet accent, prompt glyph flips to red so the pair
     mirror each other */
  .pill-readout.values {
    --pill-accent: var(--color-accent-tertiary);
    --pill-accent-glow: rgba(67, 0, 255, 0.15);
  }

  .pill-readout.values .readout-title::before {
    color: var(--color-accent);
  }

  .values-header {
    color: var(--color-accent-tertiary);
  }

  .values-header::before {
    color: var(--color-accent);
  }

  .values-section .skill-item:hover {
    border-color: var(--color-accent-tertiary);
    color: var(--color-accent-tertiary);
    background: rgba(67, 0, 255, 0.05);
  }

  @media (max-width: 600px) {
    .pill-readout {
      inset: auto var(--s2) var(--s2) auto;
      width: calc(100vw - 2 * var(--s2));
    }

    .skills-grid {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }

    .skills-section {
      padding: 1.5rem;
    }
  }
</style>

<script>
  // Per-pill copy; a pill with no entry falls back to the lorem placeholder
  // baked into the dialog markup.
  const PILL_COPY: Record<string, string[]> = {
    'Language-agnostic (hand-code in Ruby)': [
      'Eleven years of Ruby, and since my first prompt to Claude Code I’ve barely touched an IDE - the agents write the Go, TypeScript, and Python these days, and I still hand-code Ruby when nobody’s watching.',
    ],
    'Platform Polyglot': [
      'AWS, Cloudflare, Terraform, Buildkite, GitHub Actions - the tools change every few years, but the 3am pages feel remarkably consistent.',
    ],
    'CLI Tooling': [
      'The terminal is the best UI we have, and I’ve built a small fleet of Go TUIs - tail-claude, gearshifter, shelf - largely to avoid ever having to leave it.',
    ],
    'Context Engineering': [
      'An agent does exactly what its context tells it to, which is a polite way of saying most “the AI got it wrong” bugs are self-portraits, and so the real craft is deciding what the model sees, what it never needs to, and what a wasted token was doing there in the first place.',
    ],
    'Harness Engineering': [
      'Claude Code is a customizable operating system that ships with the safety rails unattached, so I build the rails - hooks, plugins, guardrails like claude-bumper-lanes - and the plateau makes this a craft worth learning, because the harness gets more valuable the longer we live with the models we have.',
    ],
    'Multi-Agent Orchestration': [
      'Letting several agents work unwatched is the power-user tier of AI literacy, and what earns you that tier is unglamorous: precise briefs, reading the diffs, and treating delegated output as a claim until the tests pass.',
    ],
    'Agent & Tool Design': [
      'I architected Envato’s internal plugin marketplace for coding agents and wrote 21 of its plugins, which either demonstrates expertise or a worrying inability to stop.',
    ],
    'AI Enablement': [
      'I embedded with a data team for a month to coach AI-first workflows - their real work, the whole team, on blessed company hours, because that is the version that sticks - and months after I left they still work that way. Show, don’t tell.',
    ],
    'Technical Leadership': [
      'Led a cross-functional team of eight at Flux, then deliberately stepped back to hands-on engineering, and both directions were on purpose.',
    ],
    'Remote-First': [
      'Managed an office team’s transition to fully remote when Covid hit and never went back, and since I live in New Zealand every meeting is either very early, very late, or asynchronous - I recommend asynchronous.',
    ],
    'TDD': [
      'Past a certain point you can’t grade an agent’s work by reading it, so I write the test to say what I mean and let the red-green loop do the grading - a failing test is the one piece of feedback an agent can’t talk its way out of.',
    ],
    'DevX': [
      'RSI taught me that friction is a health cost, paid in wrists, so ergonomics, short feedback loops, and tools that don’t fight back are how I keep typing.',
    ],
    'Written Clarity': [
      'Most of my influence travels by document - an essay of mine helped shape my team’s charter - and if I can’t write it clearly, I don’t understand it yet.',
    ],
    'Direct Feedback': [
      'I say the thing, in plain words, because softened feedback rounds down to no feedback.',
    ],
    'Async-First': [
      'See: New Zealand. A written, skimmable update works across twelve timezones and leaves evidence, and nobody has to be awake at 3am to read it.',
    ],
    'Simplicity': [
      'I maintain a repo called SimpleClaude, whose entire thesis is practical minimalism, and the best change is usually a deletion.',
    ],
    'Autonomy': [
      'Hand people the whole problem and the context, then get out of the way - it’s how I like to be managed, so it’s how I coach.',
    ],
    'Humanism': [
      'The hard problems in AI adoption are trust, learning, and the quiet fear of being replaced - the anxiety arrives free with every rollout - and you fix those by sitting down with the humans.',
    ],
    'Mentoring': [
      'Workshops, a weekly community of practice, and claude-code-hero - a dungeon crawler that tricks engineers into shipping their first Claude Code plugin.',
    ],
    'Learning in Public': [
      'The repos, essays, and half-formed experiments are all public because working in the open sharpens the work, and I remain confident the markdown files will find their 10,000 GitHub stars any day now.',
    ],
  };

  document.querySelectorAll<HTMLElement>('.skills-section').forEach((section) => {
    const dialog = section.querySelector<HTMLDialogElement>('.pill-readout');
    if (!dialog) return;

    // hoist out of the transformed grid cell so position:fixed pins to the
    // viewport; the variant class keeps the section's accent color
    if (section.classList.contains('values-section')) dialog.classList.add('values');
    document.body.appendChild(dialog);

    const kicker = dialog.querySelector('.readout-kicker')!;
    const title = dialog.querySelector('.readout-title')!;
    const copy = dialog.querySelector<HTMLElement>('.readout-copy')!;
    const placeholderHTML = copy.innerHTML;

    section.querySelectorAll<HTMLButtonElement>('.skill-item').forEach((pill) => {
      pill.addEventListener('click', () => {
        kicker.textContent = pill.dataset.category ?? '';
        title.textContent = pill.dataset.pill ?? '';
        const paragraphs = PILL_COPY[pill.dataset.pill ?? ''];
        copy.innerHTML = paragraphs
          ? paragraphs.map((p) => `<p>${p}</p>`).join('')
          : placeholderHTML;
        // only one corner card at a time: close any other section's readout
        document.querySelectorAll<HTMLDialogElement>('.pill-readout[open]').forEach((d) => {
          if (d !== dialog) d.close();
        });
        dialog.show();
      });
    });

  });

  // the card is non-modal, so Esc and outside-clicks are handled by hand
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      document.querySelectorAll<HTMLDialogElement>('.pill-readout[open]').forEach((d) => d.close());
    }
  });

  document.addEventListener('click', (e) => {
    const target = e.target as HTMLElement;
    if (target.closest('.pill-readout') || target.closest('.skill-item')) return;
    document.querySelectorAll<HTMLDialogElement>('.pill-readout[open]').forEach((d) => d.close());
  });
</script>
