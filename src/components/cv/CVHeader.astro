---
interface Props {
  name: string;
  title: string;
  tagline?: string;
  location: string;
  phone?: string;
  email: string;
  github?: string;
  linkedin?: string;
}

const { name, title, tagline, location, phone, email, github, linkedin } = Astro.props;

// Build contact items for pipe-separated display
const contactItems = [
  location,
  phone,
  email,
].filter(Boolean);
---

<header class="cv-header">
  <div class="cv-header-content">
    <h1>{name}</h1>
    <p class="contact-line">
      {contactItems.map((item, i) => (
        <>
          {i > 0 && <span class="separator">|</span>}
          {item === email ? (
            <a href={`mailto:${email}`}>{email}</a>
          ) : (
            <span>{item}</span>
          )}
        </>
      ))}
    </p>
    <p class="title-line">
      <strong>{title}</strong>
      {tagline && <> | {tagline}</>}
    </p>
  </div>
</header>

<style>
  .cv-header {
    background-color: var(--cv-header-bg, #1e293b);
    color: var(--cv-header-text, #ffffff);
    padding: 1.5rem 2rem;
    margin: -2.5rem -2.5rem 2rem -2.5rem; /* Break out of parent padding */
    text-align: center;
  }

  .cv-header-content {
    max-width: 800px;
    margin: 0 auto;
  }

  h1 {
    font-size: 2rem;
    font-weight: 600;
    margin-bottom: 0.5rem;
    letter-spacing: -0.01em;
  }

  .contact-line {
    font-size: 0.875rem;
    margin-bottom: 0.5rem;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 0.5rem;
  }

  .contact-line a {
    color: inherit;
    text-decoration: none;
  }

  .contact-line a:hover {
    text-decoration: underline;
  }

  .separator {
    opacity: 0.6;
  }

  .title-line {
    font-size: 0.95rem;
    opacity: 0.95;
  }

  .title-line strong {
    font-weight: 600;
  }

  /* Print styles */
  @media print {
    .cv-header {
      background-color: var(--cv-header-bg, #1e293b) !important;
      color: var(--cv-header-text, #ffffff) !important;
      -webkit-print-color-adjust: exact !important;
      print-color-adjust: exact !important;
      padding: 1rem 1.5rem;
      margin: 0 0 1rem 0;
    }

    h1 {
      font-size: 18pt;
      margin-bottom: 4pt;
    }

    .contact-line {
      font-size: 9pt;
      margin-bottom: 4pt;
    }

    .title-line {
      font-size: 10pt;
    }
  }

  /* Mobile */
  @media (max-width: 600px) {
    .cv-header {
      padding: 1.25rem 1rem;
      margin: -1.5rem -1.5rem 1.5rem -1.5rem;
    }

    h1 {
      font-size: 1.5rem;
    }

    .contact-line {
      flex-direction: column;
      gap: 0.25rem;
    }

    .separator {
      display: none;
    }

    .title-line {
      font-size: 0.85rem;
    }
  }
</style>
