---
/**
 * WaveBand — a full-width band of engraved scroll waves: the tide that floods
 * the lower halls of the House, drawn like the seas of an old sea chart.
 *
 * Pure decoration: hidden from assistive tech and ignores the pointer. The
 * wave tile repeats horizontally through an SVG <pattern>; two offset rows of
 * curling crests with engraver's hatching on each wave face.
 */
---

<svg class="waveband" aria-hidden="true" focusable="false" width="100%" height="46" preserveAspectRatio="none">
  <defs>
    <g id="rl-wave-unit" fill="none" stroke="currentColor" stroke-width="1">
      <path d="M0 20C10 20 15 6 29 5C39 4.3 43 11.5 37.5 13.5C33.5 15 31 10.5 34.5 9.3" />
      <path d="M42 9.5C46 15 50 20 60 20" />
      <path opacity="0.5" d="M7 20C14 19 18 10 27 9.2M14 20C19 18.5 22 13.5 27 13" />
    </g>
    <pattern id="rl-wave" patternUnits="userSpaceOnUse" width="120" height="46">
      <use href="#rl-wave-unit" />
      <use href="#rl-wave-unit" x="60" />
      <use href="#rl-wave-unit" x="-30" y="24" />
      <use href="#rl-wave-unit" x="30" y="24" />
      <use href="#rl-wave-unit" x="90" y="24" />
    </pattern>
  </defs>
  <rect width="100%" height="46" fill="url(#rl-wave)" />
</svg>

<style>
  .waveband {
    display: block;
    width: 100%;
    height: 46px;
    pointer-events: none;
    color: var(--rl-clay);
  }
</style>
