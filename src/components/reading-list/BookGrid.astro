---
/**
 * BookGrid — every book rendered as a card at build time.
 *
 * Cards carry data-idx so the client filter script can show/hide them against
 * the model. Tag chips carry data-group/data-val so clicking one toggles that
 * filter. Nothing here is client-rendered: the full library is in the HTML.
 */
import { BOOKS, GENRES, type GenreKey } from '../../data/reading-list';
---

<main class="results">
  <div class="results-bar">
    <div class="view-toggle" role="group" aria-label="View">
      <button type="button" class="viewbtn on" data-view="cards" aria-pressed="true" aria-label="Card view">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <rect x="3" y="3" width="7" height="7" rx="1" /><rect x="14" y="3" width="7" height="7" rx="1" />
          <rect x="3" y="14" width="7" height="7" rx="1" /><rect x="14" y="14" width="7" height="7" rx="1" />
        </svg>
      </button>
      <button type="button" class="viewbtn" data-view="list" aria-pressed="false" aria-label="List view">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <line x1="8" y1="6" x2="21" y2="6" /><line x1="8" y1="12" x2="21" y2="12" /><line x1="8" y1="18" x2="21" y2="18" />
          <line x1="3.5" y1="6" x2="3.51" y2="6" /><line x1="3.5" y1="12" x2="3.51" y2="12" /><line x1="3.5" y1="18" x2="3.51" y2="18" />
        </svg>
      </button>
    </div>
    <div class="sortwrap">
      <label class="sortlabel" for="rl-sort">Sort</label>
      <select class="sort" id="rl-sort">
        <option value="curated">Curated</option>
        <option value="title">Title · A–Z</option>
        <option value="author">Author · A–Z</option>
        <option value="year-desc">Year · newest first</option>
        <option value="year-asc">Year · oldest first</option>
      </select>
    </div>
  </div>
  <div class="grid" id="rl-grid">
    {BOOKS.map((bk, i) => (
      <article class="card" data-idx={i} data-g={bk.g} style={`--c: var(--rl-${bk.g.toLowerCase()})`}>
        <h3>{bk.t}</h3>
        <div class="author">{bk.a}</div>
        {bk.year && <span class="card-year">{bk.year}</span>}
        <p class="why">{bk.why}</p>
        <div class="tags">
          <button type="button" aria-pressed="false" class="tag genre" data-group="g" data-val={bk.g} style={`--c: var(--rl-${bk.g.toLowerCase()})`}>
            {GENRES[bk.g as GenreKey]}
          </button>
          {bk.s.map((x) => (
            <button type="button" aria-pressed="false" class="tag" data-group="s" data-val={x}>{x}</button>
          ))}
          {bk.b.map((x) => (
            <button type="button" aria-pressed="false" class="tag" data-group="b" data-val={x}>{x}</button>
          ))}
        </div>
      </article>
    ))}
  </div>
  <div class="empty" id="rl-empty" hidden>No books remain. Loosen a filter — or switch a row back to ANY.</div>
</main>

<style>
  .results-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s1);
    margin-bottom: var(--s2);
  }
  .sortwrap { display: flex; align-items: baseline; gap: var(--s1); }

  .view-toggle { display: inline-flex; gap: 4px; }
  .viewbtn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 30px;
    height: 28px;
    border: 1px solid var(--color-border);
    background: var(--color-surface);
    border-radius: 8px;
    color: var(--color-text-muted);
    cursor: pointer;
    transition: border-color var(--dur-micro) var(--ease-out), color var(--dur-micro) var(--ease-out);
  }
  .viewbtn:hover { border-color: var(--color-text-muted); color: var(--color-text); }
  .viewbtn.on { border-color: var(--color-accent); color: var(--color-accent); }
  .viewbtn:focus-visible { outline: 2px solid var(--color-accent); outline-offset: 1px; }
  .viewbtn svg { width: 15px; height: 15px; }

  .sortlabel {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }
  .sort {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--color-text);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 999px;
    padding: 5px 11px;
    cursor: pointer;
  }
  .sort:hover { border-color: var(--color-text-muted); }
  .sort:focus-visible { outline: 2px solid var(--color-accent); outline-offset: 1px; }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(255px, 1fr));
    gap: var(--s2);
  }
  .card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-left: 4px solid var(--c);
    border-radius: 12px;
    padding: var(--s2) var(--s2) var(--s2);
    display: flex;
    flex-direction: column;
    gap: 9px;
  }
  .card[hidden] { display: none; }
  .card h3 {
    font-family: var(--font-sans);
    font-weight: 600;
    font-size: 1.05rem;
    line-height: 1.25;
    margin: 0;
    letter-spacing: -0.01em;
  }
  .card .author { font-family: var(--font-mono); font-size: 0.72rem; color: var(--color-text-muted); }
  .card .why { font-size: 0.84rem; color: var(--color-text-muted); line-height: 1.5; margin: 0; }
  /* Year is carried in the DOM for every book but only surfaces in list view. */
  .card-year { display: none; }

  .tags { display: flex; flex-wrap: wrap; gap: 5px; margin-top: auto; }
  .tag {
    font-family: var(--font-mono);
    font-size: 0.64rem;
    cursor: pointer;
    border: 1px solid var(--color-border);
    background: var(--color-bg);
    color: var(--color-text-muted);
    border-radius: 999px;
    padding: 2px 8px;
    transition: border-color var(--dur-micro) var(--ease-out);
  }
  .tag:hover { border-color: var(--color-text-muted); }
  .tag.genre { color: #fff; border-color: transparent; background: var(--c); }
  .tag.match {
    outline: 2px solid var(--color-accent);
    outline-offset: 1px;
    border-color: var(--color-accent);
    font-weight: 500;
  }

  /* === CONDENSED LIST VIEW ===
     Same .card nodes, restyled into compact rows — so the filter/sort script
     (which targets .card by data-idx) keeps working with no changes. Rows
     share a single bordered container; the why-blurb and tag chips collapse,
     leaving title · author · year, with the genre still encoded by the left bar. */
  .grid.list {
    display: flex;
    flex-direction: column;
    gap: 0;
    border: 1px solid var(--color-border);
    border-radius: 12px;
    overflow: hidden;
  }
  .grid.list .card {
    flex-direction: row;
    align-items: baseline;
    gap: var(--s2);
    border: none;
    border-left: 4px solid var(--c);
    border-bottom: 1px solid var(--color-border);
    border-radius: 0;
    padding: 8px var(--s2);
  }
  .grid.list .card:last-child { border-bottom: none; }
  .grid.list .card h3 { font-size: 0.92rem; }
  .grid.list .card .why,
  .grid.list .card .tags { display: none; }
  .grid.list .card-year {
    display: inline;
    margin-left: auto;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--color-text-muted);
  }

  @media (max-width: 520px) {
    .grid.list .card { flex-wrap: wrap; gap: 2px var(--s1); }
  }

  .empty {
    text-align: center;
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    font-size: 0.84rem;
    padding: var(--s6) 0;
  }
</style>
